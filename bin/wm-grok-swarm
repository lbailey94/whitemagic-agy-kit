#!/usr/bin/env python3
"""
wm-grok-swarm — Parallel Grok 4.7 Subagent Runner via `cursor-agent` (Tier 1 Leaf Swarm).

- Strictly isolates workers from local `wm3 serve` Gen3 store (never passes `--approve-mcps`).
- Supports `status`, `ask` (read-only), `plan` (read-only), `worktree` (isolated `-w` git worktrees),
  and `resume` (`--resume <session_id>`).
- Logs telemetry to ~/.local/share/whitemagic/grok_swarm_telemetry.jsonl.
"""

import argparse
import base64
import concurrent.futures
import fcntl
import hashlib
import hmac
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_FAMILY = "grok-4.7"
SHORTHAND_TIERS = ("low", "medium", "high", "xhigh")
MODEL_MAP = {
    "low": "grok-4.7-low",
    "medium": "grok-4.7-medium",
    "high": "grok-4.7-high",
    "xhigh": "grok-4.7-xhigh",
}
VALID_EXPLICIT_RE = re.compile(r"^(?:cursor-)?grok-\d+\.\d+(?:-(?:low|medium|high|xhigh))?(?:-fast)?$")
ANY_CURSOR_MODEL_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9._-]{1,63}$")
SAFE_WT_RE = re.compile(r"[^a-zA-Z0-9._-]+")
NO_TOOLS_BANNER = (
    "PURE SYNTHESIS MODE: Do NOT call any file, search, or shell tools. "
    "Respond directly in a single turn with ONLY the requested output.\n\n"
)
SWARM_PRESETS = {
    "synthesis": {"model": "medium", "empty_cwd": True, "no_tools_guard": True},
    "dataset": {"model": "low", "empty_cwd": True, "no_tools_guard": True},
    "blueprint": {"model": "high-fast", "empty_cwd": True, "no_tools_guard": True},
    "fast": {"model": "medium-fast", "empty_cwd": True, "no_tools_guard": True},
    "audit": {"model": "high", "empty_cwd": False, "no_tools_guard": False},
    "plan": {"model": "high", "empty_cwd": False, "no_tools_guard": False},
    "patch": {"model": "high", "empty_cwd": False, "no_tools_guard": False},
}
TELEM_PATH = Path(
    os.environ.get(
        "WM_GROK_TELEMETRY",
        str(Path.home() / ".local" / "share" / "whitemagic" / "grok_swarm_telemetry.jsonl"),
    )
)


def find_cursor_agent() -> str | None:
    hit = shutil.which("cursor-agent")
    if hit:
        return hit
    cand = Path.home() / ".local" / "bin" / "cursor-agent"
    if cand.is_file() and os.access(cand, os.X_OK):
        return str(cand)
    return None


def find_bwrap() -> str | None:
    if "WM_BWRAP_BIN" in os.environ:
        cand = os.environ["WM_BWRAP_BIN"].strip()
        if not cand:
            return None
        p = Path(cand)
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
        return None
    bw = shutil.which("bwrap")
    if bw:
        return bw
    if sys.platform == "darwin":
        sbx = shutil.which("sandbox-exec") or ("/usr/bin/sandbox-exec" if os.access("/usr/bin/sandbox-exec", os.X_OK) else None)
        if sbx:
            return sbx
    return None


def _compute_worktree_diff_sha256(wt_path: Path) -> str:
    h = hashlib.sha256()
    diff_proc = subprocess.run(
        ["git", "-C", str(wt_path), "diff", "HEAD"],
        capture_output=True,
    )
    status_proc = subprocess.run(
        ["git", "-C", str(wt_path), "status", "--porcelain"],
        capture_output=True,
    )
    if diff_proc.returncode == 0 and status_proc.returncode == 0:
        h.update(diff_proc.stdout)
        h.update(b"\n---\n")
        h.update(status_proc.stdout)
        return h.hexdigest()

    for p in sorted(wt_path.rglob("*")):
        rel = str(p.relative_to(wt_path))
        if rel.startswith(".git"):
            continue
        if p.is_file():
            try:
                st = p.stat()
                h.update(f"{rel}:{st.st_size}\n".encode("utf-8"))
                h.update(p.read_bytes()[:65536])
            except OSError:
                h.update(f"{rel}:err\n".encode("utf-8"))
    return h.hexdigest()


def _discover_tmp_git_ro_binds(resolved_wt: Path) -> list[Path]:
    """Return external /tmp git dirs needed when an external worktree points into a /tmp repo."""
    proc = subprocess.run(
        ["git", "-C", str(resolved_wt), "rev-parse", "--git-common-dir", "--git-dir"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        return []
    tmp_root = Path("/tmp").resolve()
    candidates: set[Path] = set()
    for raw in proc.stdout.splitlines():
        line = raw.strip()
        if not line:
            continue
        cand = Path(line)
        if not cand.is_absolute():
            cand = resolved_wt / cand
        try:
            cand = cand.resolve()
        except OSError:
            continue
        if cand.is_dir() and cand.is_relative_to(tmp_root) and not cand.is_relative_to(resolved_wt):
            candidates.add(cand)
    selected: list[Path] = []
    for cand in sorted(candidates, key=lambda p: (len(p.parts), str(p))):
        if any(cand.is_relative_to(parent) for parent in selected):
            continue
        selected.append(cand)
    return selected


RECEIPT_VERSION = "wm-confinement-receipt/1.1"
_TRUTHY = {"1", "true", "yes", "on"}
_FALSY = {"0", "false", "no", "off"}


def _utc_rfc3339() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _sha256_cmd(verify_cmd: str | None) -> str | None:
    if isinstance(verify_cmd, str) and verify_cmd:
        return hashlib.sha256(verify_cmd.encode("utf-8")).hexdigest()
    return None


def _build_confinement_receipt(
    *,
    bwrap_bin: str | None,
    network_isolated: bool,
    worktree_path: str,
    worktree_diff_sha256: str | None,
    verify_exit_code: int | None,
    scope_confined: bool,
    verify_cmd: str | None = None,
    bwrap_flags: list[str] | None = None,
    verify_stdout_tail: str | None = None,
    verify_stderr_tail: str | None = None,
    signature_alg: str | None = None,
    signature_b64: str | None = None,
) -> dict:
    rcpt = {
        "receipt_version": RECEIPT_VERSION,
        "issued_at_utc": _utc_rfc3339(),
        "bwrap_bin": bwrap_bin,
        "network_isolated": network_isolated,
        "worktree_path": worktree_path,
        "worktree_diff_sha256": worktree_diff_sha256,
        "verify_cmd_sha256": _sha256_cmd(verify_cmd),
        "bwrap_flags": list(bwrap_flags or []),
        "verify_exit_code": verify_exit_code,
        "scope_confined": scope_confined,
        "signature_alg": signature_alg,
        "signature_b64": signature_b64,
    }
    if verify_stdout_tail is not None:
        rcpt["verify_stdout_tail"] = verify_stdout_tail
    if verify_stderr_tail is not None:
        rcpt["verify_stderr_tail"] = verify_stderr_tail
    return rcpt


def canonical_receipt_bytes(receipt: dict) -> bytes:
    payload = {k: v for k, v in receipt.items() if k not in ("signature_b64", "remote_attestation")}
    return json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def _parse_hmac_secret(raw: str | bytes) -> bytes:
    if isinstance(raw, bytes):
        if not raw:
            raise ValueError("HMAC key must be non-empty")
        return raw
    text = str(raw)
    if text.startswith("hex:"):
        hex_part = text[4:].strip()
        try:
            out = bytes.fromhex(hex_part)
        except ValueError as exc:
            raise ValueError(f"invalid hex HMAC key: {exc}") from exc
        if not out:
            raise ValueError("HMAC hex key must be non-empty")
        return out
    if text.startswith("base64:"):
        b64_part = text[7:].strip()
        try:
            out = base64.b64decode(b64_part, validate=True)
        except Exception as exc:
            raise ValueError(f"invalid base64 HMAC key: {exc}") from exc
        if not out:
            raise ValueError("HMAC base64 key must be non-empty")
        return out
    out = text.encode("utf-8")
    if not out:
        raise ValueError("HMAC key must be non-empty")
    return out


def _load_hmac_key_from_env() -> bytes | None:
    key_file = os.environ.get("WM_CONFINEMENT_HMAC_KEY_FILE", "").strip()
    file_key: bytes | None = None
    if key_file:
        p = Path(key_file)
        if not p.is_file():
            raise ValueError(f"WM_CONFINEMENT_HMAC_KEY_FILE not found: {key_file}")
        try:
            raw_bytes = p.read_bytes()
        except OSError as exc:
            raise ValueError(f"cannot read WM_CONFINEMENT_HMAC_KEY_FILE {key_file}: {exc}") from exc
        if not raw_bytes:
            raise ValueError(f"WM_CONFINEMENT_HMAC_KEY_FILE is empty: {key_file}")
        try:
            text = raw_bytes.decode("utf-8").rstrip("\r\n")
            file_key = _parse_hmac_secret(text)
        except UnicodeDecodeError:
            file_key = raw_bytes

    key_env = os.environ.get("WM_CONFINEMENT_HMAC_KEY", "")
    if key_env.strip():
        return _parse_hmac_secret(key_env)
    return file_key


_ED25519_PKCS8_PREFIX = bytes.fromhex("302e020100300506032b657004220420")
_ED25519_SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")


def _find_openssl_ed25519() -> str | None:
    for cand in ("/opt/homebrew/bin/openssl", "/usr/local/bin/openssl", shutil.which("openssl") or "", "/usr/bin/openssl"):
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            res = subprocess.run([cand, "version"], capture_output=True, text=True)
            if res.returncode == 0 and not res.stdout.startswith("LibreSSL"):
                return cand
    return None


def _der_to_pem(der: bytes, label: str) -> bytes:
    b64 = base64.b64encode(der).decode("ascii")
    lines = [b64[i : i + 64] for i in range(0, len(b64), 64)]
    return (f"-----BEGIN {label}-----\n" + "\n".join(lines) + f"\n-----END {label}-----\n").encode("ascii")


class _OpensslEd25519PublicKey:
    def __init__(self, pem_bytes: bytes, openssl_bin: str):
        self._pem = pem_bytes
        self._openssl = openssl_bin

    def verify(self, sig_bytes: bytes, payload: bytes) -> None:
        with tempfile.TemporaryDirectory(prefix="wm-ed-v-") as td:
            td_p = Path(td)
            pub_p = td_p / "pub.pem"
            msg_p = td_p / "msg.bin"
            sig_p = td_p / "sig.bin"
            pub_p.write_bytes(self._pem)
            msg_p.write_bytes(payload)
            sig_p.write_bytes(sig_bytes)
            r = subprocess.run(
                [self._openssl, "pkeyutl", "-verify", "-pubin", "-inkey", str(pub_p), "-rawin", "-in", str(msg_p), "-sigfile", str(sig_p)],
                capture_output=True,
            )
            if r.returncode != 0:
                raise ValueError("ed25519 signature mismatch")

    def to_pem(self) -> str:
        return self._pem.decode("utf-8")


class _OpensslEd25519PrivateKey:
    def __init__(self, pem_bytes: bytes, openssl_bin: str):
        self._pem = pem_bytes
        self._openssl = openssl_bin

    def sign(self, payload: bytes) -> bytes:
        with tempfile.TemporaryDirectory(prefix="wm-ed-s-") as td:
            td_p = Path(td)
            priv_p = td_p / "priv.pem"
            msg_p = td_p / "msg.bin"
            priv_p.write_bytes(self._pem)
            msg_p.write_bytes(payload)
            r = subprocess.run(
                [self._openssl, "pkeyutl", "-sign", "-inkey", str(priv_p), "-rawin", "-in", str(msg_p)],
                capture_output=True,
            )
            if r.returncode != 0 or len(r.stdout) != 64:
                raise ValueError(f"openssl Ed25519 sign failed: {r.stderr.decode('utf-8', 'replace')}")
            return r.stdout

    def public_key(self) -> _OpensslEd25519PublicKey:
        r = subprocess.run(
            [self._openssl, "pkey", "-pubout"],
            input=self._pem,
            capture_output=True,
        )
        if r.returncode != 0 or b"BEGIN PUBLIC KEY" not in r.stdout:
            raise ValueError("openssl Ed25519 public key derivation failed")
        return _OpensslEd25519PublicKey(r.stdout, self._openssl)


def _has_ed25519_backend() -> bool:
    try:
        from cryptography.hazmat.primitives.asymmetric import ed25519 as _ed  # noqa: F401
        return True
    except ImportError:
        return _find_openssl_ed25519() is not None


def _load_ed25519_private_key_from_env():
    key_file = os.environ.get("WM_CONFINEMENT_ED25519_KEY_FILE", "").strip()
    if not key_file:
        return None
    p = Path(key_file)
    if not p.is_file():
        raise ValueError(f"WM_CONFINEMENT_ED25519_KEY_FILE not found: {key_file}")
    try:
        raw = p.read_bytes()
    except OSError as exc:
        raise ValueError(f"cannot read WM_CONFINEMENT_ED25519_KEY_FILE {key_file}: {exc}") from exc

    try:
        from cryptography.hazmat.primitives import serialization
        from cryptography.hazmat.primitives.asymmetric import ed25519

        if b"-----BEGIN" in raw:
            try:
                priv = serialization.load_pem_private_key(raw, password=None)
            except Exception as exc:
                raise ValueError(f"invalid PEM private key in {key_file}: {exc}") from exc
            if not isinstance(priv, ed25519.Ed25519PrivateKey):
                raise ValueError(f"PEM key in {key_file} is not an Ed25519 private key")
            return priv
        if len(raw) == 32:
            return ed25519.Ed25519PrivateKey.from_private_bytes(raw)
        raise ValueError(f"WM_CONFINEMENT_ED25519_KEY_FILE must be PEM PKCS8 or raw 32-byte key: {key_file}")
    except ImportError as exc:
        openssl_bin = _find_openssl_ed25519()
        if not openssl_bin:
            raise ValueError("cryptography package or OpenSSL 3+ required for Ed25519 confinement signing") from exc
        if b"-----BEGIN" in raw:
            chk = subprocess.run([openssl_bin, "pkey", "-noout", "-text"], input=raw, capture_output=True)
            if chk.returncode != 0 or "ED25519" not in chk.stdout.decode("utf-8", "replace").upper():
                raise ValueError(f"invalid Ed25519 PEM private key in {key_file}")
            return _OpensslEd25519PrivateKey(raw, openssl_bin)
        if len(raw) == 32:
            pem = _der_to_pem(_ED25519_PKCS8_PREFIX + raw, "PRIVATE KEY")
            return _OpensslEd25519PrivateKey(pem, openssl_bin)
        raise ValueError(f"WM_CONFINEMENT_ED25519_KEY_FILE must be PEM PKCS8 or raw 32-byte key: {key_file}")


def _resolve_signing_plan(
    sign_receipt: bool | None = None,
    sign_alg: str | None = None,
    require_sign: bool = False,
) -> tuple[bool, str | None, object | None]:
    raw_alg = (str(sign_alg) if sign_alg is not None else "").strip().lower()
    if raw_alg and raw_alg not in ("auto", "hmac-sha256", "ed25519"):
        raise ValueError(f"Unsupported sign_alg '{sign_alg}' (expected auto|hmac-sha256|ed25519)")

    env_sign_raw = os.environ.get("WM_CONFINEMENT_SIGN", "").strip().lower()
    if env_sign_raw and env_sign_raw not in (_TRUTHY | _FALSY):
        raise ValueError(f"Invalid WM_CONFINEMENT_SIGN value '{env_sign_raw}'")

    explicit_req = (
        (sign_receipt is True)
        or bool(raw_alg)
        or (env_sign_raw in _TRUTHY)
        or bool(require_sign)
    )
    explicit_disable = (sign_receipt is False) or (
        env_sign_raw in _FALSY and sign_receipt is not True and not raw_alg and not require_sign
    )

    has_hmac_env = bool(
        os.environ.get("WM_CONFINEMENT_HMAC_KEY", "").strip()
        or os.environ.get("WM_CONFINEMENT_HMAC_KEY_FILE", "").strip()
    )
    has_ed_env = bool(os.environ.get("WM_CONFINEMENT_ED25519_KEY_FILE", "").strip())

    # Validate any configured key files/values upfront so invalid configs always fail closed.
    hmac_key = _load_hmac_key_from_env() if has_hmac_env else None
    ed_key = _load_ed25519_private_key_from_env() if has_ed_env else None

    should_sign = explicit_req or ((not explicit_disable) and (has_hmac_env or has_ed_env))
    if not should_sign:
        return (False, None, None)

    if raw_alg in ("", "auto"):
        if ed_key is not None:
            return (True, "ed25519", ed_key)
        if hmac_key is not None:
            return (True, "hmac-sha256", hmac_key)
        raise ValueError(
            "Confinement receipt signing requested but no key is configured "
            "(set WM_CONFINEMENT_HMAC_KEY, WM_CONFINEMENT_HMAC_KEY_FILE, or WM_CONFINEMENT_ED25519_KEY_FILE)"
        )

    if raw_alg == "ed25519":
        if not _has_ed25519_backend():
            raise ValueError("cryptography package or OpenSSL 3+ required for Ed25519 confinement signing")
        if ed_key is None:
            raise ValueError("Ed25519 signing requested but WM_CONFINEMENT_ED25519_KEY_FILE is not set")
        return (True, "ed25519", ed_key)

    if hmac_key is None:
        raise ValueError(
            "HMAC-SHA256 signing requested but WM_CONFINEMENT_HMAC_KEY / WM_CONFINEMENT_HMAC_KEY_FILE is not set"
        )
    return (True, "hmac-sha256", hmac_key)


def _sign_with_plan(receipt: dict, active: bool, alg: str | None, key_obj: object | None) -> dict:
    out = dict(receipt)
    if not active or not alg:
        out["signature_alg"] = None
        out["signature_b64"] = None
        return out
    out["signature_alg"] = alg
    payload = canonical_receipt_bytes(out)
    if alg == "hmac-sha256":
        sig = hmac.new(key_obj, payload, hashlib.sha256).digest()  # type: ignore[arg-type]
    elif alg == "ed25519":
        sig = key_obj.sign(payload)  # type: ignore[attr-defined]
    else:
        raise ValueError(f"Unsupported signature_alg: {alg}")
    out["signature_b64"] = base64.b64encode(sig).decode("ascii")
    return out


def sign_confinement_receipt(
    receipt: dict,
    sign_alg: str | None = None,
    require_sign: bool = False,
) -> dict:
    explicit_req = True if (require_sign or (sign_alg is not None and str(sign_alg).strip())) else None
    active, alg, key_obj = _resolve_signing_plan(
        sign_receipt=explicit_req,
        sign_alg=sign_alg,
        require_sign=require_sign,
    )
    return _sign_with_plan(receipt, active, alg, key_obj)


def _load_ed25519_public_key(ed25519_public_key=None):
    if ed25519_public_key is None:
        pub_env = os.environ.get("WM_CONFINEMENT_ED25519_PUBKEY_FILE", "").strip()
        if pub_env:
            ed25519_public_key = Path(pub_env)
        else:
            priv = _load_ed25519_private_key_from_env()
            if priv is None:
                raise ValueError(
                    "Ed25519 public key not provided and WM_CONFINEMENT_ED25519_PUBKEY_FILE / "
                    "WM_CONFINEMENT_ED25519_KEY_FILE not set"
                )
            return priv.public_key()

    if isinstance(ed25519_public_key, _OpensslEd25519PublicKey):
        return ed25519_public_key
    if isinstance(ed25519_public_key, _OpensslEd25519PrivateKey):
        return ed25519_public_key.public_key()

    try:
        from cryptography.hazmat.primitives import serialization
        from cryptography.hazmat.primitives.asymmetric import ed25519

        if isinstance(ed25519_public_key, ed25519.Ed25519PublicKey):
            return ed25519_public_key
        if isinstance(ed25519_public_key, ed25519.Ed25519PrivateKey):
            return ed25519_public_key.public_key()
    except ImportError:
        serialization = None
        ed25519 = None

    if isinstance(ed25519_public_key, Path) or (
        isinstance(ed25519_public_key, str) and "-----BEGIN" not in ed25519_public_key
    ):
        p = Path(ed25519_public_key)
        if not p.is_file():
            raise ValueError(f"Ed25519 public key file not found: {p}")
        raw = p.read_bytes()
    elif isinstance(ed25519_public_key, str):
        raw = ed25519_public_key.encode("utf-8")
    elif isinstance(ed25519_public_key, bytes):
        raw = ed25519_public_key
    else:
        raise ValueError("Unsupported Ed25519 public key type")

    if ed25519 is not None and serialization is not None:
        if b"-----BEGIN PUBLIC KEY-----" in raw:
            pub = serialization.load_pem_public_key(raw)
            if not isinstance(pub, ed25519.Ed25519PublicKey):
                raise ValueError("PEM public key is not an Ed25519 public key")
            return pub
        if b"-----BEGIN" in raw:
            priv = serialization.load_pem_private_key(raw, password=None)
            if not isinstance(priv, ed25519.Ed25519PrivateKey):
                raise ValueError("PEM private key is not an Ed25519 private key")
            return priv.public_key()
        if len(raw) == 32:
            return ed25519.Ed25519PublicKey.from_public_bytes(raw)
        raise ValueError("Ed25519 public key must be PEM or raw 32-byte key")

    openssl_bin = _find_openssl_ed25519()
    if not openssl_bin:
        raise ValueError("cryptography package or OpenSSL 3+ required for Ed25519 verification")
    if b"-----BEGIN PUBLIC KEY-----" in raw:
        return _OpensslEd25519PublicKey(raw, openssl_bin)
    if b"-----BEGIN" in raw:
        return _OpensslEd25519PrivateKey(raw, openssl_bin).public_key()
    if len(raw) == 32:
        return _OpensslEd25519PublicKey(_der_to_pem(_ED25519_SPKI_PREFIX + raw, "PUBLIC KEY"), openssl_bin)
    raise ValueError("Ed25519 public key must be PEM or raw 32-byte key")


def verify_confinement_receipt(
    receipt: dict,
    hmac_key: str | bytes | None = None,
    ed25519_public_key=None,
) -> tuple[bool, str]:
    if not isinstance(receipt, dict):
        return (False, "receipt must be a JSON object")
    if receipt.get("receipt_version") != RECEIPT_VERSION:
        return (False, f"unsupported receipt_version: {receipt.get('receipt_version')!r}")

    alg = receipt.get("signature_alg")
    sig_b64 = receipt.get("signature_b64")
    if not alg or not isinstance(alg, str):
        return (False, "receipt missing signature_alg")
    if not sig_b64 or not isinstance(sig_b64, str):
        return (False, "receipt missing signature_b64")

    try:
        sig_bytes = base64.b64decode(sig_b64, validate=True)
    except Exception as exc:
        return (False, f"invalid base64 signature_b64: {exc}")

    payload = canonical_receipt_bytes(receipt)
    if alg == "hmac-sha256":
        try:
            key_bytes = _parse_hmac_secret(hmac_key) if hmac_key is not None else _load_hmac_key_from_env()
        except (ValueError, OSError) as exc:
            return (False, str(exc))
        if key_bytes is None:
            return (False, "HMAC key unavailable (pass hmac_key or set WM_CONFINEMENT_HMAC_KEY)")
        expected = hmac.new(key_bytes, payload, hashlib.sha256).digest()
        if hmac.compare_digest(expected, sig_bytes):
            return (True, "verified hmac-sha256")
        return (False, "hmac-sha256 signature mismatch")

    if alg == "ed25519":
        if not _has_ed25519_backend():
            return (False, "cryptography package or OpenSSL 3+ required for Ed25519 verification")
        try:
            pub_key = _load_ed25519_public_key(ed25519_public_key)
        except (ValueError, OSError) as exc:
            return (False, str(exc))
        try:
            pub_key.verify(sig_bytes, payload)
        except Exception:
            return (False, "ed25519 signature mismatch")
        return (True, "verified ed25519")

    return (False, f"unsupported signature_alg: {alg!r}")


def append_receipt_ledger(receipt: dict, ledger_path: str | Path | None = None) -> Path | None:
    raw_target = ledger_path if ledger_path is not None else os.environ.get("WM_CONFINEMENT_RECEIPT_LOG", "")
    target = str(raw_target).strip()
    if not target:
        return None
    p = Path(target).expanduser()
    p.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps(receipt, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n"
    with open(p, "a", encoding="utf-8") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            f.write(line)
            f.flush()
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
    return p


def _extract_ed25519_public_pem(ed25519_public_key=None) -> str | None:
    if isinstance(ed25519_public_key, str) and "-----BEGIN PUBLIC KEY-----" in ed25519_public_key:
        return ed25519_public_key
    pub = _load_ed25519_public_key(ed25519_public_key)
    if isinstance(pub, _OpensslEd25519PublicKey):
        return pub.to_pem()
    from cryptography.hazmat.primitives import serialization

    return pub.public_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PublicFormat.SubjectPublicKeyInfo,
    ).decode("utf-8")


def _sign_rfc9421_hmac_headers(
    method: str,
    path: str,
    authority: str,
    key_file: str | Path | None = None,
    key_id: str | None = None,
) -> dict[str, str]:
    raw_kf = str(key_file).strip() if key_file is not None else os.environ.get("WM_TRUSTED_AGENT_KEY_FILE", "").strip()
    kf_path = Path(raw_kf).expanduser() if raw_kf else (Path.home() / ".config" / "whitemagic" / "trusted_agent_key.json")
    if not kf_path.is_file():
        return {}
    try:
        data = json.loads(kf_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}

    target_kid = (key_id if key_id is not None else os.environ.get("WM_TRUSTED_AGENT_KEY_ID", "")).strip()
    selected_kid: str | None = None
    selected_entry: dict | None = None
    if target_kid:
        cand = data.get(target_kid)
        if isinstance(cand, dict) and cand.get("enabled") is not False and str(cand.get("alg") or "").strip().lower() == "hmac-sha256":
            selected_kid = target_kid
            selected_entry = cand
    else:
        for kid, cand in data.items():
            if isinstance(cand, dict) and cand.get("enabled") is not False and str(cand.get("alg") or "").strip().lower() == "hmac-sha256":
                selected_kid = str(kid)
                selected_entry = cand
                break

    if not selected_kid or selected_entry is None:
        return {}

    raw_secret = selected_entry.get("secret")
    if not isinstance(raw_secret, str) or not raw_secret:
        return {}
    try:
        if raw_secret.startswith("b64:"):
            secret_bytes = base64.b64decode(raw_secret[4:].strip(), validate=True)
        else:
            secret_bytes = _parse_hmac_secret(raw_secret)
    except Exception:
        return {}
    if not secret_bytes:
        return {}

    pure_path = urllib.parse.urlsplit(str(path or "/")).path or "/"
    norm_method = str(method or "POST").strip().upper()
    norm_auth = str(authority or "").strip()
    if not norm_auth:
        return {}

    created = int(time.time())
    sig_params = f'("@method" "@path" "@authority");created={created};keyid="{selected_kid}";alg="hmac-sha256"'
    sig_base = (
        f'"@method": {norm_method}\n'
        f'"@path": {pure_path}\n'
        f'"@authority": {norm_auth}\n'
        f'"@signature-params": {sig_params}'
    ).encode("utf-8")
    sig_b64 = base64.b64encode(hmac.new(secret_bytes, sig_base, hashlib.sha256).digest()).decode("ascii")
    return {
        "Signature-Input": f"sig1={sig_params}",
        "Signature": f"sig1=:{sig_b64}:",
    }


def _attest_error_result(
    url: str,
    error: str,
    *,
    http_status: int | None = None,
    agent_verified: str | None = None,
    verdict: str | None = None,
    signature_verified: bool = False,
    verification_receipt: dict | None = None,
) -> dict:
    return {
        "ok": False,
        "url": url,
        "http_status": http_status,
        "valid": False,
        "verdict": verdict,
        "signature_verified": signature_verified,
        "agent_verified": agent_verified,
        "verification_receipt": verification_receipt,
        "error": error,
    }


def attest_confinement_receipt(
    receipt: dict,
    *,
    attest_url: str | None = None,
    hmac_key: str | bytes | None = None,
    public_key_pem: str | None = None,
    timeout_sec: int = 15,
    key_file: str | Path | None = None,
    api_key: str | None = None,
) -> dict:
    url = str(
        attest_url
        or os.environ.get("WM_CONFINEMENT_ATTEST_URL")
        or "https://api.whitemagic.dev/verify-confinement?receipt=1"
    ).strip()
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        return _attest_error_result(url, f"invalid attestation URL (require http/https with host): {url!r}")
    if not isinstance(receipt, dict):
        return _attest_error_result(url, "receipt must be a JSON object")

    receipt_wire = {k: v for k, v in receipt.items() if k != "remote_attestation"}
    body: dict = {"receipt": receipt_wire}
    sig_alg = receipt_wire.get("signature_alg")
    if hmac_key is not None:
        if isinstance(hmac_key, (bytes, bytearray)):
            body["hmac_key"] = "hex:" + bytes(hmac_key).hex()
        else:
            body["hmac_key"] = str(hmac_key)
    elif sig_alg == "hmac-sha256":
        try:
            env_key = _load_hmac_key_from_env()
        except (ValueError, OSError) as exc:
            return _attest_error_result(url, f"failed to load HMAC key for remote attestation: {exc}")
        if env_key is not None:
            body["hmac_key"] = "hex:" + env_key.hex()
    elif sig_alg == "ed25519" and public_key_pem:
        body["public_key_pem"] = public_key_pem
    elif not sig_alg:
        body["require_signature"] = False

    headers: dict[str, str] = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "X-WM-Trial": "1",
    }
    headers.update(
        _sign_rfc9421_hmac_headers(
            "POST",
            parsed.path or "/",
            parsed.netloc,
            key_file=key_file,
        )
    )
    eff_api_key = (api_key if api_key is not None else os.environ.get("WM_API_KEY", "")).strip()
    if eff_api_key:
        headers["Authorization"] = f"Bearer {eff_api_key}"
        headers["X-WM-Key"] = eff_api_key

    req = urllib.request.Request(
        url,
        data=json.dumps(body, ensure_ascii=False).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    http_status: int | None = None
    agent_verified: str | None = None
    try:
        with urllib.request.urlopen(req, timeout=max(1, int(timeout_sec))) as resp:
            http_status = int(getattr(resp, "status", None) or resp.getcode())
            agent_verified = resp.headers.get("X-WM-Agent-Verified")
            raw_resp = resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        http_status = int(getattr(exc, "code", 0) or 0) or None
        if exc.headers is not None:
            agent_verified = exc.headers.get("X-WM-Agent-Verified")
        return _attest_error_result(
            url,
            f"remote attestation HTTP {http_status}: {exc.reason}",
            http_status=http_status,
            agent_verified=agent_verified,
        )
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return _attest_error_result(url, f"remote attestation request failed: {exc}")

    try:
        resp_data = json.loads(raw_resp)
    except Exception as exc:
        return _attest_error_result(
            url,
            f"malformed JSON from remote attestation endpoint: {exc}",
            http_status=http_status,
            agent_verified=agent_verified,
        )
    if not isinstance(resp_data, dict):
        return _attest_error_result(
            url,
            "remote attestation response must be a JSON object",
            http_status=http_status,
            agent_verified=agent_verified,
        )

    valid = resp_data.get("valid") is True
    verdict = resp_data.get("verdict") if isinstance(resp_data.get("verdict"), str) else None
    signature_verified = resp_data.get("signature_verified") is True
    v_rcpt = resp_data.get("verification_receipt") if isinstance(resp_data.get("verification_receipt"), dict) else None
    if not valid:
        errs = resp_data.get("errors")
        if isinstance(errs, list) and errs:
            err_msg = "; ".join(str(e) for e in errs)
        elif resp_data.get("error"):
            err_msg = str(resp_data.get("error"))
        else:
            err_msg = f"remote attestation rejected (valid={resp_data.get('valid')!r}, verdict={verdict!r})"
        return _attest_error_result(
            url,
            err_msg,
            http_status=http_status,
            agent_verified=agent_verified,
            verdict=verdict,
            signature_verified=signature_verified,
            verification_receipt=v_rcpt,
        )

    return {
        "ok": True,
        "url": url,
        "http_status": http_status,
        "valid": True,
        "verdict": verdict,
        "signature_verified": signature_verified,
        "agent_verified": agent_verified,
        "verification_receipt": v_rcpt,
        "error": None,
    }


def run_confined_verify(
    wt_path: Path,
    verify_cmd: str,
    timeout_sec: int,
    sign_receipt: bool | None = None,
    sign_alg: str | None = None,
    require_sign: bool = False,
    receipt_log: str | None = None,
    attest_remote: bool = False,
    attest_url: str | None = None,
) -> dict:
    try:
        sign_active, resolved_alg, sign_key = _resolve_signing_plan(
            sign_receipt=sign_receipt,
            sign_alg=sign_alg,
            require_sign=require_sign,
        )
    except (ValueError, OSError) as exc:
        rcpt = _build_confinement_receipt(
            bwrap_bin=find_bwrap(),
            network_isolated=False,
            worktree_path=str(wt_path),
            worktree_diff_sha256=None,
            verify_exit_code=None,
            scope_confined=False,
            verify_cmd=verify_cmd,
            bwrap_flags=[],
        )
        append_receipt_ledger(rcpt, ledger_path=receipt_log)
        return {
            "ok": False,
            "error": f"confinement receipt signing failed closed: {exc}",
            "confinement_receipt": rcpt,
        }

    bwrap = find_bwrap()
    if bwrap is None:
        rcpt = _build_confinement_receipt(
            bwrap_bin=None,
            network_isolated=False,
            worktree_path=str(wt_path),
            worktree_diff_sha256=None,
            verify_exit_code=None,
            scope_confined=False,
            verify_cmd=verify_cmd,
            bwrap_flags=[],
        )
        rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
        append_receipt_ledger(rcpt, ledger_path=receipt_log)
        return {
            "ok": False,
            "error": "bwrap binary not found (fail-closed confinement)",
            "confinement_receipt": rcpt,
        }

    if not wt_path.is_dir():
        rcpt = _build_confinement_receipt(
            bwrap_bin=bwrap,
            network_isolated=False,
            worktree_path=str(wt_path),
            worktree_diff_sha256=None,
            verify_exit_code=None,
            scope_confined=False,
            verify_cmd=verify_cmd,
            bwrap_flags=[],
        )
        rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
        append_receipt_ledger(rcpt, ledger_path=receipt_log)
        return {
            "ok": False,
            "error": f"worktree path does not exist: {wt_path}",
            "confinement_receipt": rcpt,
        }

    resolved_wt = wt_path.resolve()
    diff_sha = _compute_worktree_diff_sha256(resolved_wt)
    tmp_git_ro_binds = _discover_tmp_git_ro_binds(resolved_wt)
    is_seatbelt = Path(bwrap).name == "sandbox-exec"
    scratch_tmp: Path | None = None
    run_env = None
    run_cwd = None
    if is_seatbelt:
        scratch_tmp = Path(tempfile.mkdtemp(prefix="wm-sbx-tmp-")).resolve()
        bwrap_flags = ["--sandbox-exec", "--ro-bind", "/", "/"]
        for gpath in tmp_git_ro_binds:
            bwrap_flags.extend(["--ro-bind", str(gpath), str(gpath)])
        bwrap_flags.extend(["--bind", str(resolved_wt), str(resolved_wt), "--unshare-net"])

        def _sbpl_esc(s: str) -> str:
            return s.replace("\\", "\\\\").replace('"', '\\"')

        ro_rules = "\n".join(f'(deny file-write* (subpath "{_sbpl_esc(str(gpath))}"))' for gpath in tmp_git_ro_binds)
        sbpl = (
            "(version 1)\n"
            "(allow default)\n"
            "(deny network*)\n"
            "(deny file-write*)\n"
            "(allow file-write*\n"
            '  (literal "/dev/null")\n'
            '  (literal "/dev/zero")\n'
            '  (literal "/dev/dtracehelper")\n'
            '  (literal "/dev/tty")\n'
            f'  (subpath "{_sbpl_esc(str(resolved_wt))}")\n'
            f'  (subpath "{_sbpl_esc(str(scratch_tmp))}"))'
            + (f"\n{ro_rules}" if ro_rules else "")
        )
        bwrap_cmd = [bwrap, "-p", sbpl, "sh", "-c", verify_cmd]
        run_env = {**os.environ, "TMPDIR": str(scratch_tmp)}
        run_cwd = str(resolved_wt)
    else:
        bwrap_cmd = [
            bwrap,
            "--ro-bind",
            "/",
            "/",
            "--dev",
            "/dev",
            "--proc",
            "/proc",
            "--tmpfs",
            "/tmp",
        ]
        for gpath in tmp_git_ro_binds:
            bwrap_cmd.extend(["--ro-bind", str(gpath), str(gpath)])
        bwrap_cmd.extend([
            "--bind",
            str(resolved_wt),
            str(resolved_wt),
            "--chdir",
            str(resolved_wt),
            "--unshare-net",
            "--die-with-parent",
            "--",
            "sh",
            "-c",
            verify_cmd,
        ])
        bwrap_flags = bwrap_cmd[1 : bwrap_cmd.index("--")]
    eff_timeout = max(1, min(int(timeout_sec), 90))
    try:
        proc = subprocess.run(
            bwrap_cmd,
            capture_output=True,
            text=True,
            timeout=eff_timeout,
            env=run_env,
            cwd=run_cwd,
        )
    except subprocess.TimeoutExpired as exc:
        if scratch_tmp is not None:
            shutil.rmtree(scratch_tmp, ignore_errors=True)
        stdout_s = exc.stdout.decode("utf-8", errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
        stderr_s = exc.stderr.decode("utf-8", errors="replace") if isinstance(exc.stderr, bytes) else (exc.stderr or "")
        rcpt = _build_confinement_receipt(
            bwrap_bin=bwrap,
            network_isolated=True,
            worktree_path=str(resolved_wt),
            worktree_diff_sha256=diff_sha,
            verify_exit_code=None,
            scope_confined=True,
            verify_cmd=verify_cmd,
            bwrap_flags=bwrap_flags,
            verify_stdout_tail=stdout_s[-800:],
            verify_stderr_tail=stderr_s[-800:],
        )
        rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
        append_receipt_ledger(rcpt, ledger_path=receipt_log)
        return {
            "ok": False,
            "error": f"confined verify timed out after {eff_timeout}s",
            "confinement_receipt": rcpt,
        }
    except OSError as exc:
        if scratch_tmp is not None:
            shutil.rmtree(scratch_tmp, ignore_errors=True)
        rcpt = _build_confinement_receipt(
            bwrap_bin=bwrap,
            network_isolated=False,
            worktree_path=str(resolved_wt),
            worktree_diff_sha256=diff_sha,
            verify_exit_code=None,
            scope_confined=False,
            verify_cmd=verify_cmd,
            bwrap_flags=[],
        )
        rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
        append_receipt_ledger(rcpt, ledger_path=receipt_log)
        return {
            "ok": False,
            "error": f"bwrap execution failed: {exc}",
            "confinement_receipt": rcpt,
        }
    if scratch_tmp is not None:
        shutil.rmtree(scratch_tmp, ignore_errors=True)

    rcpt = _build_confinement_receipt(
        bwrap_bin=bwrap,
        network_isolated=True,
        worktree_path=str(resolved_wt),
        worktree_diff_sha256=diff_sha,
        verify_exit_code=proc.returncode,
        scope_confined=True,
        verify_cmd=verify_cmd,
        bwrap_flags=bwrap_flags,
        verify_stdout_tail=(proc.stdout or "")[-800:],
        verify_stderr_tail=(proc.stderr or "")[-800:],
    )
    rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
    att_ok = True
    att_err: str | None = None
    if attest_remote:
        att_hmac = sign_key if (sign_active and resolved_alg == "hmac-sha256" and isinstance(sign_key, (bytes, bytearray))) else None
        att_pub_pem: str | None = None
        if sign_active and resolved_alg == "ed25519" and sign_key is not None:
            try:
                att_pub_pem = _extract_ed25519_public_pem(sign_key)
            except (ValueError, OSError):
                att_pub_pem = None
        att = attest_confinement_receipt(
            rcpt,
            attest_url=attest_url,
            hmac_key=att_hmac,
            public_key_pem=att_pub_pem,
            timeout_sec=min(max(int(timeout_sec), 5), 30),
        )
        rcpt["remote_attestation"] = att
        if not att.get("ok"):
            att_ok = False
            att_err = att.get("error") or "remote confinement attestation failed"
    append_receipt_ledger(rcpt, ledger_path=receipt_log)
    out_res: dict = {
        "ok": (proc.returncode == 0) and att_ok,
        "confinement_receipt": rcpt,
    }
    if att_err and proc.returncode == 0:
        out_res["error"] = att_err
    return out_res


def resolve_model(raw: str | None, allow_any_model: bool = False) -> str:
    fam = (os.environ.get("WM_GROK_FAMILY") or DEFAULT_FAMILY).strip().lower()
    if not re.match(r"^(?:cursor-)?grok-\d+\.\d+$", fam):
        fam = DEFAULT_FAMILY
    m = (raw or "high").strip().lower()
    if m in SHORTHAND_TIERS:
        return f"{fam}-{m}"
    if m.endswith("-fast") and m[:-5] in SHORTHAND_TIERS:
        return f"{fam}-{m}"
    if VALID_EXPLICIT_RE.match(m):
        return m
    env_any = os.environ.get("WM_GROK_ALLOW_ANY_MODEL", "").strip().lower() in _TRUTHY
    if (allow_any_model or env_any) and ANY_CURSOR_MODEL_RE.match(m):
        return m
    raise ValueError(f"Unsupported Grok 4.7 model '{raw}'. Use low|medium|high|xhigh|*-fast or grok-4.7-*")


def cmd_status() -> int:
    ca = find_cursor_agent()
    if not ca:
        print(json.dumps({"ok": False, "error": "cursor-agent not found"}))
        return 1
    st = subprocess.run([ca, "status"], capture_output=True, text=True, timeout=10)
    wt_root = Path.home() / ".cursor" / "worktrees"
    worktrees = []
    if wt_root.is_dir():
        for p in sorted(wt_root.glob("*/*"))[:12]:
            if p.is_dir():
                worktrees.append(str(p.relative_to(wt_root)))
    fam = (os.environ.get("WM_GROK_FAMILY") or DEFAULT_FAMILY).strip().lower()
    out = {
        "ok": st.returncode == 0,
        "cursor_agent": ca,
        "auth": (st.stdout or st.stderr).strip().splitlines()[-1] if (st.stdout or st.stderr).strip() else "unknown",
        "default_family": fam,
        "models": [f"{fam}-{t}" for t in SHORTHAND_TIERS] + [f"{fam}-{t}-fast" for t in SHORTHAND_TIERS],
        "presets": list(SWARM_PRESETS.keys()),
        "bwrap": find_bwrap(),
        "worktrees": worktrees,
    }
    print(json.dumps(out, indent=2))
    return 0 if st.returncode == 0 else 1


def _run_one(
    ca: str,
    action: str,
    model: str,
    task: dict,
    timeout_sec: int,
    idx: int,
    payload_confined: bool = False,
    payload_verify_cmd: str | None = None,
    payload_sign_receipt: bool | None = None,
    payload_sign_alg: str | None = None,
    payload_receipt_log: str | None = None,
    payload_attest_remote: bool = False,
    payload_attest_url: str | None = None,
    payload_empty_cwd: bool = False,
    payload_no_tools_guard: bool = False,
) -> dict:
    name = str(task.get("name") or f"grok-{idx + 1}")
    prompt = str(task.get("prompt") or "").strip()
    if not prompt:
        return {"name": name, "ok": False, "error": "empty prompt"}

    empty_cwd = bool(task.get("empty_cwd", payload_empty_cwd))
    no_tools_guard = bool(task.get("no_tools_guard", payload_no_tools_guard))
    ws_override: str | None = None
    if empty_cwd and action in ("ask", "plan"):
        empty_dir = Path.home() / ".local" / "share" / "whitemagic" / "grok_fleet" / "_empty_cwd"
        empty_dir.mkdir(parents=True, exist_ok=True)
        cwd = str(empty_dir)
        ws_override = cwd
    else:
        cwd = str(task.get("cwd") or os.getcwd())
        if not Path(cwd).is_dir():
            return {"name": name, "ok": False, "error": f"cwd does not exist: {cwd}"}
    if no_tools_guard and action == "ask" and not prompt.startswith("PURE SYNTHESIS MODE:"):
        prompt = NO_TOOLS_BANNER + prompt

    confined = bool(task.get("confined", payload_confined))
    verify_cmd = task.get("verify_cmd", payload_verify_cmd)
    sign_receipt = task.get("sign_receipt", payload_sign_receipt)
    sign_alg = task.get("sign_alg", payload_sign_alg)
    receipt_log = task.get("receipt_log", payload_receipt_log)
    attest_remote = bool(task.get("attest_remote", payload_attest_remote))
    attest_url = task.get("attest_url", payload_attest_url)
    eff_verify_cmd = str(verify_cmd or "git status --short") if action == "worktree" else (str(verify_cmd) if verify_cmd else None)

    if confined:
        try:
            sign_active, resolved_alg, sign_key = _resolve_signing_plan(
                sign_receipt=sign_receipt,
                sign_alg=sign_alg,
                require_sign=bool(sign_receipt is True or (sign_alg is not None and str(sign_alg).strip())),
            )
        except (ValueError, OSError) as exc:
            rcpt = _build_confinement_receipt(
                bwrap_bin=find_bwrap(),
                network_isolated=False,
                worktree_path=cwd,
                worktree_diff_sha256=None,
                verify_exit_code=None,
                scope_confined=False,
                verify_cmd=eff_verify_cmd,
                bwrap_flags=[],
            )
            append_receipt_ledger(rcpt, ledger_path=receipt_log)
            return {
                "name": name,
                "ok": False,
                "error": f"confinement receipt signing failed closed: {exc}",
                "confinement_receipt": rcpt,
            }
        if find_bwrap() is None:
            rcpt = _build_confinement_receipt(
                bwrap_bin=None,
                network_isolated=False,
                worktree_path=cwd,
                worktree_diff_sha256=None,
                verify_exit_code=None,
                scope_confined=False,
                verify_cmd=eff_verify_cmd,
                bwrap_flags=[],
            )
            rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
            append_receipt_ledger(rcpt, ledger_path=receipt_log)
            return {
                "name": name,
                "ok": False,
                "error": "bwrap binary not found (fail-closed confinement)",
                "confinement_receipt": rcpt,
            }

    cmd = [ca, "-p", "--output-format", "json", "--model", model]
    wt_name = ""
    if action == "ask":
        cmd.extend(["--mode=ask", "--trust"])
    elif action == "plan":
        cmd.extend(["--mode=plan", "--trust"])
    elif action == "worktree":
        git_chk = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if git_chk.returncode != 0:
            return {"name": name, "ok": False, "error": f"worktree action requires a git repo cwd (got {cwd})"}
        raw_wt = str(task.get("worktree_name") or f"grok-{name}-{int(time.time()) % 10000}")
        wt_name = SAFE_WT_RE.sub("-", raw_wt).strip("-")[:40] or f"grok-{idx + 1}"
        cmd.extend(["-w", wt_name, "--force", "--trust"])
    elif action == "resume":
        sid = str(task.get("session_id") or "").strip()
        if not sid:
            return {"name": name, "ok": False, "error": "resume action requires session_id"}
        cmd.extend(["--resume", sid, "--trust"])
        if task.get("allow_write"):
            cmd.append("--force")
        else:
            cmd.append("--mode=ask")
    else:
        return {"name": name, "ok": False, "error": f"unknown action: {action}"}

    if ws_override is not None:
        cmd.extend(["--workspace", ws_override])
    cmd.append(prompt)
    t0 = time.perf_counter()
    try:
        proc = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout_sec)
    except subprocess.TimeoutExpired:
        return {"name": name, "ok": False, "wall_s": round(time.perf_counter() - t0, 2), "error": f"timed out after {timeout_sec}s"}
    except Exception as exc:
        return {"name": name, "ok": False, "wall_s": round(time.perf_counter() - t0, 2), "error": str(exc)}

    wall_s = round(time.perf_counter() - t0, 2)
    raw_out = (proc.stdout or "").strip()
    parsed = None
    for line in reversed(raw_out.splitlines()):
        line = line.strip()
        if line.startswith("{") and line.endswith("}"):
            try:
                parsed = json.loads(line)
                break
            except Exception:
                pass

    if proc.returncode != 0 and not parsed:
        return {
            "name": name,
            "ok": False,
            "wall_s": wall_s,
            "error": ((proc.stderr or raw_out) or f"exit {proc.returncode}")[:300],
        }

    result_text = str((parsed or {}).get("result") or raw_out)
    usage = (parsed or {}).get("usage") or {}
    rec = {
        "name": name,
        "ok": proc.returncode == 0 and not bool((parsed or {}).get("is_error")),
        "wall_s": wall_s,
        "api_ms": (parsed or {}).get("duration_api_ms"),
        "session_id": (parsed or {}).get("session_id"),
        "usage": {
            "in": usage.get("inputTokens", 0),
            "cache_read": usage.get("cacheReadTokens", 0),
            "out": usage.get("outputTokens", 0),
            "reason": usage.get("reasoningTokens", 0),
        },
        "result": result_text,
    }

    if action == "worktree" and wt_name:
        repo_name = Path(git_chk.stdout.strip()).name
        wt_path = Path.home() / ".cursor" / "worktrees" / repo_name / wt_name
        if wt_path.is_dir():
            st = subprocess.run(["git", "-C", str(wt_path), "status", "--short"], capture_output=True, text=True)
            ds = subprocess.run(["git", "-C", str(wt_path), "diff", "--stat"], capture_output=True, text=True)
            rec["worktree_path"] = str(wt_path)
            rec["git_status"] = st.stdout.strip()[:400]
            rec["diff_stat"] = ds.stdout.strip()[:400]
            if confined:
                vres = run_confined_verify(
                    wt_path,
                    str(verify_cmd or "git status --short"),
                    timeout_sec,
                    sign_receipt=sign_receipt,
                    sign_alg=sign_alg,
                    require_sign=bool(sign_receipt is True or (sign_alg is not None and str(sign_alg).strip())),
                    receipt_log=receipt_log,
                    attest_remote=attest_remote,
                    attest_url=attest_url,
                )
                rec["confinement_receipt"] = vres["confinement_receipt"]
                if not vres["ok"]:
                    rec["ok"] = False
                    rec.setdefault(
                        "error",
                        vres.get("error")
                        or f"confined verify failed (exit {vres['confinement_receipt'].get('verify_exit_code')})",
                    )
        elif confined:
            rec["ok"] = False
            rec.setdefault("error", f"worktree path not created for confined verify: {wt_path}")
            rcpt = _build_confinement_receipt(
                bwrap_bin=find_bwrap(),
                network_isolated=False,
                worktree_path=str(wt_path),
                worktree_diff_sha256=None,
                verify_exit_code=None,
                scope_confined=False,
                verify_cmd=str(verify_cmd or "git status --short"),
                bwrap_flags=[],
            )
            try:
                rcpt = _sign_with_plan(rcpt, sign_active, resolved_alg, sign_key)
            except (ValueError, OSError) as exc:
                rec["error"] = f"{rec['error']}; receipt signing failed closed: {exc}"
            append_receipt_ledger(rcpt, ledger_path=receipt_log)
            rec["confinement_receipt"] = rcpt
    elif confined and verify_cmd:
        vres = run_confined_verify(
            Path(cwd),
            str(verify_cmd),
            timeout_sec,
            sign_receipt=sign_receipt,
            sign_alg=sign_alg,
            require_sign=bool(sign_receipt is True or (sign_alg is not None and str(sign_alg).strip())),
            receipt_log=receipt_log,
            attest_remote=attest_remote,
            attest_url=attest_url,
        )
        rec["confinement_receipt"] = vres["confinement_receipt"]
        if not vres["ok"]:
            rec["ok"] = False
            rec.setdefault(
                "error",
                vres.get("error")
                or f"confined verify failed (exit {vres['confinement_receipt'].get('verify_exit_code')})",
            )

    return rec


def run_swarm(payload: dict) -> dict:
    action = str(payload.get("action") or "ask").strip().lower()
    if action not in ("ask", "plan", "worktree", "resume"):
        return {"ok": False, "error": f"Invalid action '{action}' (expected ask|plan|worktree|resume)"}
    preset_name = str(payload.get("preset") or "").strip().lower()
    preset_cfg = SWARM_PRESETS.get(preset_name, {}) if preset_name else {}
    allow_any_model = bool(payload.get("allow_any_model", False))
    try:
        model = resolve_model(payload.get("model") or preset_cfg.get("model"), allow_any_model=allow_any_model)
    except ValueError as exc:
        return {"ok": False, "error": str(exc)}

    tasks = payload.get("tasks")
    if not isinstance(tasks, list) or not tasks:
        return {"ok": False, "error": "'tasks' must be a non-empty array of {name, prompt, ...}"}
    tasks = tasks[:6]

    payload_confined = bool(payload.get("confined", False))
    payload_verify_cmd = payload.get("verify_cmd")
    payload_sign_receipt = payload.get("sign_receipt")
    payload_sign_alg = payload.get("sign_alg")
    payload_receipt_log = payload.get("receipt_log")
    payload_attest_remote = bool(payload.get("attest_remote", False))
    payload_attest_url = payload.get("attest_url")
    payload_empty_cwd = bool(payload.get("empty_cwd", preset_cfg.get("empty_cwd", False)))
    payload_no_tools_guard = bool(payload.get("no_tools_guard", preset_cfg.get("no_tools_guard", False)))

    any_confined = any(
        bool(t.get("confined", payload_confined)) if isinstance(t, dict) else payload_confined
        for t in tasks
    )
    bwrap_bin = find_bwrap() if any_confined else None

    if any_confined:
        sign_errors: list[tuple[int, str]] = []
        sign_plans: list[tuple[bool, str | None, object | None]] = []
        for i, t in enumerate(tasks):
            td = t if isinstance(t, dict) else {}
            t_conf = bool(td.get("confined", payload_confined))
            if not t_conf:
                sign_plans.append((False, None, None))
                continue
            t_sr = td.get("sign_receipt", payload_sign_receipt)
            t_sa = td.get("sign_alg", payload_sign_alg)
            try:
                plan = _resolve_signing_plan(
                    sign_receipt=t_sr,
                    sign_alg=t_sa,
                    require_sign=bool(t_sr is True or (t_sa is not None and str(t_sa).strip())),
                )
                sign_plans.append(plan)
            except (ValueError, OSError) as exc:
                sign_plans.append((False, None, None))
                sign_errors.append((i, str(exc)))

        if sign_errors:
            err_msg = f"confinement receipt signing failed closed: {sign_errors[0][1]}"
            err_map = dict(sign_errors)
            fail_workers = []
            for i, t in enumerate(tasks):
                td = t if isinstance(t, dict) else {}
                vcmd = td.get("verify_cmd", payload_verify_cmd)
                eff_cmd = str(vcmd or "git status --short") if action == "worktree" else (str(vcmd) if vcmd else None)
                rcpt = _build_confinement_receipt(
                    bwrap_bin=bwrap_bin,
                    network_isolated=False,
                    worktree_path=str(td.get("cwd") or os.getcwd()),
                    worktree_diff_sha256=None,
                    verify_exit_code=None,
                    scope_confined=False,
                    verify_cmd=eff_cmd,
                    bwrap_flags=[],
                )
                t_log = td.get("receipt_log", payload_receipt_log)
                append_receipt_ledger(rcpt, ledger_path=t_log)
                fail_workers.append(
                    {
                        "name": str(td.get("name") or f"grok-{i + 1}"),
                        "ok": False,
                        "error": f"confinement receipt signing failed closed: {err_map[i]}" if i in err_map else err_msg,
                        "confinement_receipt": rcpt,
                    }
                )
            return {
                "ok": False,
                "action": action,
                "model": model,
                "error": err_msg,
                "workers": fail_workers,
            }

        if bwrap_bin is None:
            fail_workers = []
            for i, t in enumerate(tasks):
                td = t if isinstance(t, dict) else {}
                vcmd = td.get("verify_cmd", payload_verify_cmd)
                eff_cmd = str(vcmd or "git status --short") if action == "worktree" else (str(vcmd) if vcmd else None)
                rcpt = _build_confinement_receipt(
                    bwrap_bin=None,
                    network_isolated=False,
                    worktree_path=str(td.get("cwd") or os.getcwd()),
                    worktree_diff_sha256=None,
                    verify_exit_code=None,
                    scope_confined=False,
                    verify_cmd=eff_cmd,
                    bwrap_flags=[],
                )
                s_act, s_alg, s_key = sign_plans[i]
                rcpt = _sign_with_plan(rcpt, s_act, s_alg, s_key)
                t_log = td.get("receipt_log", payload_receipt_log)
                append_receipt_ledger(rcpt, ledger_path=t_log)
                fail_workers.append(
                    {
                        "name": str(td.get("name") or f"grok-{i + 1}"),
                        "ok": False,
                        "error": "bwrap binary not found (fail-closed confinement)",
                        "confinement_receipt": rcpt,
                    }
                )
            return {
                "ok": False,
                "action": action,
                "model": model,
                "error": "bwrap binary not found (fail-closed confinement)",
                "workers": fail_workers,
            }

    ca = find_cursor_agent()
    if not ca:
        return {"ok": False, "error": "cursor-agent binary not found"}

    concurrency = max(1, min(6, int(payload.get("concurrency") or 4)))
    timeout_sec = max(15, min(155, int(payload.get("timeout_sec") or 120)))
    max_chars = max(500, min(8400, int(payload.get("max_chars") or 7800)))

    t_wall0 = time.perf_counter()
    results = [None] * len(tasks)
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(concurrency, len(tasks))) as pool:
        futs = {
            pool.submit(
                _run_one,
                ca,
                action,
                model,
                t if isinstance(t, dict) else {"prompt": str(t)},
                timeout_sec,
                i,
                payload_confined,
                payload_verify_cmd,
                payload_sign_receipt,
                payload_sign_alg,
                payload_receipt_log,
                payload_attest_remote,
                payload_attest_url,
                payload_empty_cwd,
                payload_no_tools_guard,
            ): i
            for i, t in enumerate(tasks)
        }
        for fut in concurrent.futures.as_completed(futs):
            idx = futs[fut]
            try:
                results[idx] = fut.result()
            except Exception as exc:
                results[idx] = {"name": f"grok-{idx + 1}", "ok": False, "error": str(exc)}

    wall_s = round(time.perf_counter() - t_wall0, 2)
    sum_worker_s = round(sum(float(r.get("wall_s") or 0) for r in results if r), 2)
    speedup = round(sum_worker_s / max(wall_s, 0.01), 2)
    tot_in = sum(int((r.get("usage") or {}).get("in") or 0) for r in results if r)
    tot_cr = sum(int((r.get("usage") or {}).get("cache_read") or 0) for r in results if r)
    tot_out = sum(int((r.get("usage") or {}).get("out") or 0) for r in results if r)
    rate_mult = 2.0 if str(model).lower().endswith("-fast") else 1.0
    est_usd = round(rate_mult * (tot_in * 2.0 + tot_cr * 0.2 + tot_out * 6.0) / 1_000_000.0, 5)

    try:
        TELEM_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(TELEM_PATH, "a", encoding="utf-8") as f:
            f.write(
                json.dumps(
                    {
                        "ts": datetime.now(timezone.utc).isoformat(),
                        "action": action,
                        "model": model,
                        "preset": preset_name or None,
                        "workers": len(tasks),
                        "wall_s": wall_s,
                        "sum_worker_s": sum_worker_s,
                        "speedup_x": speedup,
                        "est_usd": est_usd,
                        "ok_count": sum(1 for r in results if r and r.get("ok")),
                    }
                )
                + "\n"
            )
    except Exception:
        pass

    per_worker_budget = max(350, (max_chars - 500) // max(len(results), 1))
    for r in results:
        if r and isinstance(r.get("result"), str) and len(r["result"]) > per_worker_budget:
            r["result"] = r["result"][: per_worker_budget - 20] + "\n... [truncated]"

    out = {
        "ok": all(r and r.get("ok") for r in results),
        "action": action,
        "model": model,
        "wall_s": wall_s,
        "sum_worker_s": sum_worker_s,
        "speedup_x": speedup,
        "est_usd": est_usd,
        "workers": results,
    }
    encoded = json.dumps(out, ensure_ascii=False, indent=2)
    if len(encoded) > max_chars:
        for r in results:
            if r and isinstance(r.get("result"), str):
                r["result"] = r["result"][: max(120, per_worker_budget // 2)] + "..."
        encoded = json.dumps(out, ensure_ascii=False, indent=2)[:max_chars]
    return {"_raw_text": encoded, **out}


def cmd_verify_receipt(
    file_arg: str,
    hmac_key: str | None = None,
    pubkey_file: str | None = None,
    attest_remote: bool = False,
    attest_url: str | None = None,
) -> int:
    try:
        raw_text = sys.stdin.read() if file_arg == "-" else Path(file_arg).read_text(encoding="utf-8")
        data = json.loads(raw_text)
    except Exception as exc:
        print(json.dumps({"ok": False, "reason": f"failed to read receipt JSON: {exc}"}))
        return 1

    receipt = data
    if isinstance(data, dict) and "receipt_version" not in data and isinstance(data.get("confinement_receipt"), dict):
        receipt = data["confinement_receipt"]

    ok, reason = verify_confinement_receipt(
        receipt,
        hmac_key=hmac_key,
        ed25519_public_key=pubkey_file,
    )
    out: dict = {
        "ok": ok,
        "reason": reason,
        "receipt_version": receipt.get("receipt_version") if isinstance(receipt, dict) else None,
        "signature_alg": receipt.get("signature_alg") if isinstance(receipt, dict) else None,
    }
    overall_ok = ok
    if attest_remote and ok:
        pub_pem: str | None = None
        if isinstance(receipt, dict) and receipt.get("signature_alg") == "ed25519":
            try:
                pub_pem = _extract_ed25519_public_pem(pubkey_file)
            except (ValueError, OSError):
                pub_pem = None
        att = attest_confinement_receipt(
            receipt,
            attest_url=attest_url,
            hmac_key=hmac_key,
            public_key_pem=pub_pem,
        )
        out["remote_attestation"] = att
        if not att.get("ok"):
            overall_ok = False
            out["ok"] = False
            out["reason"] = att.get("error") or "remote confinement attestation failed"
    print(json.dumps(out, indent=2))
    return 0 if overall_ok else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Parallel Grok 4.7 Swarm Runner via cursor-agent")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("status", help="Check cursor-agent auth, Grok 4.7 models, and worktrees")
    run_p = sub.add_parser("run", help="Run parallel swarm from --json-stdin")
    run_p.add_argument("--json-stdin", action="store_true", required=True)
    run_p.add_argument("--confined", action="store_true", help="Enable bwrap read-only/network-isolated verification")
    run_p.add_argument("--verify-cmd", default=None, help="Verification command executed inside bwrap confinement")
    run_p.add_argument("--sign-receipt", action="store_true", help="Sign confinement_receipt (fail-closed without key)")
    run_p.add_argument("--sign-alg", choices=["auto", "hmac-sha256", "ed25519"], default=None, help="Receipt signature algorithm")
    run_p.add_argument("--receipt-log", default=None, help="Append-only JSONL ledger path for confinement receipts")
    run_p.add_argument("--attest-remote", action="store_true", help="Attest confinement_receipt remotely via RFC 9421 POST /verify-confinement")
    run_p.add_argument("--attest-url", default=None, help="Override remote confinement attestation URL")

    wt_p = sub.add_parser("worktree", help="Run an isolated git-worktree Grok worker (optionally bwrap-confined)")
    wt_p.add_argument("--prompt", required=True, help="Worker prompt")
    wt_p.add_argument("--cwd", default=os.getcwd(), help="Repository cwd")
    wt_p.add_argument("--worktree-name", default=None, help="Explicit worktree name")
    wt_p.add_argument("--model", default="high", help="Grok 4.7 tier or explicit model")
    wt_p.add_argument("--timeout-sec", type=int, default=120, help="Worker timeout seconds")
    wt_p.add_argument("--confined", action="store_true", help="Enable bwrap read-only/network-isolated verification")
    wt_p.add_argument("--verify-cmd", default=None, help="Verification command executed inside bwrap confinement")
    wt_p.add_argument("--sign-receipt", action="store_true", help="Sign confinement_receipt (fail-closed without key)")
    wt_p.add_argument("--sign-alg", choices=["auto", "hmac-sha256", "ed25519"], default=None, help="Receipt signature algorithm")
    wt_p.add_argument("--receipt-log", default=None, help="Append-only JSONL ledger path for confinement receipts")
    wt_p.add_argument("--attest-remote", action="store_true", help="Attest confinement_receipt remotely via RFC 9421 POST /verify-confinement")
    wt_p.add_argument("--attest-url", default=None, help="Override remote confinement attestation URL")

    vr_p = sub.add_parser("verify-receipt", help="Verify a wm-confinement-receipt/1.1 JSON receipt")
    vr_p.add_argument("--file", default="-", help="Path to receipt JSON file or '-' for stdin")
    vr_p.add_argument("--hmac-key", default=None, help="HMAC key (UTF-8, hex:<hex>, or base64:<b64>)")
    vr_p.add_argument("--pubkey-file", default=None, help="Path to Ed25519 PEM or raw 32-byte public key")
    vr_p.add_argument("--attest-remote", action="store_true", help="Attest confinement_receipt remotely via RFC 9421 POST /verify-confinement")
    vr_p.add_argument("--attest-url", default=None, help="Override remote confinement attestation URL")

    args = parser.parse_args()
    if args.cmd == "status":
        return cmd_status()
    if args.cmd == "verify-receipt":
        return cmd_verify_receipt(
            args.file,
            args.hmac_key,
            args.pubkey_file,
            attest_remote=args.attest_remote,
            attest_url=args.attest_url,
        )
    if args.cmd == "run":
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except Exception as exc:
            print(json.dumps({"ok": False, "error": f"invalid JSON stdin: {exc}"}))
            return 1
        if args.confined:
            payload["confined"] = True
        if args.verify_cmd is not None:
            payload["verify_cmd"] = args.verify_cmd
        if args.sign_receipt:
            payload["sign_receipt"] = True
        if args.sign_alg is not None:
            payload["sign_alg"] = args.sign_alg
        if args.receipt_log is not None:
            payload["receipt_log"] = args.receipt_log
        if args.attest_remote:
            payload["attest_remote"] = True
        if args.attest_url is not None:
            payload["attest_url"] = args.attest_url
        res = run_swarm(payload)
        print(res.pop("_raw_text", json.dumps(res, indent=2)))
        return 0 if res.get("ok") else 1
    if args.cmd == "worktree":
        task = {"name": "grok-1", "prompt": args.prompt, "cwd": args.cwd}
        if args.worktree_name:
            task["worktree_name"] = args.worktree_name
        payload = {
            "action": "worktree",
            "model": args.model,
            "timeout_sec": args.timeout_sec,
            "confined": bool(args.confined),
            "tasks": [task],
        }
        if args.verify_cmd is not None:
            payload["verify_cmd"] = args.verify_cmd
        if args.sign_receipt:
            payload["sign_receipt"] = True
        if args.sign_alg is not None:
            payload["sign_alg"] = args.sign_alg
        if args.receipt_log is not None:
            payload["receipt_log"] = args.receipt_log
        if args.attest_remote:
            payload["attest_remote"] = True
        if args.attest_url is not None:
            payload["attest_url"] = args.attest_url
        res = run_swarm(payload)
        print(res.pop("_raw_text", json.dumps(res, indent=2)))
        return 0 if res.get("ok") else 1

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
