#!/usr/bin/env python3
"""
wm-local-digest — Zero-cloud-credit RLM/LID external corpus & log digester.
Queries your local llama-server (default http://127.0.0.1:18898, Qwen3-4B / Valkyrie)
with optional semantic chunk ranking via local bge-small embeddings (:18899) so huge
logs, transcripts, and documents stay OUTSIDE Gemini 4's prompt window ($0 cloud tokens).
"""
import argparse
import json
import math
import os
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

LLM_URL = os.environ.get("WM_LOCAL_LLM_URL", "http://127.0.0.1:18898/v1/chat/completions")
LLM_MODEL = os.environ.get("WM_LOCAL_LLM_MODEL", "valkyrie")
EMBED_URL = os.environ.get("WM_LOCAL_EMBED_URL", "http://127.0.0.1:18899/v1/embeddings")
EMBED_MODEL = os.environ.get("WM_LOCAL_EMBED_MODEL", "bge-small")


def post_json(url, payload, timeout=30):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8", errors="replace"))


def chunk_text(text, chunk_chars=900, overlap=120):
    if len(text) <= chunk_chars:
        return [text]
    chunks = []
    start = 0
    n = len(text)
    while start < n:
        end = min(n, start + chunk_chars)
        if end < n:
            nl = text.rfind("\n", start + chunk_chars // 2, end)
            if nl > start:
                end = nl + 1
        chunks.append(text[start:end])
        if end >= n:
            break
        start = max(end - overlap, start + 1)
    return chunks


def cosine(a, b):
    dot = sum(x * y for x, y in zip(a, b))
    na = math.sqrt(sum(x * x for x in a)) or 1.0
    nb = math.sqrt(sum(y * y for y in b)) or 1.0
    return dot / (na * nb)


def rank_chunks(chunks, query, top_k=3):
    if len(chunks) <= top_k:
        return list(enumerate(chunks))
    q_terms = [t for t in re.findall(r"[a-z0-9_@.-]{3,}", query.lower()) if t not in ("what", "does", "that", "this", "with", "from", "have", "were", "the", "and", "for")]
    lex_scores = []
    for idx, c in enumerate(chunks):
        low = c.lower()
        # Exact rare-term & identifier hits carry strong signal
        hits = sum(2.5 if ("@" in t or "_" in t or any(ch.isdigit() for ch in t)) else 1.0 for t in q_terms if t in low)
        freq = sum(min(low.count(t), 4) * 0.25 for t in q_terms)
        lex_scores.append(hits + freq)

    # Blend with local bge-small semantic cosine similarity (<=900 chars fits 512-tok ctx safely)
    sem_scores = [0.0] * len(chunks)
    cand_indices = sorted(range(len(chunks)), key=lambda i: (-lex_scores[i], i))[:32]
    try:
        q_emb = post_json(EMBED_URL, {"model": EMBED_MODEL, "input": query[:450]}, timeout=3)["data"][0]["embedding"]
        for i in range(0, len(cand_indices), 16):
            sub_idx = cand_indices[i : i + 16]
            batch = [chunks[k][:850] for k in sub_idx]
            res = post_json(EMBED_URL, {"model": EMBED_MODEL, "input": batch}, timeout=6)["data"]
            for k, item in zip(sub_idx, res):
                sem_scores[k] = cosine(q_emb, item["embedding"])
    except Exception:
        pass

    scored = [((lex_scores[i] * 0.65) + (sem_scores[i] * 4.0), i, chunks[i]) for i in range(len(chunks))]
    scored.sort(key=lambda x: (-x[0], x[1]))
    chosen = sorted(scored[:top_k], key=lambda x: x[1])
    return [(idx, txt) for _, idx, txt in chosen]


def main():
    ap = argparse.ArgumentParser(description="Digest huge files/logs locally via Qwen3-4B (:18898) at $0 cloud cost.")
    ap.add_argument("--file", "-f", help="Path to file to inspect (reads stdin if omitted)")
    ap.add_argument("--query", "-q", required=True, help="Targeted question or extraction instruction")
    ap.add_argument("--top-k", type=int, default=3, help="Max chunks returned / passed to local LLM (default: 3)")
    ap.add_argument("--max-tokens", type=int, default=220, help="Max LLM output tokens when --llm is set (default: 220)")
    ap.add_argument("--timeout", type=int, default=30, help="HTTP timeout seconds for --llm (default: 30)")
    ap.add_argument("--llm", action="store_true", help="Synthesize selected chunks via local llama-server (:18898); default is <1.5s hybrid bge-small+BM25 extract to keep Gemini 4 prefix cache warm")
    ap.add_argument("--tricameral", action="store_true", help="Rank & compress via local Safe-Rust wm-huginn (0.00 CU)")
    args = ap.parse_args()

    if args.file:
        p = Path(args.file).expanduser()
        if not p.is_file():
            sys.stderr.write(f"wm-local-digest: file not found: {p}\n")
            sys.exit(1)
        text = p.read_text(encoding="utf-8", errors="replace")
        src_label = f"{p.name} ({len(text)/1024:.1f} KB)"
    else:
        text = sys.stdin.read()
        src_label = f"stdin ({len(text)/1024:.1f} KB)"

    if not text.strip():
        print("[wm-local-digest] Empty input.")
        return

    # Fast lossless diagnostic line-extractor for noisy logs when querying errors/failures
    is_log = (args.file or "").lower().endswith((".log", ".out", ".err")) or "\x1b[" in text[:4096]
    wants_diag = bool(re.search(r"\b(fail|error|exception|traceback|panic|bug|warn|assert|broken)\b", args.query, re.I))
    if not args.llm and is_log and wants_diag:
        clean_text = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", text)
        lines = clean_text.splitlines()
        diag_re = re.compile(r"\b(FAIL|FAILED|ERROR|Exception|Traceback|AssertionError|panicked|CRITICAL|error\[E)\b")
        hits = []
        seen = set()
        for idx, ln in enumerate(lines):
            if diag_re.search(ln):
                lo = max(0, idx - 1)
                hi = min(len(lines), idx + 3)
                block = "\n".join(f"L{k+1}: {lines[k][:220]}" for k in range(lo, hi))
                if block not in seen:
                    seen.add(block)
                    hits.append(block)
        if hits:
            out = "\n---\n".join(hits)[:2400]
            red = 100.0 * (1.0 - len(out) / max(len(text), 1))
            print(f"[wm-local-digest | $0 diag-extract | {src_label} -> {len(out)/1024:.1f} KB (-{red:.0f}%) | {len(hits)} failure blocks]")
            print(out)
            return

    chunks = chunk_text(text)
    selected = rank_chunks(chunks, args.query, top_k=args.top_k)
    context = "\n\n".join(f"--- Chunk {idx+1}/{len(chunks)} ---\n{c}" for idx, c in selected)

    if args.tricameral:
        import shutil as _shutil
        import subprocess as _sp
        huginn_bin = _shutil.which("wm-huginn") or str(Path.home() / ".local" / "bin" / "wm-huginn")
        if Path(huginn_bin).exists():
            cands = [c.strip().replace("\n", " ")[:180] for _, c in selected[:5]]
            try:
                r_out = json.loads(_sp.check_output([huginn_bin, "recall-rank", args.query, "--candidates", *cands], text=True, timeout=8))
                pick_idx = max(0, min(len(selected) - 1, int(r_out.get("selected_index", 1)) - 1))
                win_idx, win_txt = selected[pick_idx]
                red = 100.0 * (1.0 - len(win_txt) / max(len(text), 1))
                print(f"[wm-local-digest | $0 wm-huginn recall-rank (margin={r_out.get('conformal_pick_margin')}) | {src_label} -> Chunk {win_idx+1}/{len(chunks)} (-{red:.0f}%)]")
                print(win_txt[:2400])
                return
            except Exception:
                pass

    if not args.llm:
        out = context[:3600]
        red = 100.0 * (1.0 - len(out) / max(len(text), 1))
        print(f"[wm-local-digest | $0 hybrid-extract | {src_label} -> {len(out)/1024:.1f} KB (-{red:.0f}%) | {len(selected)}/{len(chunks)} chunks]")
        print(out)
        return

    prompt = (
        "/no_think\n"
        "You are a concise, lossless engineering extractor. "
        "Answer ONLY from the excerpts with exact numbers, paths, and facts (<=6 bullets, no fluff).\n\n"
        f"SOURCE: {src_label}\nQUERY: {args.query}\n\nEXCERPTS:\n{context[:3000]}"
    )

    def call_ollama_fallback():
        ollama_base = os.environ.get("WM_OLLAMA_URL", "http://127.0.0.1:11434")
        model = os.environ.get("WM_OLLAMA_MODEL", "")
        if not model:
            with urllib.request.urlopen(f"{ollama_base}/api/tags", timeout=3) as r:
                tags = json.loads(r.read().decode("utf-8", errors="replace"))
            models = [m.get("name") for m in (tags.get("models") or []) if m.get("name")]
            if not models:
                raise RuntimeError("no Ollama models installed")
            model = models[0]
        res = post_json(
            f"{ollama_base}/v1/chat/completions",
            {
                "model": model,
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.1,
                "max_tokens": args.max_tokens,
            },
            timeout=args.timeout,
        )
        return model, res["choices"][0]["message"]["content"].strip()

    try:
        res = post_json(
            LLM_URL,
            {
                "model": LLM_MODEL,
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.1,
                "max_tokens": args.max_tokens,
                "chat_template_kwargs": {"enable_thinking": False},
            },
            timeout=args.timeout,
        )
        used_model = LLM_MODEL
        msg = res["choices"][0]["message"]["content"].strip()
    except Exception as primary_err:
        try:
            used_model, msg = call_ollama_fallback()
        except Exception as ollama_err:
            sys.stderr.write(
                f"[wm-local-digest] local LLM unavailable ({primary_err}; ollama: {ollama_err}); falling back to ranked excerpts:\n"
            )
            print(context[:4000])
            return

    # Strip <think>...</think> wrapper if emitted
    msg = re.sub(r"<think>.*?</think>\s*", "", msg, flags=re.S).strip()
    print(f"[wm-local-digest | $0 local {used_model} | {src_label} | {len(selected)}/{len(chunks)} chunks]")
    print(msg[:4000])


if __name__ == "__main__":
    main()
