_SWARM_MOD_LOCK = threading.Lock()
_SWARM_MOD_CACHE: Any = None


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _parse_bool(val: Any, default: bool = False) -> bool:
    if val is None:
        return default
    if isinstance(val, bool):
        return val
    if isinstance(val, (int, float)):
        return bool(val)
    s = str(val).strip().lower()
    if s in ("1", "true", "yes", "on"):
        return True
    if s in ("0", "false", "no", "off", ""):
        return False
    return default


def _safe_template_sub(template: str, mapping: dict[str, Any]) -> str:
    """Substitute only simple `{identifier}` placeholders (blocks format-string attr/index traversal)."""
    return re.sub(
        r"\{([A-Za-z_][A-Za-z0-9_]*)\}",
        lambda m: str(mapping[m.group(1)]) if m.group(1) in mapping else m.group(0),
        template,
    )


def _run_shell_bounded(cmd_str: str, cwd: Path, timeout_sec: int) -> tuple[int, str, str, str | None]:
    """Run a non-login shell command in its own process group with hard timeout + UTF-8 replace decoding."""
    tcap = max(1, min(600, int(timeout_sec)))
    proc: subprocess.Popen[bytes] | None = None
    try:
        proc = subprocess.Popen(
            ["bash", "-c", cmd_str],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
        out_b, err_b = proc.communicate(timeout=tcap)
        return (
            int(proc.returncode),
            out_b.decode("utf-8", errors="replace"),
            err_b.decode("utf-8", errors="replace"),
            None,
        )
    except subprocess.TimeoutExpired:
        if proc is not None:
            _kill_process_group(proc)
            try:
                proc.communicate(timeout=5)
            except Exception:
                pass
        return -1, "", f"command timed out after {tcap}s", f"timed out after {tcap}s"
    except OSError as exc:
        return -1, "", str(exc), f"os error: {exc}"


def _write_json_atomic(dest: Path, obj: Any) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.tmp.{os.getpid()}.{threading.get_ident()}")
    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False), encoding="utf-8")
    os.replace(tmp, dest)


def sanitize_id(raw: str, max_len: int = 48) -> str:
    cleaned = SAFE_ID_RE.sub("-", str(raw or "")).strip(".-")
    return (cleaned[:max_len] or "item")


def _load_exclusions_file(path: Path) -> list[str]:
    """Load intended-design exclusion bullets from JSON list or line-delimited text/markdown."""
    raw = path.read_text(encoding="utf-8")
    stripped = raw.strip()
    if not stripped:
        return []
    if stripped.startswith("["):
        parsed = json.loads(stripped)
        if isinstance(parsed, list):
            return [str(x).strip() for x in parsed if str(x).strip()]
    out: list[str] = []
    for line in raw.splitlines():
        item = line.strip()
        if not item or item.startswith("#"):
            continue
        if item.startswith("- ") or item.startswith("* "):
            item = item[2:].strip()
        if item:
            out.append(item)
    return out


def _load_trajectories_jsonl(path: Path, max_items: int = 3) -> list[dict[str, Any]]:
    """Load up to the most recent `max_items` winning-trajectory exemplars from JSONL."""
    if max_items <= 0:
        return []
    items: list[dict[str, Any]] = []
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line:
            continue
        obj = json.loads(line)
        if isinstance(obj, dict):
            items.append(obj)
    return items[-max_items:]


def compose_worker_prompt(
    base_prompt: str,
    *,
    intended_design_exclusions: list[str] | str | None = None,
    forbidden_actions: list[str] | None = None,
    winning_trajectories: list[dict[str, Any]] | None = None,
) -> str:
    """Place static campaign-level guardrails & exemplars BEFORE `[TASK]` for prefix-cache hits.

    Returns `base_prompt` verbatim when all optional hardening blocks are empty/None.
    """
    sections: list[str] = []
    if isinstance(intended_design_exclusions, str):
        exclusions = [x.strip() for x in intended_design_exclusions.splitlines() if x.strip()]
    else:
        exclusions = [str(x).strip() for x in (intended_design_exclusions or []) if str(x).strip()]
    if exclusions:
        lines = "\n".join(f"- {x}" for x in exclusions)
        sections.append(
            "[INTENDED_DESIGN_EXCLUSIONS]\n"
            "Do NOT report behaviors explicitly listed below as vulnerabilities unless a concrete "
            "bypass breaks the documented boundary:\n"
            f"{lines}"
        )

    forbidden = [str(x).strip() for x in (forbidden_actions or []) if str(x).strip()]
    if forbidden:
        lines = "\n".join(f"- {x}" for x in forbidden)
        sections.append(f"[FORBIDDEN_ACTIONS]\n{lines}")

    if winning_trajectories:
        traj_blocks: list[str] = []
        for idx, tr in enumerate(winning_trajectories, 1):
            target = str(tr.get("target") or "unknown")
            vclass = str(tr.get("vuln_class") or "general")
            summary = str(tr.get("summary") or "").strip()
            steps = [str(s).strip() for s in (tr.get("steps") or []) if str(s).strip()]
            head = f"{idx}. [{vclass}] target={target}"
            if summary:
                head += f" — {summary}"
            if steps:
                head += "\n   steps: " + " -> ".join(steps)
            traj_blocks.append(head)
        if traj_blocks:
            sections.append("[WINNING_TRAJECTORY_EXEMPLARS]\n" + "\n".join(traj_blocks))

    if not sections:
        return base_prompt
    return "\n\n".join(sections) + "\n\n[TASK]\n" + base_prompt


def _discover_removable_artifact_root() -> Path | None:
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or Path.home().name
    for base in (Path("/media"), Path("/run/media")):
        if not base.is_dir():
            continue
        user_dir = base / user
        if not user_dir.is_dir():
            continue
        try:
            for mnt in sorted(user_dir.iterdir()):
                if mnt.is_dir() and mnt.name.upper().startswith("SD_CARD") and os.access(mnt, os.W_OK):
                    return mnt / "grok_fleet"
        except OSError:
            continue
    return None


def default_artifact_dir() -> Path:
    env_dir = os.environ.get("WM_GROK_FLEET_ARTIFACT_DIR", "").strip()
    if env_dir:
        return Path(env_dir)
    removable = _discover_removable_artifact_root()
    if removable is not None:
        return removable
    return FALLBACK_ARTIFACT_ROOT


def default_db_path() -> Path:
    env_db = os.environ.get("WM_GROK_FLEET_DB", "").strip()
    return Path(env_db) if env_db else DEFAULT_DB_PATH


def find_cursor_agent(override: str | None = None) -> str | None:
    cand = override or os.environ.get("WM_CURSOR_AGENT_BIN", "").strip()
    if cand:
        p = Path(cand)
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
        hit = shutil.which(cand)
        if hit:
            return hit
        return None
    hit = shutil.which("cursor-agent")
    if hit:
        return hit
    local_bin = Path.home() / ".local" / "bin" / "cursor-agent"
    if local_bin.is_file() and os.access(local_bin, os.X_OK):
        return str(local_bin)
    return None


def resolve_fleet_model(
    raw: str | None,
    family: str | None = None,
    allow_any_model: bool = False,
) -> str:
    """Resolve tier shorthand or explicit Grok model string. Defaults to standard non-fast.

    Set allow_any_model=True (or WM_GROK_ALLOW_ANY_MODEL=1) to also allow any valid
    cursor-agent model slug (e.g., auto, composer-2.5, gpt-5.3-codex-high, claude-sonnet-5-thinking-high).
    """
    fam = (family or os.environ.get("WM_GROK_FAMILY") or DEFAULT_FAMILY).strip().lower()
    if not re.match(r"^(?:cursor-)?grok-\d+\.\d+$", fam):
        raise ValueError(f"Invalid WM_GROK_FAMILY '{fam}'")

    tok = (raw or "medium").strip().lower()
    if tok in SHORTHAND_TIERS:
        return f"{fam}-{tok}"
    if tok.endswith("-fast") and tok[:-5] in SHORTHAND_TIERS:
        return f"{fam}-{tok}"
    if EXPLICIT_MODEL_RE.match(tok):
        return tok
    env_any = os.environ.get("WM_GROK_ALLOW_ANY_MODEL", "").strip().lower() in ("1", "true", "yes", "on")
    if (allow_any_model or env_any) and ANY_CURSOR_MODEL_RE.match(tok):
        return tok
    raise ValueError(
        f"Unsupported Grok model '{raw}'. Use low|medium|high|xhigh|*-fast, explicit grok-X.Y-*, "
        f"or pass --allow-any-model for non-Grok Cursor models"
    )


_AUTO_FALLBACK_STEP: dict[str, str] = {
    "xhigh": "high-fast",
    "xhigh-fast": "high-fast",
    "high": "high-fast",
    "high-fast": "medium-fast",
    "medium": "medium-fast",
    "medium-fast": "low",
    "low": "low-fast",
}


def step_down_timeout_model(
    current_model: str,
    fallback_spec: str | None,
    allow_any_model: bool = False,
) -> str | None:
    """Compute a faster fallback model after a wall timeout ('auto' ladder or explicit model)."""
    if not fallback_spec:
        return None
    spec = str(fallback_spec).strip().lower()
    if not spec or spec in ("none", "off", "false"):
        return None
    cur = resolve_fleet_model(current_model, allow_any_model=allow_any_model)
    if spec == "auto":
        m = re.match(r"^((?:cursor-)?grok-\d+\.\d+)-(low|medium|high|xhigh)(-fast)?$", cur)
        if not m:
            return None
        fam = m.group(1)
        cur_tier = m.group(2) + (m.group(3) or "")
        nxt = _AUTO_FALLBACK_STEP.get(cur_tier)
        if not nxt:
            return None
        cand = f"{fam}-{nxt}"
        return cand if cand != cur else None
    cand = resolve_fleet_model(spec, allow_any_model=allow_any_model)
    return cand if cand != cur else None


def _load_swarm_module() -> Any:
    global _SWARM_MOD_CACHE
    with _SWARM_MOD_LOCK:
        if _SWARM_MOD_CACHE is not None:
            return _SWARM_MOD_CACHE
        prev_dont_write = sys.dont_write_bytecode
        sys.dont_write_bytecode = True
        try:
            swarm_path = REPO_SWARM_BIN if REPO_SWARM_BIN.is_file() else LOCAL_SWARM_BIN
            if not swarm_path.is_file():
                raise FileNotFoundError(f"wm-grok-swarm not found at {REPO_SWARM_BIN} or {LOCAL_SWARM_BIN}")
            loader = importlib.machinery.SourceFileLoader("wm_grok_swarm_mod", str(swarm_path))
            spec = importlib.util.spec_from_loader("wm_grok_swarm_mod", loader)
            if spec is None or spec.loader is None:
                raise ImportError(f"Could not load module spec from {swarm_path}")
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _SWARM_MOD_CACHE = mod
            return mod
        finally:
            sys.dont_write_bytecode = prev_dont_write


def _read_macos_mem_available_mb() -> float | None:
    """Compute approximate available RAM on macOS via vm_stat + sysctl hw.pagesize."""
    try:
        ps = subprocess.run(["sysctl", "-n", "hw.pagesize"], capture_output=True, text=True, timeout=3)
        page_size = int(ps.stdout.strip()) if ps.returncode == 0 and ps.stdout.strip().isdigit() else 4096
        vs = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=3)
        if vs.returncode != 0:
            return None
        pages = 0
        wanted = ("Pages free:", "Pages inactive:", "Pages speculative:", "Pages purgeable:")
        for line in vs.stdout.splitlines():
            for prefix in wanted:
                if line.startswith(prefix):
                    m = re.search(r"(\d+)", line[len(prefix):])
                    if m:
                        pages += int(m.group(1))
                    break
        return (pages * page_size) / (1024.0 * 1024.0) if pages > 0 else None
    except Exception:
        return None


def read_mem_available_mb(meminfo_text: str | None = None) -> float | None:
    text = meminfo_text
    if text is None:
        proc_mem = Path("/proc/meminfo")
        if proc_mem.is_file():
            try:
                text = proc_mem.read_text(encoding="utf-8", errors="replace")
            except OSError:
                return None
        elif sys.platform == "darwin":
            return _read_macos_mem_available_mb()
        else:
            return None
    for line in text.splitlines():
        if line.startswith("MemAvailable:"):
            parts = line.split()
            if len(parts) >= 2:
                try:
                    return int(parts[1]) / 1024.0
                except ValueError:
                    return 0.0
    return 0.0


def check_host_health(
    min_free_ram_mb: float = 1500.0,
    min_free_root_gb: float = 8.0,
    min_free_artifact_gb: float = 1.5,
    artifact_dir: Path | None = None,
    meminfo_text: str | None = None,
    root_free_bytes: int | None = None,
    artifact_free_bytes: int | None = None,
) -> tuple[bool, dict[str, Any]]:
    art_dir = artifact_dir or default_artifact_dir()
    ram_mb = read_mem_available_mb(meminfo_text)

    if root_free_bytes is None:
        try:
            root_free_bytes = shutil.disk_usage("/").free
        except OSError:
            root_free_bytes = 0
    if artifact_free_bytes is None:
        probe = art_dir
        while not probe.exists() and probe != probe.parent:
            probe = probe.parent
        try:
            artifact_free_bytes = shutil.disk_usage(probe).free
        except OSError:
            artifact_free_bytes = 0

    root_gb = root_free_bytes / (1024.0 ** 3)
    art_gb = artifact_free_bytes / (1024.0 ** 3)
    reasons: list[str] = []
    if ram_mb is not None and ram_mb < min_free_ram_mb:
        reasons.append(f"MemAvailable {ram_mb:.0f} MiB < {min_free_ram_mb:.0f} MiB")
    if root_gb < min_free_root_gb:
        reasons.append(f"root / free {root_gb:.2f} GiB < {min_free_root_gb:.2f} GiB")
    if art_gb < min_free_artifact_gb:
        reasons.append(f"artifact dir free {art_gb:.2f} GiB < {min_free_artifact_gb:.2f} GiB")

    snapshot = {
        "mem_available_mb": round(ram_mb, 1) if ram_mb is not None else None,
        "root_free_gb": round(root_gb, 2),
        "artifact_free_gb": round(art_gb, 2),
        "reasons": reasons,
    }
    return len(reasons) == 0, snapshot


class BackoffCoordinator:
    """Shared exponential backoff across concurrent worker threads when 429s occur."""

    def __init__(self, base_sec: float = 15.0, cap_sec: float = 60.0) -> None:
        self._lock = threading.Lock()
        self._base = base_sec
        self._cap = cap_sec
        self._streak = 0
        self._until = 0.0

    def wait_if_needed(self) -> None:
        while True:
            with self._lock:
                delay = self._until - time.monotonic()
            if delay <= 0:
                return
            time.sleep(min(delay, 2.0))

    def record_success(self) -> None:
        with self._lock:
            self._streak = 0

    def trigger_rate_limit(self) -> float:
        with self._lock:
            self._streak += 1
            raw = min(self._cap, self._base * (2 ** (self._streak - 1)))
            jitter = random.uniform(0.0, min(5.0, raw * 0.2))
            wait_s = round(raw + jitter, 2)
            target = time.monotonic() + wait_s
            if target > self._until:
                self._until = target
            return wait_s


class FleetStore:
    """Thread-safe SQLite WAL job queue and telemetry ledger."""

    def __init__(self, db_path: Path) -> None:
        self.db_path = Path(db_path)
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self._lock = threading.Lock()
        self._init_schema()

    def _connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(str(self.db_path), timeout=30.0, isolation_level=None)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA synchronous=NORMAL;")
        conn.execute("PRAGMA busy_timeout=15000;")
        return conn

    def _init_schema(self) -> None:
        with self._lock:
            conn = self._connect()
            try:
                conn.executescript(
                    """
                    CREATE TABLE IF NOT EXISTS campaigns (
                        id TEXT PRIMARY KEY,
                        name TEXT,
                        created_at TEXT,
                        config_json TEXT,
                        status TEXT
                    );
                    CREATE TABLE IF NOT EXISTS jobs (
                        id TEXT PRIMARY KEY,
                        campaign_id TEXT,
                        name TEXT,
                        stage TEXT,
                        action TEXT,
                        model TEXT,
                        cwd TEXT,
                        prompt_path TEXT,
                        verify_cmd TEXT,
                        confined INTEGER,
                        status TEXT,
                        attempts INTEGER,
                        max_attempts INTEGER,
                        priority INTEGER,
                        session_id TEXT,
                        resolved_model TEXT,
                        wall_s REAL,
                        api_ms INTEGER,
                        input_tokens INTEGER,
                        cache_read_tokens INTEGER,
                        cache_write_tokens INTEGER,
                        output_tokens INTEGER,
                        reasoning_tokens INTEGER,
                        stream_events INTEGER,
                        tool_calls INTEGER,
                        output_path TEXT,
                        stream_log_path TEXT,
                        patch_path TEXT,
                        receipt_path TEXT,
                        verify_exit_code INTEGER,
                        error TEXT,
                        started_at TEXT,
                        finished_at TEXT
                    );
                    CREATE INDEX IF NOT EXISTS idx_jobs_campaign_status
                        ON jobs(campaign_id, status, priority, id);
                    """
                )
            finally:
                conn.close()

    def ensure_campaign(self, campaign_id: str, name: str | None = None, config: dict | None = None) -> None:
        with self._lock:
            conn = self._connect()
            try:
                conn.execute(
                    """
                    INSERT OR IGNORE INTO campaigns(id, name, created_at, config_json, status)
                    VALUES (?, ?, ?, ?, ?)
                    """,
                    (
                        campaign_id,
                        name or campaign_id,
                        utc_now_iso(),
                        json.dumps(config or {}, sort_keys=True),
                        "queued",
                    ),
                )
            finally:
                conn.close()

    def set_campaign_status(self, campaign_id: str, status: str) -> None:
        with self._lock:
            conn = self._connect()
            try:
                conn.execute("UPDATE campaigns SET status = ? WHERE id = ?", (status, campaign_id))
            finally:
                conn.close()

    def enqueue_jobs(self, campaign_id: str, rows: list[dict[str, Any]]) -> tuple[int, int]:
        inserted = 0
        skipped = 0
        with self._lock:
            conn = self._connect()
            try:
                conn.execute("BEGIN")
                for row in rows:
                    cur = conn.execute(
                        """
                        INSERT OR IGNORE INTO jobs(
                            id, campaign_id, name, stage, action, model, cwd, prompt_path,
                            verify_cmd, confined, status, attempts, max_attempts, priority,
                            stream_events, tool_calls
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', 0, ?, ?, 0, 0)
                        """,
                        (
                            row["id"],
                            campaign_id,
                            row["name"],
                            row["stage"],
                            row["action"],
                            row["model"],
                            row["cwd"],
                            row["prompt_path"],
                            row["verify_cmd"],
                            int(row["confined"]),
                            int(row["max_attempts"]),
                            int(row["priority"]),
                        ),
                    )
                    if cur.rowcount > 0:
                        inserted += 1
                    else:
                        skipped += 1
                conn.execute("COMMIT")
            except Exception:
                conn.execute("ROLLBACK")
                raise
            finally:
                conn.close()
        return inserted, skipped

    def recover_stale_running(self, campaign_id: str) -> int:
        with self._lock:
            conn = self._connect()
            try:
                cur = conn.execute(
                    """
                    UPDATE jobs SET status = 'pending', error = COALESCE(error, '') || ' [recovered]'
                    WHERE campaign_id = ? AND status = 'running'
                    """,
                    (campaign_id,),
                )
                return cur.rowcount
            finally:
                conn.close()

    def reset_failed_to_pending(self, campaign_id: str) -> int:
        return self.reset_jobs(campaign_id, failed_only=True)

    def reset_jobs(
        self,
        campaign_id: str,
        *,
        failed_only: bool = True,
        job_ids: list[str] | None = None,
        new_model: str | None = None,
        max_attempts: int | None = None,
    ) -> int:
        sets = ["status = 'pending'", "attempts = 0", "error = NULL"]
        params: list[Any] = []
        if new_model:
            sets.append("model = ?")
            params.append(new_model)
        if max_attempts is not None:
            sets.append("max_attempts = ?")
            params.append(max(1, int(max_attempts)))
        wheres = ["campaign_id = ?"]
        params.append(campaign_id)
        if job_ids:
            placeholders = ", ".join("?" for _ in job_ids)
            wheres.append(f"id IN ({placeholders})")
            params.extend(job_ids)
        elif failed_only:
            wheres.append("status = 'failed'")
        else:
            wheres.append("status != 'done'")
        sql = f"UPDATE jobs SET {', '.join(sets)} WHERE {' AND '.join(wheres)}"
        with self._lock:
            conn = self._connect()
            try:
                cur = conn.execute(sql, params)
                return cur.rowcount
            finally:
                conn.close()

    def override_pending_model(self, campaign_id: str, new_model: str) -> int:
        with self._lock:
            conn = self._connect()
            try:
                cur = conn.execute(
                    "UPDATE jobs SET model = ? WHERE campaign_id = ? AND status = 'pending'",
                    (new_model, campaign_id),
                )
                return cur.rowcount
            finally:
                conn.close()

    def fetch_pending(self, campaign_id: str) -> list[dict[str, Any]]:
        with self._lock:
            conn = self._connect()
            try:
                cur = conn.execute(
                    """
                    SELECT * FROM jobs
                    WHERE campaign_id = ? AND status = 'pending'
                    ORDER BY priority DESC, id ASC
                    """,
                    (campaign_id,),
                )
                return [dict(r) for r in cur.fetchall()]
            finally:
                conn.close()

    def mark_running(self, job_id: str, attempt: int) -> None:
        with self._lock:
            conn = self._connect()
            try:
                conn.execute(
                    """
                    UPDATE jobs
                    SET status = 'running', attempts = ?, started_at = ?, error = NULL
                    WHERE id = ?
                    """,
                    (attempt, utc_now_iso(), job_id),
                )
            finally:
                conn.close()

    def update_job_result(self, job_id: str, fields: dict[str, Any]) -> None:
        if not fields:
            return
        cols = ", ".join(f"{k} = ?" for k in fields)
        vals = list(fields.values()) + [job_id]
        with self._lock:
            conn = self._connect()
            try:
                conn.execute(f"UPDATE jobs SET {cols} WHERE id = ?", vals)
            finally:
                conn.close()

    def campaign_summary(self, campaign_id: str | None = None) -> dict[str, Any]:
        with self._lock:
            conn = self._connect()
            try:
                if campaign_id:
                    camps = [
                        dict(r)
                        for r in conn.execute("SELECT * FROM campaigns WHERE id = ?", (campaign_id,)).fetchall()
                    ]
                    jobs = [
                        dict(r)
                        for r in conn.execute("SELECT * FROM jobs WHERE campaign_id = ?", (campaign_id,)).fetchall()
                    ]
                else:
                    camps = [
                        dict(r)
                        for r in conn.execute("SELECT * FROM campaigns ORDER BY created_at DESC").fetchall()
                    ]
                    jobs = [dict(r) for r in conn.execute("SELECT * FROM jobs").fetchall()]
            finally:
                conn.close()

        counts: dict[str, int] = {}
        wall_vals: list[float] = []
        tot_in = tot_cr = tot_cw = tot_out = tot_reason = tot_tools = 0
        est_actual_usd = 0.0
        for j in jobs:
            st = j.get("status") or "unknown"
            counts[st] = counts.get(st, 0) + 1
            if j.get("wall_s") is not None:
                wall_vals.append(float(j["wall_s"]))
            jin = int(j.get("input_tokens") or 0)
            jcr = int(j.get("cache_read_tokens") or 0)
            jcw = int(j.get("cache_write_tokens") or 0)
            jout = int(j.get("output_tokens") or 0)
            jrs = int(j.get("reasoning_tokens") or 0)
            tot_in += jin
            tot_cr += jcr
            tot_cw += jcw
            tot_out += jout
            tot_reason += jrs
            tot_tools += int(j.get("tool_calls") or 0)
            jm = str(j.get("resolved_model") or j.get("model") or "").lower()
            mult = 2.0 if jm.endswith("-fast") else 1.0
            est_actual_usd += mult * (jin * 2.0 + jcr * 0.2 + jout * 6.0) / 1_000_000.0

        denom_in = tot_in + tot_cr
        cache_hit_pct = round((100.0 * tot_cr / denom_in), 2) if denom_in > 0 else 0.0
        reasoning_pct = round((100.0 * tot_reason / tot_out), 2) if tot_out > 0 else 0.0
        # Reference Grok 4.7 $2/M input, $6/M output base rates (approximate 0.1x cache read)
        est_std_usd = round(
            (tot_in * 2.0 + tot_cr * 0.2 + tot_out * 6.0) / 1_000_000.0,
            6,
        )
        return {
            "campaigns": camps,
            "total_jobs": len(jobs),
            "counts": counts,
            "wall_s_sum": round(sum(wall_vals), 2),
            "wall_s_avg": round(sum(wall_vals) / len(wall_vals), 2) if wall_vals else 0.0,
            "total_tool_calls": tot_tools,
            "tokens": {
                "input": tot_in,
                "cache_read": tot_cr,
                "cache_write": tot_cw,
                "output": tot_out,
                "reasoning": tot_reason,
                "cache_hit_pct": cache_hit_pct,
                "reasoning_pct": reasoning_pct,
            },
            "est_standard_usd": est_std_usd,
            "est_actual_usd": round(est_actual_usd, 6),
            "est_fast_usd": round(est_std_usd * 2.0, 6),
            "est_cursor_quota_pct": round(est_std_usd / CURSOR_USD_PER_1PCT, 2),
        }

    def list_campaigns(self) -> list[dict[str, Any]]:
        with self._lock:
            conn = self._connect()
            try:
                camps = [
                    dict(r)
                    for r in conn.execute("SELECT * FROM campaigns ORDER BY created_at DESC").fetchall()
                ]
            finally:
                conn.close()
        out: list[dict[str, Any]] = []
        for c in camps:
            s = self.campaign_summary(c["id"])
            out.append(
                {
                    "id": c["id"],
                    "name": c.get("name") or c["id"],
                    "status": c.get("status") or "unknown",
                    "created_at": c.get("created_at"),
                    "total_jobs": s["total_jobs"],
                    "counts": s["counts"],
                    "total_tool_calls": s["total_tool_calls"],
                    "wall_s_sum": s["wall_s_sum"],
                    "est_standard_usd": s["est_standard_usd"],
                    "est_actual_usd": s["est_actual_usd"],
                    "est_cursor_quota_pct": s["est_cursor_quota_pct"],
                }
            )
        return out

    def export_campaign(self, campaign_id: str) -> dict[str, Any]:
        with self._lock:
            conn = self._connect()
            try:
                camp = conn.execute("SELECT * FROM campaigns WHERE id = ?", (campaign_id,)).fetchone()
                jobs = conn.execute(
                    "SELECT * FROM jobs WHERE campaign_id = ? ORDER BY priority DESC, id ASC",
                    (campaign_id,),
                ).fetchall()
            finally:
                conn.close()
        return {
            "campaign": dict(camp) if camp else None,
            "summary": self.campaign_summary(campaign_id),
            "jobs": [dict(r) for r in jobs],
        }


def _kill_process_group(proc: subprocess.Popen[bytes]) -> None:
    try:
        pgid = os.getpgid(proc.pid)
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass


def _locate_worktree(repo_root: Path, wt_name: str) -> Path | None:
    cand = Path.home() / ".cursor" / "worktrees" / repo_root.name / wt_name
    if cand.is_dir():
        return cand
    proc = subprocess.run(
        ["git", "-C", str(repo_root), "worktree", "list", "--porcelain"],
        capture_output=True,
        text=True,
    )
    if proc.returncode == 0:
        for line in proc.stdout.splitlines():
            if line.startswith("worktree "):
                p = Path(line.split(" ", 1)[1].strip())
                if p.name == wt_name and p.is_dir():
                    return p
    return None


def _harvest_patch(wt_path: Path, patch_dest: Path) -> None:
    """Capture full modified + untracked diff cleanly into patch_dest."""
    patch_dest.parent.mkdir(parents=True, exist_ok=True)
    # Stage intent-to-add on untracked non-cache files so `git diff HEAD` includes new files cleanly
    st = subprocess.run(
        ["git", "-C", str(wt_path), "status", "--porcelain", "-uall"],
        capture_output=True,
        text=True,
    )
    if st.returncode == 0:
        untracked: list[str] = []
        for line in st.stdout.splitlines():
            if line.startswith("?? "):
                rel = line[3:].strip().strip('"')
                if "__pycache__/" in rel or rel.endswith(".pyc"):
                    continue
                untracked.append(rel)
        if untracked:
            subprocess.run(
                ["git", "-C", str(wt_path), "add", "-N", "--"] + untracked,
                capture_output=True,
                text=True,
            )
    diff_proc = subprocess.run(
        ["git", "-C", str(wt_path), "diff", "HEAD"],
        capture_output=True,
        text=True,
    )
    patch_dest.write_text(diff_proc.stdout or "", encoding="utf-8", errors="replace")


def _prune_single_worktree(repo_root: Path, wt_path: Path | None) -> None:
    if wt_path is not None:
        subprocess.run(
            ["git", "-C", str(repo_root), "worktree", "remove", "--force", str(wt_path)],
            capture_output=True,
            text=True,
        )
        shutil.rmtree(wt_path, ignore_errors=True)
        # Remove empty parent repo dir under ~/.cursor/worktrees/<repo>
        parent = wt_path.parent
        try:
            if parent.is_dir() and not any(parent.iterdir()):
                parent.rmdir()
        except OSError:
            pass
    subprocess.run(
        ["git", "-C", str(repo_root), "worktree", "prune"],
        capture_output=True,
        text=True,
    )


def exec_stream_worker(
    job: dict[str, Any],
    attempt: int,
    cursor_bin: str,
    artifact_dir: Path,
    stall_timeout_sec: int,
    wall_timeout_sec: int,
    *,
    streaming_grace_sec: int = 60,
    empty_cwd: bool = False,
    no_tools_guard: bool = False,
    max_tool_calls: int = -1,
    retry_wall_timeouts: bool = False,
    allow_any_model: bool = False,
) -> dict[str, Any]:
    cid = job["campaign_id"]
    jid = job["id"]
    action = job["action"]
    cwd = job["cwd"]
    prompt = Path(job["prompt_path"]).read_text(encoding="utf-8")
    resolved_req_model = resolve_fleet_model(job.get("model"), allow_any_model=allow_any_model)

    camp_art = artifact_dir / "campaigns" / sanitize_id(cid, 64)
    stream_log_path = camp_art / "streams" / f"{sanitize_id(jid, 64)}.ndjson"
    output_path = camp_art / "outputs" / f"{sanitize_id(jid, 64)}.txt"
    stream_log_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    repo_root: Path | None = None
    wt_name = ""
    if action == "worktree":
        git_chk = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
        )
        if git_chk.returncode != 0:
            return {
                "ok": False,
                "retryable": False,
                "error": f"worktree action requires a git repo cwd (got {cwd})",
                "wall_s": 0.0,
            }
        repo_root = Path(git_chk.stdout.strip())
        wt_name = sanitize_id(f"flt-{jid}-a{attempt}", 40)

    ws_override: str | None = None
    if empty_cwd and action in ("ask", "plan"):
        empty_dir = artifact_dir / "_empty_cwd"
        empty_dir.mkdir(parents=True, exist_ok=True)
        cwd = str(empty_dir)
        ws_override = cwd
    if no_tools_guard and action == "ask" and not prompt.startswith("PURE SYNTHESIS MODE:"):
        prompt = NO_TOOLS_BANNER + prompt

    cmd = [cursor_bin, "-p", "--output-format", "stream-json", "--model", resolved_req_model]
    if action == "ask":
        cmd.extend(["--mode=ask", "--trust"])
    elif action == "plan":
        cmd.extend(["--mode=plan", "--trust"])
    elif action == "worktree":
        cmd.extend(["-w", wt_name, "--skip-worktree-setup", "--force", "--trust"])
    else:
        return {"ok": False, "retryable": False, "error": f"invalid action: {action}", "wall_s": 0.0}
    if ws_override is not None:
        cmd.extend(["--workspace", ws_override])
    cmd.append(prompt)

    t0 = time.monotonic()
    last_event_ts = t0
    thinking_done_ts = 0.0
    last_output_ts = 0.0
    grace_notified = False
    grace_used_s = 0.0
    stderr_chunks: list[str] = []
    session_id: str | None = None
    actual_model: str = resolved_req_model
    api_ms: int | None = None
    usage: dict[str, Any] = {}
    result_text: str | None = None
    assistant_chunks: list[str] = []
    is_error = False
    stream_events = 0
    tool_calls = 0
    tool_exceeded = False
    timeout_reason: str | None = None

    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        bufsize=0,
        start_new_session=True,
    )

    def _drain_stderr() -> None:
        assert proc.stderr is not None
        dec = codecs.getincrementaldecoder("utf-8")("replace")
        while True:
            chunk = proc.stderr.read(8192)
            if not chunk:
                tail = dec.decode(b"", final=True)
                if tail:
                    stderr_chunks.append(tail)
                break
            stderr_chunks.append(dec.decode(chunk, final=False))

    stderr_thread = threading.Thread(target=_drain_stderr, daemon=True)
    stderr_thread.start()

    assert proc.stdout is not None
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout.fileno(), selectors.EVENT_READ)
    dec = codecs.getincrementaldecoder("utf-8")("replace")
    pending_buf = ""

    def _process_line(raw_line: str, log_fp: Any) -> None:
        nonlocal session_id, actual_model, api_ms, usage, result_text, is_error
        nonlocal stream_events, tool_calls, tool_exceeded, last_event_ts
        nonlocal thinking_done_ts, last_output_ts
        line = raw_line.strip()
        if not line:
            return
        log_fp.write(line + "\n")
        log_fp.flush()
        stream_events += 1
        now_ev = time.monotonic()
        last_event_ts = now_ev
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            return
        if not isinstance(obj, dict):
            return
        etype = obj.get("type")
        subtype = obj.get("subtype")
        if obj.get("session_id") and not session_id:
            session_id = str(obj["session_id"])
        if etype == "system" and subtype == "init":
            if obj.get("model"):
                actual_model = str(obj["model"])
        elif etype == "thinking" and subtype == "completed":
            thinking_done_ts = now_ev
        elif etype == "tool_call":
            if subtype != "completed":
                tool_calls += 1
                if max_tool_calls >= 0 and tool_calls > max_tool_calls:
                    tool_exceeded = True
        elif etype == "assistant":
            msg = obj.get("message") or {}
            for block in msg.get("content") or []:
                if isinstance(block, dict) and block.get("type") == "text" and block.get("text"):
                    assistant_chunks.append(str(block["text"]))
                    last_output_ts = now_ev
        elif etype == "result":
            is_error = bool(obj.get("is_error"))
            if obj.get("duration_api_ms") is not None:
                api_ms = int(obj["duration_api_ms"])
            if isinstance(obj.get("usage"), dict):
                usage = obj["usage"]
            if obj.get("result") is not None:
                result_text = str(obj["result"])

    try:
        with open(stream_log_path, "w", encoding="utf-8") as log_fp:
            eof = False
            while not eof:
                now = time.monotonic()
                if tool_exceeded:
                    timeout_reason = f"tool budget exceeded ({tool_calls} > {max_tool_calls})"
                    _kill_process_group(proc)
                    break
                elapsed = now - t0
                if elapsed >= wall_timeout_sec:
                    # Streaming grace window: never kill a worker mid-answer right after thinking finished!
                    streaming_active = (
                        streaming_grace_sec > 0
                        and (last_output_ts > 0.0 or thinking_done_ts > 0.0)
                        and (now - max(last_output_ts, thinking_done_ts, last_event_ts)) <= 15.0
                        and elapsed < (wall_timeout_sec + streaming_grace_sec)
                    )
                    if streaming_active:
                        if not grace_notified:
                            grace_notified = True
                            print(
                                f"[grace] job={jid} streaming active at {wall_timeout_sec}s; extending up to +{streaming_grace_sec}s",
                                file=sys.stderr,
                                flush=True,
                            )
                        grace_used_s = round(elapsed - wall_timeout_sec, 2)
                    else:
                        timeout_reason = (
                            f"wall timeout after {int(round(elapsed))}s (+{streaming_grace_sec}s grace)"
                            if grace_notified
                            else f"wall timeout after {wall_timeout_sec}s"
                        )
                        _kill_process_group(proc)
                        break
                if now - last_event_ts >= stall_timeout_sec:
                    timeout_reason = f"stream stall timeout after {stall_timeout_sec}s"
                    _kill_process_group(proc)
                    break

                events = sel.select(timeout=1.0)
                if not events:
                    if proc.poll() is not None:
                        # Process exited; check once briefly for trailing bytes without blocking
                        if not sel.select(timeout=0.05):
                            eof = True
                    continue

                for key, _ in events:
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        eof = True
                        break
                    pending_buf += dec.decode(chunk, final=False)
                    while "\n" in pending_buf:
                        line, pending_buf = pending_buf.split("\n", 1)
                        _process_line(line, log_fp)
                        if tool_exceeded:
                            break
                    if tool_exceeded:
                        timeout_reason = f"tool budget exceeded ({tool_calls} > {max_tool_calls})"
                        _kill_process_group(proc)
                        eof = True
                        break

            pending_buf += dec.decode(b"", final=True)
            if pending_buf.strip():
                for tail_line in pending_buf.splitlines():
                    _process_line(tail_line, log_fp)
    finally:
        try:
            sel.close()
        except Exception:
            pass
        try:
            proc.stdout.close()
        except Exception:
            pass
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            _kill_process_group(proc)
            proc.wait(timeout=5)
        stderr_thread.join(timeout=3)

    wall_s = round(time.monotonic() - t0, 2)
    stderr_str = "".join(stderr_chunks).strip()
    final_text = result_text if result_text is not None else "".join(assistant_chunks)
    output_path.write_text(final_text or "", encoding="utf-8")

    err_msg: str | None = timeout_reason
    if err_msg is None and (proc.returncode != 0 or is_error):
        err_msg = (stderr_str or final_text or f"exit {proc.returncode}")[:400]

    ok = (timeout_reason is None) and (proc.returncode == 0) and (not is_error)
    combined_err = (err_msg or "") + "\n" + stderr_str + "\n" + (final_text or "")[:500]
    quota_exhausted = (not ok) and bool(QUOTA_EXHAUSTED_RE.search(combined_err))
    rate_limited = (not ok) and (not quota_exhausted) and bool(
        err_msg and RATE_LIMIT_RE.search(err_msg + "\n" + stderr_str)
    )

    patch_path_str: str | None = None
    receipt_path_str: str | None = None
    verify_exit_code: int | None = None

    if action == "worktree" and repo_root is not None and wt_name:
        wt_path = _locate_worktree(repo_root, wt_name)
        try:
            if wt_path is not None and wt_path.is_dir():
                patch_dest = camp_art / "patches" / f"{sanitize_id(jid, 64)}.patch"
                _harvest_patch(wt_path, patch_dest)
                patch_path_str = str(patch_dest)

                if bool(job.get("confined")):
                    vcmd = str(job.get("verify_cmd") or "git status --short")
                    swarm_mod = _load_swarm_module()
                    vres = swarm_mod.run_confined_verify(
                        wt_path,
                        vcmd,
                        min(90, wall_timeout_sec),
                    )
                    rcpt = vres.get("confinement_receipt") or {}
                    rcpt_dest = camp_art / "receipts" / f"{sanitize_id(jid, 64)}.json"
                    rcpt_dest.parent.mkdir(parents=True, exist_ok=True)
                    rcpt_dest.write_text(json.dumps(rcpt, indent=2), encoding="utf-8")
                    receipt_path_str = str(rcpt_dest)
                    raw_vcode = rcpt.get("verify_exit_code")
                    verify_exit_code = int(raw_vcode) if raw_vcode is not None else -1
                    if not vres.get("ok"):
                        ok = False
                        v_err = vres.get("error") or f"confined verify exit={verify_exit_code}"
                        err_msg = f"{err_msg}; {v_err}" if err_msg else v_err
                elif job.get("verify_cmd"):
                    vcmd = str(job["verify_cmd"])
                    v_timeout = min(90, max(5, int(wall_timeout_sec or 90)))
                    verify_exit_code, v_out_full, v_err_full, v_exc = _run_shell_bounded(vcmd, wt_path, v_timeout)
                    if verify_exit_code != 0:
                        ok = False
                        v_err = v_exc or f"verify_cmd failed (exit={verify_exit_code})"
                        err_msg = f"{err_msg}; {v_err}" if err_msg else v_err
                    rcpt = {
                        "receipt_version": "wm-worktree-verify/1.0",
                        "issued_at_utc": utc_now_iso(),
                        "scope_confined": False,
                        "worktree_path": str(wt_path),
                        "verify_cmd_sha256": hashlib.sha256(vcmd.encode("utf-8")).hexdigest(),
                        "verify_exit_code": verify_exit_code,
                        "verify_stdout_tail": v_out_full[-4000:],
                        "verify_stderr_tail": v_err_full[-2000:],
                    }
                    rcpt_dest = camp_art / "receipts" / f"{sanitize_id(jid, 64)}.json"
                    try:
                        _write_json_atomic(rcpt_dest, rcpt)
                        receipt_path_str = str(rcpt_dest)
                    except OSError as exc:
                        ok = False
                        err_msg = f"{err_msg}; receipt write failed: {exc}" if err_msg else f"receipt write failed: {exc}"
            elif ok:
                ok = False
                err_msg = f"worktree directory missing after run: {wt_name}"
        finally:
            try:
                _prune_single_worktree(repo_root, wt_path)
            except Exception:
                pass

    is_stall = bool(timeout_reason and "stream stall" in timeout_reason)
    is_wall = bool(timeout_reason and "wall timeout" in timeout_reason)
    is_action_req = "ActionRequiredError" in combined_err
    retryable = bool((not quota_exhausted) and (not is_action_req) and (rate_limited or is_stall or (is_wall and retry_wall_timeouts)))
    return {
        "ok": ok,
        "retryable": retryable,
        "wall_timed_out": is_wall,
        "grace_used_s": grace_used_s,
        "rate_limited": rate_limited,
        "quota_exhausted": quota_exhausted,
        "session_id": session_id,
        "resolved_model": actual_model,
        "wall_s": wall_s,
        "api_ms": api_ms,
        "input_tokens": int(usage.get("inputTokens") or 0),
        "cache_read_tokens": int(usage.get("cacheReadTokens") or 0),
        "cache_write_tokens": int(usage.get("cacheWriteTokens") or 0),
        "output_tokens": int(usage.get("outputTokens") or 0),
        "reasoning_tokens": int(usage.get("reasoningTokens") or 0),
        "stream_events": stream_events,
        "tool_calls": tool_calls,
        "output_path": str(output_path),
        "stream_log_path": str(stream_log_path),
        "patch_path": patch_path_str,
        "receipt_path": receipt_path_str,
        "verify_exit_code": verify_exit_code,
        "error": err_msg,
    }


def cmd_enqueue(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    manifest_path = Path(args.manifest)
    if not manifest_path.is_file():
        print(json.dumps({"ok": False, "error": f"manifest not found: {manifest_path}"}))
        return 1

    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64)
    store.ensure_campaign(cid, name=args.name or cid, config={"manifest": str(manifest_path)})

    prompts_dir = art_dir / "campaigns" / cid / "prompts"
    prompts_dir.mkdir(parents=True, exist_ok=True)

    camp_exclusions = (
        _load_exclusions_file(Path(args.exclusions_file))
        if getattr(args, "exclusions_file", None)
        else []
    )
    camp_forbidden = [str(x).strip() for x in (getattr(args, "forbidden", None) or []) if str(x).strip()]
    camp_trajectories = (
        _load_trajectories_jsonl(
            Path(args.trajectories_file),
            max_items=int(getattr(args, "max_trajectories", 3) or 3),
        )
        if getattr(args, "trajectories_file", None)
        else []
    )

    rows: list[dict[str, Any]] = []
    for idx, raw_line in enumerate(manifest_path.read_text(encoding="utf-8").splitlines()):
        line = raw_line.strip()
        if not line:
            continue
        item = json.loads(line)
        action = str(item.get("action") or "ask").strip().lower()
        if action not in ("ask", "plan", "worktree"):
            raise ValueError(f"Line {idx + 1}: invalid action '{action}'")
        model = resolve_fleet_model(
            item.get("model"),
            allow_any_model=bool(getattr(args, "allow_any_model", False)),
        )
        name = str(item.get("name") or f"job-{idx + 1}")
        stage = str(item.get("stage") or "default")
        cwd = str(item.get("cwd") or os.getcwd())
        raw_id = item.get("id")
        if raw_id:
            jid = sanitize_id(str(raw_id), 64)
        else:
            digest = hashlib.sha256(f"{cid}:{idx}:{stage}:{name}".encode("utf-8")).hexdigest()[:10]
            jid = sanitize_id(f"{stage}-{name}-{digest}", 64)

        item_excl = item.get("intended_design_exclusions")
        if isinstance(item_excl, str):
            merged_excl = camp_exclusions + [x.strip() for x in item_excl.splitlines() if x.strip()]
        else:
            merged_excl = camp_exclusions + [str(x).strip() for x in (item_excl or []) if str(x).strip()]
        merged_forb = camp_forbidden + [str(x).strip() for x in (item.get("forbidden") or []) if str(x).strip()]
        item_traj = [t for t in (item.get("winning_trajectories") or []) if isinstance(t, dict)]
        merged_traj = camp_trajectories + item_traj
        has_hardening = bool(merged_excl or merged_forb or merged_traj)

        if item.get("prompt_path"):
            p_path = Path(str(item["prompt_path"]))
            if not p_path.is_file():
                raise FileNotFoundError(f"Line {idx + 1}: prompt_path missing: {p_path}")
            if has_hardening:
                composed = compose_worker_prompt(
                    p_path.read_text(encoding="utf-8"),
                    intended_design_exclusions=merged_excl,
                    forbidden_actions=merged_forb,
                    winning_trajectories=merged_traj,
                )
                p_file = prompts_dir / f"{jid}.txt"
                p_file.write_text(composed, encoding="utf-8")
                prompt_path_str = str(p_file)
            else:
                prompt_path_str = str(p_path)
        else:
            prompt_text = str(item.get("prompt") or "")
            if not prompt_text.strip():
                raise ValueError(f"Line {idx + 1}: prompt or prompt_path required")
            composed = compose_worker_prompt(
                prompt_text,
                intended_design_exclusions=merged_excl,
                forbidden_actions=merged_forb,
                winning_trajectories=merged_traj,
            )
            p_file = prompts_dir / f"{jid}.txt"
            p_file.write_text(composed, encoding="utf-8")
            prompt_path_str = str(p_file)

        rows.append(
            {
                "id": jid,
                "name": name,
                "stage": stage,
                "action": action,
                "model": model,
                "cwd": cwd,
                "prompt_path": prompt_path_str,
                "verify_cmd": item.get("verify_cmd"),
                "confined": 1 if item.get("confined") else 0,
                "max_attempts": max(1, int(item.get("max_attempts") or 3)),
                "priority": int(item.get("priority") or 0),
            }
        )

    inserted, skipped = store.enqueue_jobs(cid, rows)
    print(
        json.dumps(
            {
                "ok": True,
                "campaign_id": cid,
                "db_path": str(db_path),
                "artifact_dir": str(art_dir),
                "inserted": inserted,
                "skipped_existing": skipped,
            },
            indent=2,
        )
    )
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    cursor_bin = find_cursor_agent(args.cursor_bin)
    if not cursor_bin:
        print(json.dumps({"ok": False, "error": "cursor-agent binary not found"}))
        return 1

    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    art_dir.mkdir(parents=True, exist_ok=True)
    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64)
    store.recover_stale_running(cid)
    if getattr(args, "retry_failed", False):
        store.reset_failed_to_pending(cid)
    allow_any_model = bool(getattr(args, "allow_any_model", False))
    run_model_override = getattr(args, "model", None)
    if run_model_override:
        resolved_override = resolve_fleet_model(run_model_override, allow_any_model=allow_any_model)
        store.override_pending_model(cid, resolved_override)
    store.set_campaign_status(cid, "running")

    preset_name = getattr(args, "preset", None)
    preset_cfg = FLEET_PRESETS.get(str(preset_name).strip().lower(), {}) if preset_name else {}
    read_conc = max(
        1,
        min(
            24,
            int(
                args.read_concurrency
                if args.read_concurrency is not None
                else preset_cfg.get("read_concurrency", 8)
            ),
        ),
    )
    write_conc = max(
        1,
        min(
            6,
            int(
                args.write_concurrency
                if args.write_concurrency is not None
                else preset_cfg.get("write_concurrency", 3)
            ),
        ),
    )
    stall_timeout = int(
        args.stall_timeout if args.stall_timeout is not None else preset_cfg.get("stall_timeout", 75)
    )
    wall_timeout = int(
        args.wall_timeout if args.wall_timeout is not None else preset_cfg.get("wall_timeout", 300)
    )
    raw_sg = getattr(args, "streaming_grace", None)
    streaming_grace = max(
        0,
        int(raw_sg if raw_sg is not None else preset_cfg.get("streaming_grace", 60)),
    )
    timeout_fallback_model = getattr(args, "timeout_fallback_model", None) or preset_cfg.get("timeout_fallback_model")
    read_sem = threading.Semaphore(read_conc)
    write_sem = threading.Semaphore(write_conc)
    backoff = BackoffCoordinator()
    health_lock = threading.Lock()
    budget_lock = threading.Lock()
    checkpoint_lock = threading.Lock()
    progress_lock = threading.Lock()
    budget_capped = threading.Event()
    quota_halted = threading.Event()
    stop_requested = threading.Event()
    max_usd = float(getattr(args, "max_usd", 0.0) or 0.0)
    empty_cwd = bool(getattr(args, "empty_cwd", False)) or bool(preset_cfg.get("empty_cwd", False))
    no_tools_guard = bool(getattr(args, "no_tools_guard", False)) or bool(preset_cfg.get("no_tools_guard", False))
    raw_mtc = getattr(args, "max_tool_calls", None)
    max_tool_calls = int(raw_mtc) if raw_mtc is not None else int(preset_cfg.get("max_tool_calls", -1))
    retry_wall_timeouts = bool(getattr(args, "retry_wall_timeouts", False))
    quiet = bool(getattr(args, "quiet", False))
    suppress_stdout = bool(getattr(args, "_suppress_stdout", False))
    raw_cp = getattr(args, "checkpoint_path", None)
    raw_cjl = getattr(args, "checkpoint_jsonl", None)
    checkpoint_path = Path(raw_cp) if raw_cp else None
    checkpoint_jsonl = Path(raw_cjl) if raw_cjl else None
    session_completed = 0
    t_run_start = time.monotonic()

    def _emit_progress(job_id: str, status_tag: str, res: dict[str, Any]) -> None:
        nonlocal session_completed
        if quiet:
            return
        with progress_lock:
            session_completed += 1
            snap = store.campaign_summary(cid)
            cnt = snap.get("counts") or {}
            done_n = int(cnt.get("done", 0))
            fail_n = int(cnt.get("failed", 0))
            tot_n = int(snap.get("total_jobs", 0))
            usd = float(snap.get("est_actual_usd", snap.get("est_standard_usd", 0.0)))
            qpct = float(snap.get("est_cursor_quota_pct", 0.0))
            toks = snap.get("tokens") or {}
            r_pct = float(toks.get("reasoning_pct", 0.0))
            wall_s = res.get("wall_s", 0.0)
            tools = res.get("tool_calls", 0)
            extra = ""
            if int(toks.get("output", 0)) > 0:
                extra += f" | reason={r_pct:.0f}%"
            rem_n = max(0, tot_n - done_n - fail_n)
            elapsed_run = time.monotonic() - t_run_start
            if session_completed >= 2 and rem_n > 0 and elapsed_run >= 3.0:
                eta_s = int(round((elapsed_run / session_completed) * rem_n))
                eta_str = f"{eta_s // 60}m{eta_s % 60:02d}s" if eta_s >= 60 else f"{eta_s}s"
                extra += f" | eta ~{eta_str}"
            print(
                f"[fleet] {done_n}/{tot_n} done ({fail_n} fail) | {status_tag} {job_id} | "
                f"{wall_s}s | {tools} tools | ${usd:.4f} (~{qpct:.2f}% quota){extra}",
                file=sys.stderr,
                flush=True,
            )

    def _write_checkpoint(done_job: dict[str, Any] | None = None) -> None:
        if checkpoint_jsonl is None and checkpoint_path is None:
            return
        with checkpoint_lock:
            if checkpoint_jsonl is not None and done_job is not None:
                checkpoint_jsonl.parent.mkdir(parents=True, exist_ok=True)
                with checkpoint_jsonl.open("a", encoding="utf-8") as fp:
                    fp.write(json.dumps(done_job, ensure_ascii=False) + "\n")
                    fp.flush()
                    os.fsync(fp.fileno())
            if checkpoint_path is not None:
                checkpoint_path.parent.mkdir(parents=True, exist_ok=True)
                snap = store.export_campaign(cid)
                tmp_p = checkpoint_path.with_name(f".{checkpoint_path.name}.tmp.{os.getpid()}")
                with tmp_p.open("w", encoding="utf-8") as fp:
                    json.dump(snap, fp, indent=2)
                    fp.flush()
                    os.fsync(fp.fileno())
                os.replace(tmp_p, checkpoint_path)

    def _budget_exceeded() -> bool:
        if max_usd <= 0.0:
            return False
        if budget_capped.is_set():
            return True
        with budget_lock:
            if budget_capped.is_set():
                return True
            cur_usd = float(store.campaign_summary(cid).get("est_standard_usd", 0.0))
            if cur_usd >= max_usd:
                budget_capped.set()
                print(
                    f"[budget] max_usd reached (${cur_usd:.4f} >= ${max_usd:.4f}); halting remaining spawns",
                    file=sys.stderr,
                )
                return True
        return False

    def _halt_requested() -> bool:
        return (
            budget_capped.is_set()
            or quota_halted.is_set()
            or stop_requested.is_set()
            or _budget_exceeded()
        )

    def _run_job_with_retries(job: dict[str, Any]) -> None:
        sem = write_sem if job["action"] == "worktree" else read_sem
        max_att = max(1, min(int(job.get("max_attempts") or 3), int(args.max_retries) + 1))
        job_run = dict(job)
        cur_wall_timeout = wall_timeout

        for attempt in range(1, max_att + 1):
            if _halt_requested():
                return
            backoff.wait_if_needed()
            with health_lock:
                waited = 0
                while waited < 60 and not _halt_requested():
                    healthy, snap = check_host_health(
                        min_free_ram_mb=args.min_free_ram_mb,
                        min_free_root_gb=args.min_free_root_gb,
                        artifact_dir=art_dir,
                    )
                    if healthy:
                        break
                    print(
                        f"[governor] pausing spawn ({'; '.join(snap['reasons'])})",
                        file=sys.stderr,
                    )
                    time.sleep(3)
                    waited += 3

            if _halt_requested():
                return

            with sem:
                if _halt_requested():
                    return
                store.mark_running(job_run["id"], attempt)
                res = exec_stream_worker(
                    job=job_run,
                    attempt=attempt,
                    cursor_bin=cursor_bin,
                    artifact_dir=art_dir,
                    stall_timeout_sec=stall_timeout,
                    wall_timeout_sec=cur_wall_timeout,
                    streaming_grace_sec=streaming_grace,
                    empty_cwd=empty_cwd,
                    no_tools_guard=no_tools_guard,
                    max_tool_calls=max_tool_calls,
                    retry_wall_timeouts=retry_wall_timeouts,
                    allow_any_model=allow_any_model,
                )

            if res["ok"]:
                backoff.record_success()
                fin_iso = utc_now_iso()
                store.update_job_result(
                    job_run["id"],
                    {
                        "status": "done",
                        "model": job_run.get("model"),
                        "session_id": res.get("session_id"),
                        "resolved_model": res.get("resolved_model"),
                        "wall_s": res.get("wall_s"),
                        "api_ms": res.get("api_ms"),
                        "input_tokens": res.get("input_tokens", 0),
                        "cache_read_tokens": res.get("cache_read_tokens", 0),
                        "cache_write_tokens": res.get("cache_write_tokens", 0),
                        "output_tokens": res.get("output_tokens", 0),
                        "reasoning_tokens": res.get("reasoning_tokens", 0),
                        "stream_events": res.get("stream_events", 0),
                        "tool_calls": res.get("tool_calls", 0),
                        "output_path": res.get("output_path"),
                        "stream_log_path": res.get("stream_log_path"),
                        "patch_path": res.get("patch_path"),
                        "receipt_path": res.get("receipt_path"),
                        "verify_exit_code": res.get("verify_exit_code"),
                        "error": None,
                        "finished_at": fin_iso,
                    },
                )
                _write_checkpoint({
                    "job_id": job_run["id"],
                    "stage": job_run.get("stage"),
                    "model": res.get("resolved_model") or job_run.get("model"),
                    "wall_s": res.get("wall_s"),
                    "output_path": res.get("output_path"),
                    "input_tokens": res.get("input_tokens", 0),
                    "cache_read_tokens": res.get("cache_read_tokens", 0),
                    "output_tokens": res.get("output_tokens", 0),
                    "reasoning_tokens": res.get("reasoning_tokens", 0),
                    "tool_calls": res.get("tool_calls", 0),
                    "finished_at": fin_iso,
                })
                _emit_progress(job_run["id"], "OK", res)
                return

            if res.get("quota_exhausted"):
                quota_halted.set()
                store.update_job_result(
                    job_run["id"],
                    {
                        "status": "pending",
                        "wall_s": res.get("wall_s"),
                        "error": f"quota_paused: {res.get('error')}",
                        "finished_at": None,
                    },
                )
                _write_checkpoint(None)
                print(
                    "[quota] quota exhaustion detected; pausing remaining spawns cleanly",
                    file=sys.stderr,
                )
                return

            if res.get("rate_limited"):
                wait_s = backoff.trigger_rate_limit()
                print(
                    f"[429] job={job_run['id']} attempt={attempt}/{max_att}; shared backoff {wait_s}s",
                    file=sys.stderr,
                )

            if res.get("wall_timed_out") and timeout_fallback_model and attempt < max_att and not _halt_requested():
                nxt_model = step_down_timeout_model(
                    str(job_run.get("model") or "medium"),
                    str(timeout_fallback_model),
                    allow_any_model=allow_any_model,
                )
                if nxt_model:
                    prev_model = job_run.get("model")
                    job_run["model"] = nxt_model
                    cur_wall_timeout = max(cur_wall_timeout + 1, int(round(cur_wall_timeout * 1.25)))
                    print(
                        f"[fallback] job={job_run['id']} wall timeout on {prev_model}; "
                        f"retrying attempt {attempt + 1}/{max_att} on {nxt_model} (wall_timeout={cur_wall_timeout}s)",
                        file=sys.stderr,
                        flush=True,
                    )
                    continue

            if res.get("retryable") and attempt < max_att and not _halt_requested():
                continue

            store.update_job_result(
                job_run["id"],
                {
                    "status": "failed",
                    "model": job_run.get("model"),
                    "session_id": res.get("session_id"),
                    "resolved_model": res.get("resolved_model"),
                    "wall_s": res.get("wall_s"),
                    "api_ms": res.get("api_ms"),
                    "input_tokens": res.get("input_tokens", 0),
                    "cache_read_tokens": res.get("cache_read_tokens", 0),
                    "cache_write_tokens": res.get("cache_write_tokens", 0),
                    "output_tokens": res.get("output_tokens", 0),
                    "reasoning_tokens": res.get("reasoning_tokens", 0),
                    "stream_events": res.get("stream_events", 0),
                    "tool_calls": res.get("tool_calls", 0),
                    "output_path": res.get("output_path"),
                    "stream_log_path": res.get("stream_log_path"),
                    "patch_path": res.get("patch_path"),
                    "receipt_path": res.get("receipt_path"),
                    "verify_exit_code": res.get("verify_exit_code"),
                    "error": res.get("error"),
                    "finished_at": utc_now_iso(),
                },
            )
            _write_checkpoint(None)
            _emit_progress(job_run["id"], "FAIL", res)
            return

    pending = store.fetch_pending(cid)
    t_wall0 = time.monotonic()

    def _on_stop_signal(_signum: int, _frame: Any) -> None:
        stop_requested.set()
        print(
            "[signal] graceful drain requested; finishing in-flight workers and checkpointing",
            file=sys.stderr,
        )

    is_main = threading.current_thread() is threading.main_thread()
    old_sigint = signal.getsignal(signal.SIGINT) if is_main else None
    old_sigterm = signal.getsignal(signal.SIGTERM) if is_main else None
    try:
        if is_main:
            signal.signal(signal.SIGINT, _on_stop_signal)
            signal.signal(signal.SIGTERM, _on_stop_signal)
        if pending:
            max_pool = min(len(pending), read_conc + write_conc)
            with concurrent.futures.ThreadPoolExecutor(max_workers=max_pool) as pool:
                futs = [pool.submit(_run_job_with_retries, j) for j in pending]
                for fut in concurrent.futures.as_completed(futs):
                    fut.result()
    finally:
        if is_main:
            if old_sigint is not None:
                signal.signal(signal.SIGINT, old_sigint)
            if old_sigterm is not None:
                signal.signal(signal.SIGTERM, old_sigterm)

    _write_checkpoint(None)
    summary = store.campaign_summary(cid)
    failed_cnt = summary["counts"].get("failed", 0)
    capped = budget_capped.is_set()
    q_halted = quota_halted.is_set()
    interrupted = stop_requested.is_set()
    if q_halted:
        store.set_campaign_status(cid, "quota_paused")
    elif interrupted:
        store.set_campaign_status(cid, "interrupted")
    elif capped:
        store.set_campaign_status(cid, "budget_capped")
    else:
        store.set_campaign_status(cid, "completed" if failed_cnt == 0 else "completed_with_failures")
    summary["campaign_wall_s"] = round(time.monotonic() - t_wall0, 2)
    summary["budget_capped"] = capped
    summary["quota_halted"] = q_halted
    summary["interrupted"] = interrupted
    summary["resumable_pending"] = summary["counts"].get("pending", 0)

    hints: list[str] = []
    done_cnt = int(summary["counts"].get("done", 0))
    tok_meta = summary.get("tokens") or {}
    r_pct_final = float(tok_meta.get("reasoning_pct", 0.0))
    if done_cnt >= 3 and r_pct_final >= 65.0 and float(summary.get("wall_s_avg", 0.0)) >= 120.0:
        hints.append(
            f"High reasoning overhead ({r_pct_final:.1f}% of output tokens, avg {summary['wall_s_avg']:.0f}s/worker). "
            f"For bulk JSON/code generation, try `--preset dataset` (grok-4.7-low) or "
            f"`cursor-fleet retry --campaign {cid} --non-done --model low --run`."
        )
    if failed_cnt > 0:
        camp_jobs = store.export_campaign(cid).get("jobs") or []
        wt_fails = [j for j in camp_jobs if j.get("status") == "failed" and "wall timeout" in str(j.get("error") or "")]
        if wt_fails:
            hints.append(
                f"{len(wt_fails)} job(s) hit wall timeout. Retry on a faster tier with: "
                f"`cursor-fleet retry --campaign {cid} --model high-fast --timeout-fallback-model auto --run` "
                f"(or `--preset blueprint` for long specs / `--preset dataset` for bulk batches)."
            )
    summary["hints"] = hints
    if hints and not quiet:
        for h in hints:
            print(f"[fleet][hint] {h}", file=sys.stderr, flush=True)

    summary["ok"] = failed_cnt == 0
    if not suppress_stdout:
        print(json.dumps(summary, indent=2))
    return 0 if failed_cnt == 0 else 1


def cmd_retry(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64)
    allow_any = bool(getattr(args, "allow_any_model", False))
    new_model = (
        resolve_fleet_model(args.model, allow_any_model=allow_any)
        if getattr(args, "model", None)
        else None
    )
    job_ids = list(args.job or []) or None
    reset_n = store.reset_jobs(
        cid,
        failed_only=not bool(getattr(args, "non_done", False)),
        job_ids=job_ids,
        new_model=new_model,
        max_attempts=getattr(args, "max_attempts", None),
    )
    info = {
        "ok": True,
        "campaign_id": cid,
        "reset_count": reset_n,
        "scope": "job_ids" if job_ids else ("non_done" if getattr(args, "non_done", False) else "failed_only"),
        "model": new_model,
        "max_attempts": getattr(args, "max_attempts", None),
    }
    if getattr(args, "run", False):
        if not getattr(args, "quiet", False):
            print(
                f"[retry] reset {reset_n} job(s) in campaign `{cid}`"
                + (f" -> model={new_model}" if new_model else ""),
                file=sys.stderr,
                flush=True,
            )
        # Clear args.model so cmd_run doesn't redundantly re-override unrelated pending jobs if --job was used
        if job_ids:
            args.model = None
        return cmd_run(args)
    print(json.dumps(info, indent=2))
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    if not db_path.is_file():
        print(json.dumps({"ok": False, "error": f"db not found: {db_path}"}))
        return 1
    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64) if args.campaign else None
    summary = store.campaign_summary(cid)
    _, health = check_host_health(artifact_dir=art_dir)
    summary["host"] = health
    summary["ok"] = True
    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print(f"Fleet DB: {db_path}")
        print(
            f"Jobs: {summary['total_jobs']} | counts={summary['counts']} | "
            f"wall_sum={summary['wall_s_sum']}s (avg {summary['wall_s_avg']}s)"
        )
        t = summary["tokens"]
        print(
            f"Tokens: in={t['input']:,} cache_read={t['cache_read']:,} ({t['cache_hit_pct']}%) "
            f"out={t['output']:,} reason={t['reasoning']:,} | est_std=${summary['est_standard_usd']:.4f} "
            f"est_quota~{summary['est_cursor_quota_pct']}% tools={summary['total_tool_calls']}"
        )
        print(
            f"Host: MemAvailable={health['mem_available_mb']} MiB | "
            f"/ free={health['root_free_gb']} GiB | artifact free={health['artifact_free_gb']} GiB"
        )
    return 0


def cmd_export(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    store = FleetStore(db_path)
    data = store.export_campaign(sanitize_id(args.campaign, 64))
    out_path = Path(args.out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(data, indent=2), encoding="utf-8")
    print(json.dumps({"ok": True, "out": str(out_path), "jobs": len(data["jobs"])}, indent=2))
    return 0


def cmd_prune_worktrees(args: argparse.Namespace) -> int:
    wt_root = Path.home() / ".cursor" / "worktrees"
    found: list[str] = []
    removed: list[str] = []
    if wt_root.is_dir():
        for p in sorted(wt_root.glob("*/*")):
            if not p.is_dir():
                continue
            found.append(str(p))
            if args.dry_run:
                continue
            # Try git worktree remove via git-common-dir if available
            gdir = subprocess.run(
                ["git", "-C", str(p), "rev-parse", "--git-common-dir"],
                capture_output=True,
                text=True,
            )
            if gdir.returncode == 0 and gdir.stdout.strip():
                common = Path(gdir.stdout.strip())
                if not common.is_absolute():
                    common = (p / common).resolve()
                repo_root = common.parent if common.name == ".git" else common
                subprocess.run(
                    ["git", "-C", str(repo_root), "worktree", "remove", "--force", str(p)],
                    capture_output=True,
                    text=True,
                )
                subprocess.run(
                    ["git", "-C", str(repo_root), "worktree", "prune"],
                    capture_output=True,
                    text=True,
                )
            shutil.rmtree(p, ignore_errors=True)
            removed.append(str(p))
        if not args.dry_run:
            for parent in sorted(wt_root.glob("*")):
                if parent.is_dir() and not any(parent.iterdir()):
                    try:
                        parent.rmdir()
                    except OSError:
                        pass
    print(
        json.dumps(
            {"ok": True, "dry_run": bool(args.dry_run), "found": found, "removed": removed},
            indent=2,
        )
    )
    return 0


def cmd_record_win(args: argparse.Namespace) -> int:
    """Record a verified bug/task discovery trajectory into an append-only JSONL exemplar log."""
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    out_path = Path(args.out) if args.out else (art_dir / "winning_trajectories.jsonl")
    out_path.parent.mkdir(parents=True, exist_ok=True)

    job_meta: dict[str, Any] = {}
    cid = sanitize_id(args.campaign, 64) if args.campaign else None
    if args.job_id and db_path.is_file():
        store = FleetStore(db_path)
        summary_data = store.export_campaign(cid) if cid else None
        if summary_data:
            for j in summary_data.get("jobs", []):
                if j.get("id") == args.job_id:
                    job_meta = {
                        "resolved_model": j.get("resolved_model") or j.get("model"),
                        "stage": j.get("stage"),
                        "tool_calls": j.get("tool_calls"),
                        "output_path": j.get("output_path"),
                    }
                    break

    record: dict[str, Any] = {
        "recorded_at": utc_now_iso(),
        "campaign_id": cid,
        "job_id": args.job_id,
        "target": str(args.target).strip(),
        "vuln_class": str(args.vuln_class).strip(),
        "summary": str(args.summary).strip(),
        "steps": [str(s).strip() for s in (args.step or []) if str(s).strip()],
    }
    if job_meta:
        record["job_meta"] = job_meta

    with out_path.open("a", encoding="utf-8") as fp:
        fp.write(json.dumps(record, ensure_ascii=False) + "\n")

    print(json.dumps({"ok": True, "out": str(out_path), "record": record}, indent=2))
    return 0


_HEX_CHARS = frozenset("0123456789abcdefABCDEF")
_VALID_JSON_ESCAPES = frozenset('"\\/bfnrt')


def _repair_json_candidate(s: str) -> str:
    """String-aware repair for common LLM JSON bugs (only used after strict json.loads fails):
    1. Stray Python backslashes inside strings (\\U, \\d, \\s, \\') -> double-escaped
    2. Trailing commas right before ] or }
    3. Missing commas between adjacent objects outside strings (`}{` -> `},{`)
    4. Transposed `]"},` / `]"}]` BPE close-quote tokens (`]"},` -> `"]},`)
    5. Missing final `]` on a `[...}` top-level array
    """
    # Step A: Fix known BPE transposed array-string terminator `]"}` before `, {` or `]`
    fixed = re.sub(r'\]"\}(\s*,\s*\{)', r'"]}\1', s)
    fixed = re.sub(r'\]"\}(\s*\]\s*)$', r'"]}\1', fixed)

    out: list[str] = []
    in_str = False
    last_non_ws = ""
    i = 0
    n = len(fixed)
    while i < n:
        ch = fixed[i]
        if in_str:
            if ch == '"':
                in_str = False
                out.append(ch)
                last_non_ws = ch
                i += 1
            elif ch == "\\":
                if i + 1 < n:
                    nxt = fixed[i + 1]
                    if nxt in _VALID_JSON_ESCAPES:
                        out.append(ch)
                        out.append(nxt)
                        i += 2
                    elif nxt == "u" and i + 5 < n and all(c in _HEX_CHARS for c in fixed[i + 2 : i + 6]):
                        out.append(fixed[i : i + 6])
                        i += 6
                    else:
                        # Stray Python escape (e.g. \U0001f60a, \d, \s, \') -> double-escape backslash
                        out.append("\\\\")
                        i += 1
                else:
                    out.append("\\\\")
                    i += 1
            elif ch == "\n":
                out.append("\\n")
                i += 1
            elif ch == "\r":
                out.append("\\r")
                i += 1
            elif ch == "\t":
                out.append("\\t")
                i += 1
            else:
                out.append(ch)
                i += 1
        else:
            if ch == '"':
                in_str = True
                out.append(ch)
                last_non_ws = ch
                i += 1
            elif ch == "{":
                if last_non_ws == "}":
                    out.append(",")
                out.append(ch)
                last_non_ws = ch
                i += 1
            elif ch == ",":
                # Drop trailing comma right before ] or }
                j = i + 1
                while j < n and fixed[j] in " \t\r\n":
                    j += 1
                if j < n and fixed[j] in "]}":
                    i += 1
                else:
                    out.append(ch)
                    last_non_ws = ch
                    i += 1
            else:
                out.append(ch)
                if ch not in " \t\r\n":
                    last_non_ws = ch
                i += 1
    res = "".join(out).strip()
    if res.startswith("[") and res.endswith("}") and not res.endswith("]"):
        res += "]"
    return res


def extract_json_payload(text: str) -> Any:
    """Best-effort extraction of a JSON object or array from an LLM response (with Python-escape repair fallback)."""
    raw = (text or "").strip()
    if not raw:
        return None
    candidates: list[str] = [raw]
    for block in re.findall(r"```(?:json)?\s*\n(.*?)```", raw, flags=re.DOTALL | re.IGNORECASE):
        b = block.strip()
        if b:
            candidates.append(b)
    for open_ch, close_ch in (("[", "]"), ("{", "}")):
        start = raw.find(open_ch)
        end = raw.rfind(close_ch)
        if start != -1 and end > start:
            candidates.append(raw[start : end + 1])

    # Pass 1: strict json.loads (zero mutation on valid JSON)
    for cand in candidates:
        try:
            return json.loads(cand)
        except Exception:
            continue
    # Pass 2: surgical string-aware backslash & trailing-comma repair
    for cand in candidates:
        try:
            return json.loads(_repair_json_candidate(cand))
        except Exception:
            continue
    return None


def pack_map_items(
    items: list[dict[str, Any]],
    batch_size: int = 1,
    batch_max_chars: int = 48000,
) -> list[list[dict[str, Any]]]:
    """Pack map items into size-bounded batches (empirical sweet spot N=4 for Grok 4.7 synthesis)."""
    bs = max(1, int(batch_size))
    cap = max(2000, int(batch_max_chars))
    batches: list[list[dict[str, Any]]] = []
    cur: list[dict[str, Any]] = []
    cur_chars = 0
    for item in items:
        body_len = len(str(item.get("body") or "")) + 120
        if cur and (len(cur) >= bs or (cur_chars + body_len > cap)):
            batches.append(cur)
            cur = []
            cur_chars = 0
        cur.append(item)
        cur_chars += body_len
    if cur:
        batches.append(cur)
    return batches


def estimate_batch_cost(
    prompts: list[str],
    model: str,
    est_output_tokens_per_worker: int = 4200,
) -> dict[str, Any]:
    """Estimate input/output tokens (incl. Grok 4.7 reasoning), USD, and Cursor quota % before running."""
    lens = [len(p) for p in prompts]
    tot_chars = sum(lens)
    est_in_tok = max(1, tot_chars // 4) if tot_chars else 0
    est_out_tok = len(prompts) * max(100, int(est_output_tokens_per_worker))
    mult = 2.0 if str(model).lower().endswith("-fast") else 1.0
    est_std_usd = round((est_in_tok * 2.0 + est_out_tok * 6.0) / 1_000_000.0, 4)
    est_act_usd = round(est_std_usd * mult, 4)
    return {
        "workers": len(prompts),
        "model": model,
        "prompt_chars_total": tot_chars,
        "prompt_chars_min": min(lens) if lens else 0,
        "prompt_chars_avg": round(tot_chars / len(lens), 1) if lens else 0.0,
        "prompt_chars_max": max(lens) if lens else 0,
        "est_input_tokens": est_in_tok,
        "est_output_tokens": est_out_tok,
        "est_standard_usd": est_std_usd,
        "est_actual_usd": est_act_usd,
        "est_cursor_quota_pct": round(est_act_usd / CURSOR_USD_PER_1PCT, 2),
    }


def _collect_campaign_outputs(export_data: dict[str, Any], parse_json: bool = False) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for j in export_data.get("jobs") or []:
        out_p = j.get("output_path")
        text = ""
        if out_p and Path(out_p).is_file():
            try:
                text = Path(out_p).read_text(encoding="utf-8", errors="replace")
            except OSError:
                text = ""
        rec: dict[str, Any] = {
            "id": j.get("id"),
            "name": j.get("name"),
            "stage": j.get("stage"),
            "status": j.get("status"),
            "model": j.get("resolved_model") or j.get("model"),
            "wall_s": j.get("wall_s"),
            "tool_calls": j.get("tool_calls"),
            "input_tokens": j.get("input_tokens"),
            "cache_read_tokens": j.get("cache_read_tokens"),
            "output_tokens": j.get("output_tokens"),
            "error": j.get("error"),
            "output_path": out_p,
            "patch_path": j.get("patch_path"),
            "receipt_path": j.get("receipt_path"),
            "output": text,
        }
        if parse_json:
            rec["parsed"] = extract_json_payload(text)
        rows.append(rec)
    return rows


def render_campaign_markdown(export_data: dict[str, Any], parse_json: bool = False) -> str:
    camp = export_data.get("campaign") or {}
    summary = export_data.get("summary") or {}
    cid = camp.get("id") or "unknown"
    t = summary.get("tokens") or {}
    lines = [
        f"# Fleet Campaign Report: `{cid}`",
        "",
        f"- **Status:** `{camp.get('status', 'unknown')}` | **Jobs:** `{summary.get('total_jobs', 0)}` (`{summary.get('counts', {})}`)",
        f"- **Tokens:** in=`{t.get('input', 0):,}` cache_read=`{t.get('cache_read', 0):,}` ({t.get('cache_hit_pct', 0)}%) out=`{t.get('output', 0):,}` reason=`{t.get('reasoning', 0):,}`",
        f"- **Cost & Speed:** est_actual=`${summary.get('est_actual_usd', summary.get('est_standard_usd', 0.0)):.4f}` (~`{summary.get('est_cursor_quota_pct', 0.0)}%` quota) | wall_sum=`{summary.get('wall_s_sum', 0)}s` (avg `{summary.get('wall_s_avg', 0)}s`) | tools=`{summary.get('total_tool_calls', 0)}`",
        "",
    ]
    all_outputs = _collect_campaign_outputs(export_data, parse_json=parse_json)
    final_reduces = [r for r in all_outputs if str(r.get("stage") or "") in ("reduce", "judge") and str(r.get("id") or "").startswith(("reduce-final", "judge-"))]
    if final_reduces:
        fr = final_reduces[-1]
        lines.append(f"## Executive Synthesis (`{fr['id']}` · `{fr['model']}` · `{fr['wall_s']}s`)")
        lines.append("")
        if parse_json and fr.get("parsed") is not None:
            lines.append("```json")
            lines.append(json.dumps(fr["parsed"], indent=2, ensure_ascii=False))
            lines.append("```")
        else:
            lines.append((fr.get("output") or "").strip() or "_(empty output)_")
        lines.append("")
        lines.append("---")
        lines.append("")
    for rec in all_outputs:
        if rec in final_reduces:
            continue
        lines.append(f"## {rec['id']} (`{rec['status']}` · `{rec['model']}` · `{rec['wall_s']}s` · `{rec['tool_calls']}` tools)")
        if rec.get("error"):
            lines.append(f"> Error: `{rec['error']}`")
        if rec.get("patch_path"):
            lines.append(f"- Patch: `{rec['patch_path']}`")
        if parse_json and rec.get("parsed") is not None:
            lines.append("```json")
            lines.append(json.dumps(rec["parsed"], indent=2, ensure_ascii=False))
            lines.append("```")
        else:
            body = (rec.get("output") or "").strip()
            lines.append(body if body else "_(empty output)_")
        lines.append("")
    return "\n".join(lines)


def _discover_cursor_models(cursor_bin: str) -> tuple[list[str], list[str]]:
    grok_models: list[str] = []
    other_models: list[str] = []
    try:
        proc = subprocess.run([cursor_bin, "models"], capture_output=True, text=True, timeout=15)
        if proc.returncode != 0:
            return grok_models, other_models
        for line in proc.stdout.splitlines():
            s = line.strip()
            if not s or " - " not in s or s.lower().startswith("available models"):
                continue
            mid = s.split(" - ", 1)[0].strip()
            if not mid:
                continue
            if "grok" in mid.lower():
                grok_models.append(mid)
            else:
                other_models.append(mid)
    except Exception:
        pass
    return grok_models, other_models


def cmd_doctor(args: argparse.Namespace) -> int:
    cursor_bin = find_cursor_agent(args.cursor_bin)
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    bwrap_bin = shutil.which("bwrap")

    version_str = None
    auth_ok = False
    auth_msg = "not checked"
    grok_models: list[str] = []
    other_models: list[str] = []
    hints: list[str] = []

    if cursor_bin:
        try:
            vp = subprocess.run([cursor_bin, "--version"], capture_output=True, text=True, timeout=8)
            version_str = (vp.stdout or vp.stderr).strip().splitlines()[0] if (vp.stdout or vp.stderr).strip() else None
        except Exception:
            version_str = None
        try:
            sp = subprocess.run([cursor_bin, "status"], capture_output=True, text=True, timeout=10)
            lines = [ln.strip() for ln in (sp.stdout or sp.stderr).splitlines() if ln.strip()]
            auth_msg = lines[-1] if lines else f"exit {sp.returncode}"
            auth_ok = sp.returncode == 0
            if not auth_ok:
                hints.append("Run `cursor-agent login` (or set CURSOR_API_KEY) to authenticate Cursor CLI.")
        except Exception as exc:
            auth_msg = str(exc)
            hints.append("Verify `cursor-agent status` works interactively.")
        if auth_ok and not getattr(args, "fast", False):
            grok_models, other_models = _discover_cursor_models(cursor_bin)
    else:
        hints.append("Install Cursor CLI: `curl https://cursor.com/install -fsS | bash` then `cursor-agent login`.")

    if not bwrap_bin:
        hints.append("Optional: install `bubblewrap` (`sudo apt install bubblewrap`) for confined worktree verification.")

    healthy, host_snap = check_host_health(artifact_dir=art_dir)
    if not healthy:
        hints.append("Host headroom below threshold: " + "; ".join(host_snap["reasons"]))

    ok = bool(cursor_bin) and auth_ok
    report = {
        "ok": ok,
        "platform": sys.platform,
        "cursor_agent": cursor_bin,
        "cursor_version": version_str,
        "auth_ok": auth_ok,
        "auth": auth_msg,
        "default_family": os.environ.get("WM_GROK_FAMILY") or DEFAULT_FAMILY,
        "grok_models_count": len(grok_models),
        "grok_models": grok_models,
        "other_models_count": len(other_models),
        "bwrap": bwrap_bin,
        "db_path": str(db_path),
        "artifact_dir": str(art_dir),
        "host_healthy": healthy,
        "host": host_snap,
        "presets": {k: v["description"] for k, v in FLEET_PRESETS.items()},
        "hints": hints,
    }
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print("wm-grok-fleet doctor")
        print(f"  cursor-agent : {cursor_bin or 'MISSING'} ({version_str or 'unknown'})")
        print(f"  auth         : {'OK' if auth_ok else 'FAIL'} — {auth_msg}")
        if getattr(args, "fast", False):
            print(f"  grok models  : skipped (--fast; default family: {report['default_family']})")
        else:
            print(f"  grok models  : {len(grok_models)} detected (default family: {report['default_family']}; other Cursor models: {len(other_models)})")
        print(f"  bwrap        : {bwrap_bin or 'not installed (optional; Linux confinement)'}")
        ram_disp = f"{host_snap['mem_available_mb']} MiB" if host_snap["mem_available_mb"] is not None else "n/a"
        print(f"  host health  : {'OK' if healthy else 'WARN'} — RAM={ram_disp}, /={host_snap['root_free_gb']} GiB, artifacts={host_snap['artifact_free_gb']} GiB")
        print(f"  fleet db     : {db_path}")
        print(f"  artifacts    : {art_dir}")
        print("  presets      :")
        for pk, pv in FLEET_PRESETS.items():
            print(f"    - {pk:10s} : {pv['description']}")
        if hints:
            print("  next steps   :")
            for h in hints:
                print(f"    * {h}")
    return 0 if ok else 1


def cmd_campaigns(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    if not db_path.is_file():
        if args.json:
            print(json.dumps({"ok": True, "db_path": str(db_path), "campaigns": []}, indent=2))
        else:
            print(f"No fleet database yet at {db_path}")
        return 0
    store = FleetStore(db_path)
    camps = store.list_campaigns()
    if args.limit and args.limit > 0:
        camps = camps[: args.limit]
    if args.json:
        print(json.dumps({"ok": True, "db_path": str(db_path), "campaigns": camps}, indent=2))
    else:
        print(f"Fleet DB: {db_path} ({len(camps)} campaigns)")
        for c in camps:
            cnt = c["counts"]
            print(
                f"  {c['id']:32s} | {c['status']:14s} | "
                f"done={cnt.get('done',0)} pend={cnt.get('pending',0)} fail={cnt.get('failed',0)} | "
                f"${c['est_actual_usd']:.4f} (~{c['est_cursor_quota_pct']:.2f}%) | "
                f"{str(c.get('created_at') or '')[:19]}"
            )
    return 0


def cmd_inspect(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    if not db_path.is_file():
        print(json.dumps({"ok": False, "error": f"db not found: {db_path}"}))
        return 1
    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64)
    data = store.export_campaign(cid)
    jobs = data["jobs"]
    if args.job:
        jobs = [j for j in jobs if j.get("id") == args.job or j.get("name") == args.job]
    if args.failed_only:
        jobs = [j for j in jobs if j.get("status") != "done"]

    max_chars = max(100, int(args.max_chars or 2000))
    if args.json:
        enriched = []
        for j in jobs:
            item = dict(j)
            if args.show_output and j.get("output_path") and Path(j["output_path"]).is_file():
                item["output_preview"] = Path(j["output_path"]).read_text(encoding="utf-8", errors="replace")[:max_chars]
            enriched.append(item)
        print(json.dumps({"ok": True, "campaign": cid, "jobs": enriched}, indent=2))
    else:
        print(f"Campaign: {cid} ({len(jobs)} matching jobs)")
        for j in jobs:
            print(
                f"  - {j['id']} [{j['status']}] model={j.get('resolved_model') or j.get('model')} "
                f"wall={j.get('wall_s')}s tools={j.get('tool_calls')} "
                f"in={j.get('input_tokens') or 0} cr={j.get('cache_read_tokens') or 0} out={j.get('output_tokens') or 0}"
            )
            if j.get("error"):
                print(f"    error: {j['error']}")
            if j.get("patch_path"):
                print(f"    patch: {j['patch_path']}")
            if args.show_output and j.get("output_path") and Path(j["output_path"]).is_file():
                txt = Path(j["output_path"]).read_text(encoding="utf-8", errors="replace").strip()
                print(f"    output ({len(txt)} chars):\n{txt[:max_chars]}")
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    if not db_path.is_file():
        print(json.dumps({"ok": False, "error": f"db not found: {db_path}"}))
        return 1
    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64)
    data = store.export_campaign(cid)
    if data.get("campaign") is None and not data.get("jobs"):
        print(json.dumps({"ok": False, "error": f"campaign not found: {cid}"}))
        return 1

    fmt = str(args.format or "md").strip().lower()
    if fmt == "json":
        payload = {
            "ok": True,
            "campaign": data["campaign"],
            "summary": data["summary"],
            "results": _collect_campaign_outputs(data, parse_json=bool(args.parse_json)),
        }
        rendered = json.dumps(payload, indent=2, ensure_ascii=False)
    else:
        rendered = render_campaign_markdown(data, parse_json=bool(args.parse_json))

    if args.out:
        out_p = Path(args.out)
        out_p.parent.mkdir(parents=True, exist_ok=True)
        out_p.write_text(rendered, encoding="utf-8")
        print(json.dumps({"ok": True, "campaign": cid, "format": fmt, "out": str(out_p), "bytes": len(rendered.encode("utf-8"))}, indent=2))
    else:
        print(rendered)
    return 0


def cmd_patches(args: argparse.Namespace) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    if not db_path.is_file():
        print(json.dumps({"ok": False, "error": f"db not found: {db_path}"}))
        return 1
    store = FleetStore(db_path)
    cid = sanitize_id(args.campaign, 64)
    data = store.export_campaign(cid)
    patch_jobs = [j for j in data["jobs"] if j.get("patch_path")]

    if args.apply:
        repo = Path(args.repo or os.getcwd()).resolve()
        matches = [j for j in patch_jobs if j.get("id") == args.apply or j.get("name") == args.apply]
        if not matches:
            print(json.dumps({"ok": False, "error": f"no patch found for job '{args.apply}' in campaign '{cid}'"}))
            return 1
        p_path = Path(matches[0]["patch_path"])
        if not p_path.is_file() or not p_path.read_text(encoding="utf-8", errors="replace").strip():
            print(json.dumps({"ok": False, "error": f"patch file empty or missing: {p_path}"}))
            return 1
        chk = subprocess.run(
            ["git", "-C", str(repo), "apply", "--check", str(p_path)],
            capture_output=True,
            text=True,
        )
        if chk.returncode != 0:
            print(json.dumps({"ok": False, "dry_run": bool(args.check), "error": chk.stderr.strip() or "git apply --check failed"}))
            return 1
        if args.check:
            print(json.dumps({"ok": True, "dry_run": True, "job_id": matches[0]["id"], "patch": str(p_path), "repo": str(repo)}, indent=2))
            return 0
        ap = subprocess.run(
            ["git", "-C", str(repo), "apply", str(p_path)],
            capture_output=True,
            text=True,
        )
        ok = ap.returncode == 0
        print(
            json.dumps(
                {
                    "ok": ok,
                    "applied": ok,
                    "job_id": matches[0]["id"],
                    "patch": str(p_path),
                    "repo": str(repo),
                    "error": ap.stderr.strip() if not ok else None,
                },
                indent=2,
            )
        )
        return 0 if ok else 1

    entries = []
    for j in patch_jobs:
        p_path = Path(j["patch_path"])
        size_b = p_path.stat().st_size if p_path.is_file() else 0
        rcpt_ok = None
        if j.get("receipt_path") and Path(j["receipt_path"]).is_file():
            try:
                rcpt = json.loads(Path(j["receipt_path"]).read_text(encoding="utf-8"))
                rcpt_ok = bool(rcpt.get("scope_confined")) and rcpt.get("verify_exit_code") == 0
            except Exception:
                rcpt_ok = False
        entries.append(
            {
                "id": j["id"],
                "name": j["name"],
                "status": j["status"],
                "patch_path": str(p_path),
                "patch_bytes": size_b,
                "verify_exit_code": j.get("verify_exit_code"),
                "confined_verified": rcpt_ok,
            }
        )
    if args.json:
        print(json.dumps({"ok": True, "campaign": cid, "patches": entries}, indent=2))
    else:
        print(f"Patches for campaign `{cid}` ({len(entries)} total):")
        for e in entries:
            print(
                f"  - {e['id']} [{e['status']}] {e['patch_bytes']}B | "
                f"verify_rc={e['verify_exit_code']} | confined_ok={e['confined_verified']} | {e['patch_path']}"
            )
    return 0


def _build_run_namespace(
    *,
    campaign: str,
    preset: str | None,
    read_concurrency: int | None,
    write_concurrency: int | None,
    stall_timeout: int | None,
    wall_timeout: int | None,
    max_retries: int,
    min_free_ram_mb: float,
    min_free_root_gb: float,
    empty_cwd: bool,
    no_tools_guard: bool,
    max_tool_calls: int | None,
    max_usd: float,
    retry_wall_timeouts: bool,
    checkpoint_path: str | None,
    checkpoint_jsonl: str | None,
    retry_failed: bool,
    cursor_bin: str | None,
    db_path: str | None,
    artifact_dir: str | None,
    allow_any_model: bool,
    quiet: bool,
    streaming_grace: int | None = None,
    timeout_fallback_model: str | None = None,
    model: str | None = None,
    suppress_stdout: bool = False,
) -> argparse.Namespace:
    return argparse.Namespace(
        campaign=campaign,
        preset=preset,
        read_concurrency=read_concurrency,
        write_concurrency=write_concurrency,
        stall_timeout=stall_timeout,
        wall_timeout=wall_timeout,
        streaming_grace=streaming_grace,
        timeout_fallback_model=timeout_fallback_model,
        model=model,
        max_retries=max_retries,
        min_free_ram_mb=min_free_ram_mb,
        min_free_root_gb=min_free_root_gb,
        empty_cwd=empty_cwd,
        no_tools_guard=no_tools_guard,
        max_tool_calls=max_tool_calls,
        max_usd=max_usd,
        retry_wall_timeouts=retry_wall_timeouts,
        checkpoint_path=checkpoint_path,
        checkpoint_jsonl=checkpoint_jsonl,
        retry_failed=retry_failed,
        cursor_bin=cursor_bin,
        db_path=db_path,
        artifact_dir=artifact_dir,
        allow_any_model=allow_any_model,
        quiet=quiet,
        _suppress_stdout=suppress_stdout,
    )


def _enqueue_and_run_inline(
    *,
    cid: str,
    rows_spec: list[dict[str, Any]],
    args: argparse.Namespace,
    preset_cfg: dict[str, Any],
    model_str: str,
) -> int:
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    prompts_dir = art_dir / "campaigns" / cid / "prompts"

    if getattr(args, "dry_run", False):
        est = estimate_batch_cost([r["prompt"] for r in rows_spec], model_str)
        preview = {
            "ok": True,
            "dry_run": True,
            "campaign_id": cid,
            "preset": getattr(args, "preset", None),
            "action": rows_spec[0]["action"] if rows_spec else "ask",
            "estimate": est,
            "sample_jobs": [
                {"id": r["id"], "name": r["name"], "prompt_chars": len(r["prompt"])}
                for r in rows_spec[:10]
            ],
        }
        print(json.dumps(preview, indent=2))
        return 0

    prompts_dir.mkdir(parents=True, exist_ok=True)
    store = FleetStore(db_path)
    store.ensure_campaign(cid, name=cid, config={"preset": getattr(args, "preset", None), "mode": args.cmd})

    db_rows: list[dict[str, Any]] = []
    for r in rows_spec:
        p_file = prompts_dir / f"{r['id']}.txt"
        p_file.write_text(r["prompt"], encoding="utf-8")
        db_rows.append(
            {
                "id": r["id"],
                "name": r["name"],
                "stage": r.get("stage", args.cmd),
                "action": r["action"],
                "model": r["model"],
                "cwd": r["cwd"],
                "prompt_path": str(p_file),
                "verify_cmd": r.get("verify_cmd"),
                "confined": 1 if r.get("confined") else 0,
                "max_attempts": max(1, int(r.get("max_attempts", 3))),
                "priority": int(r.get("priority", 0)),
            }
        )
    store.enqueue_jobs(cid, db_rows)

    run_ns = _build_run_namespace(
        campaign=cid,
        preset=getattr(args, "preset", None),
        read_concurrency=getattr(args, "read_concurrency", None),
        write_concurrency=getattr(args, "write_concurrency", None),
        stall_timeout=getattr(args, "stall_timeout", None),
        wall_timeout=getattr(args, "wall_timeout", None),
        max_retries=int(getattr(args, "max_retries", 2)),
        min_free_ram_mb=float(getattr(args, "min_free_ram_mb", 1500.0)),
        min_free_root_gb=float(getattr(args, "min_free_root_gb", 8.0)),
        empty_cwd=bool(getattr(args, "empty_cwd", False)),
        no_tools_guard=bool(getattr(args, "no_tools_guard", False)),
        max_tool_calls=getattr(args, "max_tool_calls", None),
        max_usd=float(getattr(args, "max_usd", 0.0) or 0.0),
        retry_wall_timeouts=bool(getattr(args, "retry_wall_timeouts", False)),
        checkpoint_path=getattr(args, "checkpoint_path", None),
        checkpoint_jsonl=getattr(args, "checkpoint_jsonl", None),
        retry_failed=bool(getattr(args, "retry_failed", False)),
        cursor_bin=getattr(args, "cursor_bin", None),
        db_path=str(db_path),
        artifact_dir=str(art_dir),
        allow_any_model=bool(getattr(args, "allow_any_model", False)),
        quiet=bool(getattr(args, "quiet", False)),
        streaming_grace=getattr(args, "streaming_grace", None),
        timeout_fallback_model=getattr(args, "timeout_fallback_model", None),
        suppress_stdout=True,
    )
    rc = cmd_run(run_ns)
    export_data = store.export_campaign(cid)
    parse_json = bool(getattr(args, "parse_json", False))
    results = _collect_campaign_outputs(export_data, parse_json=parse_json)

    payload = {
        "ok": rc == 0,
        "campaign_id": cid,
        "summary": export_data["summary"],
        "results": results,
    }
    if getattr(args, "out", None):
        out_p = Path(args.out)
        out_p.parent.mkdir(parents=True, exist_ok=True)
        out_p.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")
    if getattr(args, "text_out", None):
        txt_p = Path(args.text_out)
        txt_p.parent.mkdir(parents=True, exist_ok=True)
        if len(results) == 1:
            raw_txt = (results[0].get("output") or results[0].get("text") or "").strip()
        else:
            parts = [
                f"<!-- job: {r.get('id')} ({r.get('status')}) -->\n{(r.get('output') or r.get('text') or '').strip()}"
                for r in results
            ]
            raw_txt = "\n\n---\n\n".join(parts)
        txt_p.write_text((raw_txt + "\n") if raw_txt else "", encoding="utf-8")
    if getattr(args, "report_md", None):
        md_p = Path(args.report_md)
        md_p.parent.mkdir(parents=True, exist_ok=True)
        md_p.write_text(render_campaign_markdown(export_data, parse_json=parse_json), encoding="utf-8")

    # Emit compact stdout JSON (if --out or --text-out was written, keep stdout concise; else include results)
    if getattr(args, "out", None) or getattr(args, "text_out", None):
        stdout_obj = {
            "ok": rc == 0,
            "campaign_id": cid,
            "out": str(args.out) if getattr(args, "out", None) else None,
            "text_out": str(args.text_out) if getattr(args, "text_out", None) else None,
            "report_md": str(args.report_md) if getattr(args, "report_md", None) else None,
            "summary": export_data["summary"],
        }
    else:
        stdout_obj = payload
    print(json.dumps(stdout_obj, indent=2, ensure_ascii=False))
    return rc


def cmd_ask(args: argparse.Namespace) -> int:
    preset_cfg = FLEET_PRESETS.get(str(args.preset).strip().lower(), {}) if args.preset else {}
    action = str(args.action or preset_cfg.get("action") or "ask").strip().lower()
    model = resolve_fleet_model(
        args.model or preset_cfg.get("model") or "medium",
        allow_any_model=bool(args.allow_any_model),
    )
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    prompts: list[str] = list(args.prompts or [])
    if args.prompt_file:
        prompts.append(Path(args.prompt_file).read_text(encoding="utf-8"))
    if not prompts:
        print(json.dumps({"ok": False, "error": "provide at least one prompt argument or --prompt-file"}))
        return 1

    cid = sanitize_id(
        args.campaign or f"ask-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}",
        64,
    )
    rows_spec: list[dict[str, Any]] = []
    for idx, p_text in enumerate(prompts, 1):
        jid = sanitize_id(f"ask-{idx:03d}-{hashlib.sha256(p_text.encode('utf-8')).hexdigest()[:8]}", 64)
        rows_spec.append(
            {
                "id": jid,
                "name": f"ask-{idx:03d}",
                "stage": "ask",
                "action": action,
                "model": model,
                "cwd": cwd,
                "prompt": p_text,
                "verify_cmd": args.verify_cmd,
                "confined": bool(args.confined or preset_cfg.get("confined", False)),
                "priority": len(prompts) - idx,
            }
        )
    return _enqueue_and_run_inline(cid=cid, rows_spec=rows_spec, args=args, preset_cfg=preset_cfg, model_str=model)


def cmd_map(args: argparse.Namespace) -> int:
    preset_cfg = FLEET_PRESETS.get(str(args.preset).strip().lower(), {}) if args.preset else {}
    action = str(args.action or preset_cfg.get("action") or "ask").strip().lower()
    model = resolve_fleet_model(
        args.model or preset_cfg.get("model") or "medium",
        allow_any_model=bool(args.allow_any_model),
    )
    cwd = Path(args.cwd or os.getcwd()).resolve()
    inline_files = bool(args.inline_files) or bool(preset_cfg.get("inline_files", False))
    max_file_bytes = max(1024, int((args.max_file_kb or 64) * 1024))

    instruction = str(args.instruction or "").strip()
    if args.instruction_file:
        instruction = Path(args.instruction_file).read_text(encoding="utf-8").strip()
    if not instruction:
        print(json.dumps({"ok": False, "error": "--instruction or --instruction-file is required for `map`"}))
        return 1

    camp_excl = _load_exclusions_file(Path(args.exclusions_file)) if args.exclusions_file else []
    camp_forb = [str(x).strip() for x in (args.forbidden or []) if str(x).strip()]
    camp_traj = (
        _load_trajectories_jsonl(Path(args.trajectories_file), max_items=int(args.max_trajectories or 3))
        if args.trajectories_file
        else []
    )

    items: list[dict[str, Any]] = []
    seen_files: set[Path] = set()
    for pattern in (args.files or []):
        p_obj = Path(pattern)
        if p_obj.is_absolute():
            matches = sorted(Path(p_obj.anchor).glob(str(p_obj.relative_to(p_obj.anchor))))
        else:
            matches = sorted(cwd.glob(pattern))
        for m in matches:
            if not m.is_file():
                continue
            rm = m.resolve()
            if rm in seen_files:
                continue
            seen_files.add(rm)
            try:
                rel = str(rm.relative_to(cwd))
            except ValueError:
                rel = str(rm)
            if inline_files:
                raw_bytes = rm.read_bytes()
                truncated = len(raw_bytes) > max_file_bytes
                body = raw_bytes[:max_file_bytes].decode("utf-8", errors="replace")
                if truncated:
                    body += f"\n... [truncated at {max_file_bytes} bytes of {len(raw_bytes)}]"
                items.append({"id": rel, "body": f"FILE: {rel}\n```\n{body}\n```"})
            else:
                items.append({"id": rel, "body": f"Inspect file `{rel}` in workspace `{cwd}`."})

    if args.items_jsonl:
        for idx, raw_line in enumerate(Path(args.items_jsonl).read_text(encoding="utf-8").splitlines(), 1):
            line = raw_line.strip()
            if not line:
                continue
            obj = json.loads(line)
            if isinstance(obj, dict):
                iid = str(obj.get(args.id_field) or obj.get("id") or f"item-{idx:04d}")
                body = json.dumps(obj, ensure_ascii=False, indent=2)
            else:
                iid = f"item-{idx:04d}"
                body = str(obj)
            items.append({"id": iid, "body": body})

    if args.items_json:
        parsed = json.loads(Path(args.items_json).read_text(encoding="utf-8"))
        if not isinstance(parsed, list):
            print(json.dumps({"ok": False, "error": "--items-json must contain a JSON array"}))
            return 1
        for idx, obj in enumerate(parsed, 1):
            if isinstance(obj, dict):
                iid = str(obj.get(args.id_field) or obj.get("id") or f"item-{idx:04d}")
                body = json.dumps(obj, ensure_ascii=False, indent=2)
            else:
                iid = f"item-{idx:04d}"
                body = str(obj)
            items.append({"id": iid, "body": body})

    if args.stdin_items:
        for idx, raw_line in enumerate(sys.stdin.read().splitlines(), 1):
            line = raw_line.strip()
            if not line:
                continue
            items.append({"id": f"stdin-{idx:04d}", "body": line})

    if not items:
        print(json.dumps({"ok": False, "error": "no map items matched (--files, --items-jsonl, --items-json, or --stdin-items)"}))
        return 1

    batches = pack_map_items(
        items,
        batch_size=int(args.batch_size or 1),
        batch_max_chars=int(args.batch_max_chars or 48000),
    )
    cid = sanitize_id(
        args.campaign or f"map-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}",
        64,
    )

    rows_spec: list[dict[str, Any]] = []
    for b_idx, batch in enumerate(batches, 1):
        blocks = [f"=== ITEM {it['id']} ===\n{it['body']}" for it in batch]
        task_body = f"{instruction}\n\n" + "\n\n".join(blocks)
        composed = compose_worker_prompt(
            task_body,
            intended_design_exclusions=camp_excl,
            forbidden_actions=camp_forb,
            winning_trajectories=camp_traj,
        )
        # Keep deterministic batch IDs when --campaign is provided so interrupted runs resume idempotently!
        batch_key = "|".join(it["id"] for it in batch)
        digest = hashlib.sha256(batch_key.encode("utf-8")).hexdigest()[:8]
        jid = sanitize_id(f"batch-{b_idx:03d}-{digest}", 64)
        rows_spec.append(
            {
                "id": jid,
                "name": f"batch-{b_idx:03d} ({len(batch)} items)",
                "stage": "map",
                "action": action,
                "model": model,
                "cwd": str(cwd),
                "prompt": composed,
                "verify_cmd": args.verify_cmd,
                "confined": bool(args.confined or preset_cfg.get("confined", False)),
                "priority": len(batches) - b_idx,
            }
        )

    if getattr(args, "dry_run", False):
        est = estimate_batch_cost([r["prompt"] for r in rows_spec], model)
        reduce_inst = _resolve_reduce_instruction(args)
        preview = {
            "ok": True,
            "dry_run": True,
            "campaign_id": cid,
            "preset": getattr(args, "preset", None),
            "action": rows_spec[0]["action"] if rows_spec else "ask",
            "reduce_enabled": bool(reduce_inst),
            "estimate": est,
            "sample_jobs": [
                {"id": r["id"], "name": r["name"], "prompt_chars": len(r["prompt"])}
                for r in rows_spec[:10]
            ],
        }
        print(json.dumps(preview, indent=2))
        return 0

    reduce_inst = _resolve_reduce_instruction(args)
    if not reduce_inst:
        return _enqueue_and_run_inline(cid=cid, rows_spec=rows_spec, args=args, preset_cfg=preset_cfg, model_str=model)

    # Run map stage, then recursive zero-tool tree reduce inside the same resumable campaign
    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    prompts_dir = art_dir / "campaigns" / cid / "prompts"
    prompts_dir.mkdir(parents=True, exist_ok=True)
    store = FleetStore(db_path)
    store.ensure_campaign(cid, name=cid, config={"preset": getattr(args, "preset", None), "mode": "map-reduce"})

    db_rows: list[dict[str, Any]] = []
    for r in rows_spec:
        p_file = prompts_dir / f"{r['id']}.txt"
        p_file.write_text(r["prompt"], encoding="utf-8")
        db_rows.append(
            {
                "id": r["id"],
                "name": r["name"],
                "stage": "map",
                "action": r["action"],
                "model": r["model"],
                "cwd": r["cwd"],
                "prompt_path": str(p_file),
                "verify_cmd": r.get("verify_cmd"),
                "confined": 1 if r.get("confined") else 0,
                "max_attempts": max(1, int(r.get("max_attempts", 3))),
                "priority": int(r.get("priority", 0)),
            }
        )
    store.enqueue_jobs(cid, db_rows)

    map_run_ns = _build_run_namespace(
        campaign=cid,
        preset=getattr(args, "preset", None),
        read_concurrency=getattr(args, "read_concurrency", None),
        write_concurrency=getattr(args, "write_concurrency", None),
        stall_timeout=getattr(args, "stall_timeout", None),
        wall_timeout=getattr(args, "wall_timeout", None),
        max_retries=int(getattr(args, "max_retries", 2)),
        min_free_ram_mb=float(getattr(args, "min_free_ram_mb", 1500.0)),
        min_free_root_gb=float(getattr(args, "min_free_root_gb", 8.0)),
        empty_cwd=bool(getattr(args, "empty_cwd", False)),
        no_tools_guard=bool(getattr(args, "no_tools_guard", False)),
        max_tool_calls=getattr(args, "max_tool_calls", None),
        max_usd=float(getattr(args, "max_usd", 0.0) or 0.0),
        retry_wall_timeouts=bool(getattr(args, "retry_wall_timeouts", False)),
        checkpoint_path=getattr(args, "checkpoint_path", None),
        checkpoint_jsonl=getattr(args, "checkpoint_jsonl", None),
        retry_failed=bool(getattr(args, "retry_failed", False)),
        cursor_bin=getattr(args, "cursor_bin", None),
        db_path=str(db_path),
        artifact_dir=str(art_dir),
        allow_any_model=bool(getattr(args, "allow_any_model", False)),
        quiet=bool(getattr(args, "quiet", False)),
        suppress_stdout=True,
    )
    rc_map = cmd_run(map_run_ns)
    parse_json = bool(getattr(args, "parse_json", False))
    export_map = store.export_campaign(cid)
    map_outputs = [r for r in _collect_campaign_outputs(export_map, parse_json=parse_json) if r.get("stage") == "map" and r.get("status") == "done"]

    reduce_model = resolve_fleet_model(
        getattr(args, "reduce_model", None) or model,
        allow_any_model=bool(getattr(args, "allow_any_model", False)),
    )
    max_chunk_chars = max(4000, int(getattr(args, "reduce_max_chunk_chars", 96000) or 96000))
    reduced_info = _run_tree_reduce(
        store=store,
        cid=cid,
        art_dir=art_dir,
        source_pairs=[(r["id"], r["output"]) for r in map_outputs],
        reduce_instruction=reduce_inst,
        reduce_model=reduce_model,
        args=args,
        max_chunk_chars=max_chunk_chars,
        parse_json=parse_json,
    )

    export_final = store.export_campaign(cid)
    results = _collect_campaign_outputs(export_final, parse_json=parse_json)
    rc_all = 0 if (rc_map == 0 and reduced_info.get("ok", False)) else 1
    payload = {
        "ok": rc_all == 0,
        "campaign_id": cid,
        "summary": export_final["summary"],
        "reduced": reduced_info,
        "results": results,
    }
    if getattr(args, "reduce_out", None) and reduced_info.get("output") is not None:
        ro = Path(args.reduce_out)
        ro.parent.mkdir(parents=True, exist_ok=True)
        ro.write_text(str(reduced_info["output"]), encoding="utf-8")
    if getattr(args, "out", None):
        out_p = Path(args.out)
        out_p.parent.mkdir(parents=True, exist_ok=True)
        out_p.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")
    if getattr(args, "report_md", None):
        md_p = Path(args.report_md)
        md_p.parent.mkdir(parents=True, exist_ok=True)
        md_p.write_text(render_campaign_markdown(export_final, parse_json=parse_json), encoding="utf-8")

    stdout_obj = (
        {
            "ok": rc_all == 0,
            "campaign_id": cid,
            "out": str(args.out),
            "report_md": str(args.report_md) if getattr(args, "report_md", None) else None,
            "reduce_out": str(args.reduce_out) if getattr(args, "reduce_out", None) else None,
            "reduced": {k: v for k, v in reduced_info.items() if k != "output"},
            "summary": export_final["summary"],
        }
        if getattr(args, "out", None)
        else payload
    )
    print(json.dumps(stdout_obj, indent=2, ensure_ascii=False))
    return rc_all


def _resolve_reduce_instruction(args: argparse.Namespace) -> str:
    txt = str(getattr(args, "reduce_instruction", None) or "").strip()
    rf = getattr(args, "reduce_instruction_file", None)
    if rf:
        txt = Path(rf).read_text(encoding="utf-8").strip()
    return txt


def _run_tree_reduce(
    *,
    store: FleetStore,
    cid: str,
    art_dir: Path,
    source_pairs: list[tuple[str, str]],
    reduce_instruction: str,
    reduce_model: str,
    args: argparse.Namespace,
    max_chunk_chars: int = 96000,
    parse_json: bool = False,
) -> dict[str, Any]:
    """Recursively reduce map outputs in zero-tool synthesis waves until one final synthesis remains."""
    if not source_pairs:
        return {"ok": False, "error": "no completed map outputs to reduce", "levels": 0, "output": ""}
    prompts_dir = art_dir / "campaigns" / cid / "prompts"
    prompts_dir.mkdir(parents=True, exist_ok=True)
    current = list(source_pairs)
    level = 0
    last_job_id = ""
    while True:
        level += 1
        chunks: list[list[tuple[str, str]]] = []
        cur_chunk: list[tuple[str, str]] = []
        cur_len = 0
        for label, body in current:
            blen = len(body) + len(label) + 40
            if cur_chunk and (cur_len + blen > max_chunk_chars):
                chunks.append(cur_chunk)
                cur_chunk = []
                cur_len = 0
            cur_chunk.append((label, body))
            cur_len += blen
        if cur_chunk:
            chunks.append(cur_chunk)

        is_final = len(chunks) == 1
        rows: list[dict[str, Any]] = []
        chunk_ids: list[str] = []
        for idx, ch in enumerate(chunks, 1):
            body = "\n\n".join(f"=== PART {lbl} ===\n{txt}" for lbl, txt in ch)
            if is_final:
                prompt = f"{reduce_instruction}\n\n{body}"
                tag = "reduce-final"
            else:
                prompt = (
                    "INTERMEDIATE MERGE STEP: Consolidate and deduplicate the partial worker outputs below "
                    "while preserving ALL concrete findings, IDs, metrics, and evidence verbatim for the final synthesis.\n"
                    f"Target rubric:\n{reduce_instruction}\n\n{body}"
                )
                tag = f"reduce-L{level}-{idx:03d}"
            digest = hashlib.sha256(f"{tag}:{body[:2048]}:{len(body)}".encode("utf-8")).hexdigest()[:8]
            jid = sanitize_id(f"{tag}-{digest}", 64)
            p_file = prompts_dir / f"{jid}.txt"
            p_file.write_text(prompt, encoding="utf-8")
            rows.append(
                {
                    "id": jid,
                    "name": tag,
                    "stage": "reduce",
                    "action": "ask",
                    "model": reduce_model,
                    "cwd": str(art_dir),
                    "prompt_path": str(p_file),
                    "verify_cmd": None,
                    "confined": 0,
                    "max_attempts": 3,
                    "priority": 1000 - level * 10 - idx,
                }
            )
            chunk_ids.append(jid)

        store.enqueue_jobs(cid, rows)
        red_ns = _build_run_namespace(
            campaign=cid,
            preset="synthesis",
            read_concurrency=getattr(args, "read_concurrency", None) or 4,
            write_concurrency=1,
            stall_timeout=getattr(args, "stall_timeout", None) or 90,
            wall_timeout=getattr(args, "wall_timeout", None) or 240,
            max_retries=int(getattr(args, "max_retries", 2)),
            min_free_ram_mb=float(getattr(args, "min_free_ram_mb", 1500.0)),
            min_free_root_gb=float(getattr(args, "min_free_root_gb", 8.0)),
            empty_cwd=True,
            no_tools_guard=True,
            max_tool_calls=0,
            max_usd=float(getattr(args, "max_usd", 0.0) or 0.0),
            retry_wall_timeouts=bool(getattr(args, "retry_wall_timeouts", False)),
            checkpoint_path=getattr(args, "checkpoint_path", None),
            checkpoint_jsonl=getattr(args, "checkpoint_jsonl", None),
            retry_failed=bool(getattr(args, "retry_failed", False)),
            cursor_bin=getattr(args, "cursor_bin", None),
            db_path=str(store.db_path),
            artifact_dir=str(art_dir),
            allow_any_model=bool(getattr(args, "allow_any_model", False)),
            quiet=bool(getattr(args, "quiet", False)),
            suppress_stdout=True,
        )
        cmd_run(red_ns)
        exp = store.export_campaign(cid)
        by_id = {j["id"]: j for j in exp["jobs"]}
        next_pairs: list[tuple[str, str]] = []
        for jid in chunk_ids:
            j = by_id.get(jid) or {}
            out_txt = ""
            if j.get("output_path") and Path(j["output_path"]).is_file():
                out_txt = Path(j["output_path"]).read_text(encoding="utf-8", errors="replace")
            if j.get("status") == "done":
                next_pairs.append((jid, out_txt))
        if is_final:
            last_job_id = chunk_ids[0]
            j_fin = by_id.get(last_job_id) or {}
            fin_txt = next_pairs[0][1] if next_pairs else ""
            return {
                "ok": j_fin.get("status") == "done",
                "job_id": last_job_id,
                "model": j_fin.get("resolved_model") or reduce_model,
                "levels": level,
                "wall_s": j_fin.get("wall_s"),
                "output_path": j_fin.get("output_path"),
                "output": fin_txt,
                "parsed": extract_json_payload(fin_txt) if parse_json else None,
                "error": j_fin.get("error"),
            }
        if not next_pairs or len(next_pairs) >= len(current):
            # Guard against non-shrinking loop if chunks couldn't shrink further
            return {
                "ok": False,
                "error": f"tree-reduce stopped at level {level} with {len(next_pairs)} outputs",
                "levels": level,
                "output": "\n\n".join(txt for _, txt in next_pairs),
            }
        current = next_pairs


DEFAULT_RACE_STRATEGIES = [
    "Minimal Surgical Fix: make the smallest, lowest-risk change that satisfies every requirement and test cleanly.",
    "Algorithmic & Performance Focus: optimize hot paths, eliminate redundant work/allocations, and preserve 100% correctness.",
    "Clean Refactor & Edge-Case Hardening: structure cleanly with explicit boundary checks and thorough unit tests.",
    "Data-Structure & Caching Redesign: rethink internal data structures or caching to maximize throughput cleanly.",
]


def _inspect_patch_stats(patch_path: str | None) -> tuple[int, int, int]:
    if not patch_path or not Path(patch_path).is_file():
        return 0, 0, 0
    txt = Path(patch_path).read_text(encoding="utf-8", errors="replace")
    added = sum(1 for ln in txt.splitlines() if ln.startswith("+") and not ln.startswith("+++"))
    removed = sum(1 for ln in txt.splitlines() if ln.startswith("-") and not ln.startswith("---"))
    return len(txt.encode("utf-8")), added, removed


def rank_race_candidates(
    results: list[dict[str, Any]],
    *,
    verify_required: bool = True,
    score_regex: str | None = None,
    score_goal: str = "min",
) -> dict[str, Any]:
    """Deterministically rank Best-of-N worktree candidates by pass, patch presence, score, diff size, and speed."""
    pat = re.compile(score_regex) if score_regex else None
    goal = str(score_goal or "min").strip().lower()
    ranked: list[dict[str, Any]] = []

    for r in results:
        pbytes, added, removed = _inspect_patch_stats(r.get("patch_path"))
        diff_lines = added + removed
        verify_rc: int | None = None
        scope_confined: bool | None = None
        v_out = ""
        v_err = ""
        if r.get("receipt_path") and Path(r["receipt_path"]).is_file():
            try:
                rcpt = json.loads(Path(r["receipt_path"]).read_text(encoding="utf-8"))
                verify_rc = rcpt.get("verify_exit_code")
                scope_confined = rcpt.get("scope_confined")
                v_out = str(rcpt.get("verify_stdout_tail") or "")
                v_err = str(rcpt.get("verify_stderr_tail") or "")
            except Exception:
                pass

        passed = (r.get("status") == "done") and ((not verify_required) or (verify_rc == 0))
        non_empty = pbytes > 0
        score_val: float | None = None
        if pat is not None:
            haystack = v_out + "\n" + v_err + "\n" + str(r.get("output") or "")
            matches = pat.findall(haystack)
            if matches:
                last_m = matches[-1]
                raw_num = last_m[0] if isinstance(last_m, tuple) else last_m
                try:
                    score_val = float(raw_num)
                except ValueError:
                    score_val = None

        ranked.append(
            {
                "id": r.get("id"),
                "name": r.get("name"),
                "model": r.get("model"),
                "status": r.get("status"),
                "passed": passed,
                "verify_exit_code": verify_rc,
                "scope_confined": scope_confined,
                "score": score_val,
                "patch_bytes": pbytes,
                "diff_added": added,
                "diff_removed": removed,
                "diff_lines": diff_lines,
                "wall_s": float(r.get("wall_s") or 0.0),
                "tool_calls": int(r.get("tool_calls") or 0),
                "patch_path": r.get("patch_path"),
                "receipt_path": r.get("receipt_path"),
                "error": r.get("error"),
            }
        )

    def _sort_key(c: dict[str, Any]) -> tuple[Any, ...]:
        has_score = c["score"] is not None
        if pat is not None:
            if has_score:
                score_ord = float(c["score"]) if goal == "min" else -float(c["score"])
            else:
                score_ord = float("inf")
        else:
            score_ord = 0.0
        return (
            0 if c["passed"] else 1,
            0 if c["patch_bytes"] > 0 else 1,
            0 if (pat is None or has_score) else 1,
            score_ord,
            c["diff_lines"] if c["diff_lines"] > 0 else 10**9,
            c["wall_s"],
        )

    ranked.sort(key=_sort_key)
    for idx, c in enumerate(ranked, 1):
        c["rank"] = idx

    winner = ranked[0] if (ranked and ranked[0]["passed"] and ranked[0]["patch_bytes"] > 0) else None
    return {
        "winner": winner,
        "passed_count": sum(1 for c in ranked if c["passed"]),
        "total_candidates": len(ranked),
        "score_goal": goal if pat is not None else None,
        "leaderboard": ranked,
    }


def cmd_race(args: argparse.Namespace) -> int:
    cwd = Path(args.cwd or os.getcwd()).resolve()
    prompt_base = str(args.prompt or "").strip()
    if args.prompt_file:
        prompt_base = Path(args.prompt_file).read_text(encoding="utf-8").strip()
    if not prompt_base:
        print(json.dumps({"ok": False, "error": "--prompt or --prompt-file is required for `race`"}))
        return 1

    raw_models = [m.strip() for m in str(args.models or "").split(",") if m.strip()]
    allow_any = bool(args.allow_any_model) or bool(raw_models)
    raw_strats = [s.strip() for s in (args.strategies or []) if s.strip()]

    candidates: list[tuple[str, str, str]] = []  # (label, model, strategy)
    if raw_models and raw_strats:
        for idx, (m_raw, strat) in enumerate(zip(raw_models, raw_strats), 1):
            m = resolve_fleet_model(m_raw, allow_any_model=allow_any)
            candidates.append((f"cand-{idx:02d}-{sanitize_id(m, 20)}", m, strat))
    elif raw_models:
        for idx, m_raw in enumerate(raw_models, 1):
            m = resolve_fleet_model(m_raw, allow_any_model=allow_any)
            strat = DEFAULT_RACE_STRATEGIES[(idx - 1) % len(DEFAULT_RACE_STRATEGIES)]
            candidates.append((f"cand-{idx:02d}-{sanitize_id(m, 20)}", m, strat))
    else:
        m = resolve_fleet_model(args.model or "high", allow_any_model=bool(args.allow_any_model))
        strats = raw_strats if raw_strats else DEFAULT_RACE_STRATEGIES[: max(1, int(args.n or 3))]
        for idx, strat in enumerate(strats, 1):
            candidates.append((f"cand-{idx:02d}", m, strat))

    cid = sanitize_id(
        args.campaign or f"race-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}",
        64,
    )
    rows_spec: list[dict[str, Any]] = []
    for idx, (label, model_str, strat) in enumerate(candidates, 1):
        full_prompt = (
            f"[TOURNAMENT CANDIDATE {idx}/{len(candidates)} — STRATEGY]\n{strat}\n\n"
            f"[OBJECTIVE]\n{prompt_base}\n\n"
            "Requirements:\n"
            "- Edit files directly in this isolated git worktree within your first 2-3 tool calls.\n"
            "- Do NOT spend turns running prolonged exploratory micro-benchmarks before writing your edit.\n"
            "- Keep the diff focused and clean.\n"
            + (f"- Run `{args.verify_cmd}` at most ONCE to confirm your edit passes, then finish immediately.\n" if args.verify_cmd else "")
        )
        digest = hashlib.sha256(f"{cid}:{idx}:{model_str}:{strat}".encode("utf-8")).hexdigest()[:8]
        jid = sanitize_id(f"{label}-{digest}", 64)
        rows_spec.append(
            {
                "id": jid,
                "name": label,
                "stage": "race",
                "action": "worktree",
                "model": model_str,
                "cwd": str(cwd),
                "prompt": full_prompt,
                "verify_cmd": args.verify_cmd,
                "confined": bool(args.confined),
                "priority": len(candidates) - idx,
            }
        )

    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    if args.dry_run:
        est = estimate_batch_cost([r["prompt"] for r in rows_spec], rows_spec[0]["model"])
        print(
            json.dumps(
                {
                    "ok": True,
                    "dry_run": True,
                    "campaign_id": cid,
                    "repo": str(cwd),
                    "confined": bool(args.confined),
                    "verify_cmd": args.verify_cmd,
                    "score_regex": args.score_regex,
                    "score_goal": args.score_goal,
                    "candidates": [{"id": r["id"], "model": r["model"], "name": r["name"]} for r in rows_spec],
                    "estimate": est,
                },
                indent=2,
            )
        )
        return 0

    prompts_dir = art_dir / "campaigns" / cid / "prompts"
    prompts_dir.mkdir(parents=True, exist_ok=True)
    store = FleetStore(db_path)
    store.ensure_campaign(cid, name=cid, config={"mode": "race", "repo": str(cwd), "verify_cmd": args.verify_cmd})
    db_rows = []
    for r in rows_spec:
        p_file = prompts_dir / f"{r['id']}.txt"
        p_file.write_text(r["prompt"], encoding="utf-8")
        db_rows.append(
            {
                "id": r["id"],
                "name": r["name"],
                "stage": "race",
                "action": "worktree",
                "model": r["model"],
                "cwd": r["cwd"],
                "prompt_path": str(p_file),
                "verify_cmd": r["verify_cmd"],
                "confined": 1 if r["confined"] else 0,
                "max_attempts": max(1, int(getattr(args, "max_retries", 1)) + 1),
                "priority": r["priority"],
            }
        )
    store.enqueue_jobs(cid, db_rows)

    run_ns = _build_run_namespace(
        campaign=cid,
        preset="patch",
        read_concurrency=getattr(args, "read_concurrency", None),
        write_concurrency=getattr(args, "write_concurrency", None) or min(6, len(rows_spec)),
        stall_timeout=getattr(args, "stall_timeout", None) or 90,
        wall_timeout=getattr(args, "wall_timeout", None) or 300,
        max_retries=int(getattr(args, "max_retries", 1)),
        min_free_ram_mb=float(getattr(args, "min_free_ram_mb", 1500.0)),
        min_free_root_gb=float(getattr(args, "min_free_root_gb", 8.0)),
        empty_cwd=False,
        no_tools_guard=False,
        max_tool_calls=getattr(args, "max_tool_calls", None),
        max_usd=float(getattr(args, "max_usd", 0.0) or 0.0),
        retry_wall_timeouts=bool(getattr(args, "retry_wall_timeouts", False)),
        checkpoint_path=getattr(args, "checkpoint_path", None),
        checkpoint_jsonl=getattr(args, "checkpoint_jsonl", None),
        retry_failed=bool(getattr(args, "retry_failed", False)),
        cursor_bin=getattr(args, "cursor_bin", None),
        db_path=str(db_path),
        artifact_dir=str(art_dir),
        allow_any_model=allow_any,
        quiet=bool(getattr(args, "quiet", False)),
        suppress_stdout=True,
    )
    cmd_run(run_ns)
    export_data = store.export_campaign(cid)
    results = _collect_campaign_outputs(export_data, parse_json=False)
    ranking = rank_race_candidates(
        results,
        verify_required=bool(args.verify_cmd),
        score_regex=args.score_regex,
        score_goal=args.score_goal,
    )
    winner = ranking["winner"]
    applied_winner = False
    apply_error = None
    if args.apply_winner and winner and winner.get("patch_path"):
        chk = subprocess.run(["git", "-C", str(cwd), "apply", "--check", winner["patch_path"]], capture_output=True, text=True)
        if chk.returncode == 0:
            ap = subprocess.run(["git", "-C", str(cwd), "apply", winner["patch_path"]], capture_output=True, text=True)
            applied_winner = ap.returncode == 0
            if not applied_winner:
                apply_error = ap.stderr.strip()
        else:
            apply_error = chk.stderr.strip()

    payload = {
        "ok": winner is not None,
        "campaign_id": cid,
        "repo": str(cwd),
        "winner": winner,
        "applied_winner": applied_winner,
        "apply_error": apply_error,
        "apply_cmd": f"cursor-fleet patches --campaign {cid} --apply {winner['id']} --repo {cwd}" if winner else None,
        "ranking": ranking,
        "summary": export_data["summary"],
    }
    if args.out:
        out_p = Path(args.out)
        out_p.parent.mkdir(parents=True, exist_ok=True)
        out_p.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")
    if args.report_md:
        md_lines = [
            f"# Worktree Tournament Report: `{cid}`",
            "",
            f"- **Repo:** `{cwd}` | **Verify:** `{args.verify_cmd or 'none'}` | **Confined (`bwrap`):** `{bool(args.confined)}`",
            f"- **Winner:** `{winner['id'] if winner else 'NONE'}` ({ranking['passed_count']}/{ranking['total_candidates']} passed)",
            f"- **Spend:** `${export_data['summary'].get('est_actual_usd', 0.0):.4f}` (~`{export_data['summary'].get('est_cursor_quota_pct', 0.0)}%` quota)",
            "",
            "| Rank | Candidate | Model | Passed | Score | Diff (+ / -) | Wall (s) | Confined |",
            "| ---: | :--- | :--- | :---: | ---: | :---: | ---: | :---: |",
        ]
        for c in ranking["leaderboard"]:
            sc = f"{c['score']}" if c["score"] is not None else "—"
            md_lines.append(
                f"| {c['rank']} | `{c['id']}` | `{c['model']}` | {'PASS' if c['passed'] else 'FAIL'} | {sc} | +{c['diff_added']}/-{c['diff_removed']} | {c['wall_s']} | {c['scope_confined']} |"
            )
        if winner:
            md_lines.extend(["", f"Apply winner: `{payload['apply_cmd']}`", ""])
        md_p = Path(args.report_md)
        md_p.parent.mkdir(parents=True, exist_ok=True)
        md_p.write_text("\n".join(md_lines), encoding="utf-8")

    print(json.dumps(payload, indent=2, ensure_ascii=False))
    return 0 if winner is not None else 1


DEFAULT_COUNCIL_JUDGE_PROMPT = (
    "You are the blind consensus judge for a multi-model review council. "
    "Each panelist below independently reviewed the same artifact without seeing the other panelists' responses.\n"
    "Synthesize their findings cleanly into:\n"
    "1. **Consensus Findings (>=2 panelists independently agree)** — highest confidence, cite which panelists agreed.\n"
    "2. **High-Value Unique Findings (1 panelist only)** — concrete issues worth checking.\n"
    "3. **Disagreements / Contradictions** — where panelists conflicted and why.\n"
    "4. **Prioritized Action Checklist** — concise, deduplicated next steps."
)


def cmd_council(args: argparse.Namespace) -> int:
    cwd = Path(args.cwd or os.getcwd()).resolve()
    prompt_base = str(args.prompt or "").strip()
    if args.prompt_file:
        prompt_base = Path(args.prompt_file).read_text(encoding="utf-8").strip()
    if not prompt_base:
        print(json.dumps({"ok": False, "error": "--prompt or --prompt-file is required for `council`"}))
        return 1

    max_file_bytes = max(1024, int((args.max_file_kb or 64) * 1024))
    inlined_blocks: list[str] = []
    for pattern in (args.files or []):
        p_obj = Path(pattern)
        matches = sorted(Path(p_obj.anchor).glob(str(p_obj.relative_to(p_obj.anchor)))) if p_obj.is_absolute() else sorted(cwd.glob(pattern))
        for m in matches:
            if not m.is_file():
                continue
            raw_bytes = m.read_bytes()
            body = raw_bytes[:max_file_bytes].decode("utf-8", errors="replace")
            if len(raw_bytes) > max_file_bytes:
                body += f"\n... [truncated at {max_file_bytes} bytes]"
            try:
                rel = str(m.resolve().relative_to(cwd))
            except ValueError:
                rel = str(m)
            inlined_blocks.append(f"FILE: {rel}\n```\n{body}\n```")

    full_prompt = prompt_base + ("\n\n" + "\n\n".join(inlined_blocks) if inlined_blocks else "")
    raw_models = [m.strip() for m in str(args.models or "grok-4.7-medium,grok-4.7-high,grok-4.7-xhigh").split(",") if m.strip()]
    panel_models = [resolve_fleet_model(m, allow_any_model=True) for m in raw_models]
    judge_model = resolve_fleet_model(args.judge_model or "high", allow_any_model=True)
    preset_name = args.preset or "synthesis"
    preset_cfg = FLEET_PRESETS.get(preset_name, {})
    action = str(args.action or preset_cfg.get("action") or "ask").strip().lower()

    cid = sanitize_id(
        args.campaign or f"council-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}",
        64,
    )
    rows_spec: list[dict[str, Any]] = []
    for idx, m_str in enumerate(panel_models, 1):
        digest = hashlib.sha256(f"{cid}:panel:{idx}:{m_str}".encode("utf-8")).hexdigest()[:8]
        jid = sanitize_id(f"panel-{idx:02d}-{sanitize_id(m_str, 24)}-{digest}", 64)
        rows_spec.append(
            {
                "id": jid,
                "name": f"panel-{idx:02d} ({m_str})",
                "stage": "panel",
                "action": action,
                "model": m_str,
                "cwd": str(cwd),
                "prompt": full_prompt,
                "priority": len(panel_models) - idx,
            }
        )

    db_path = Path(args.db_path) if args.db_path else default_db_path()
    art_dir = Path(args.artifact_dir) if args.artifact_dir else default_artifact_dir()
    if args.dry_run:
        est = estimate_batch_cost([r["prompt"] for r in rows_spec], panel_models[0])
        print(
            json.dumps(
                {
                    "ok": True,
                    "dry_run": True,
                    "campaign_id": cid,
                    "preset": preset_name,
                    "panel_models": panel_models,
                    "judge_model": None if args.no_judge else judge_model,
                    "estimate_panel": est,
                },
                indent=2,
            )
        )
        return 0

    prompts_dir = art_dir / "campaigns" / cid / "prompts"
    prompts_dir.mkdir(parents=True, exist_ok=True)
    store = FleetStore(db_path)
    store.ensure_campaign(cid, name=cid, config={"mode": "council", "panel_models": panel_models, "judge_model": None if args.no_judge else judge_model})
    db_rows = []
    for r in rows_spec:
        p_file = prompts_dir / f"{r['id']}.txt"
        p_file.write_text(r["prompt"], encoding="utf-8")
        db_rows.append(
            {
                "id": r["id"],
                "name": r["name"],
                "stage": "panel",
                "action": r["action"],
                "model": r["model"],
                "cwd": r["cwd"],
                "prompt_path": str(p_file),
                "verify_cmd": None,
                "confined": 0,
                "max_attempts": max(1, int(getattr(args, "max_retries", 2)) + 1),
                "priority": r["priority"],
            }
        )
    store.enqueue_jobs(cid, db_rows)

    panel_ns = _build_run_namespace(
        campaign=cid,
        preset=preset_name,
        read_concurrency=getattr(args, "read_concurrency", None) or len(panel_models),
        write_concurrency=1,
        stall_timeout=getattr(args, "stall_timeout", None) or 90,
        wall_timeout=getattr(args, "wall_timeout", None) or 360,
        max_retries=int(getattr(args, "max_retries", 2)),
        min_free_ram_mb=float(getattr(args, "min_free_ram_mb", 1500.0)),
        min_free_root_gb=float(getattr(args, "min_free_root_gb", 8.0)),
        empty_cwd=bool(getattr(args, "empty_cwd", False)),
        no_tools_guard=bool(getattr(args, "no_tools_guard", False)),
        max_tool_calls=getattr(args, "max_tool_calls", None),
        max_usd=float(getattr(args, "max_usd", 0.0) or 0.0),
        retry_wall_timeouts=bool(getattr(args, "retry_wall_timeouts", False)),
        checkpoint_path=getattr(args, "checkpoint_path", None),
        checkpoint_jsonl=getattr(args, "checkpoint_jsonl", None),
        retry_failed=bool(getattr(args, "retry_failed", False)),
        cursor_bin=getattr(args, "cursor_bin", None),
        db_path=str(db_path),
        artifact_dir=str(art_dir),
        allow_any_model=True,
        quiet=bool(getattr(args, "quiet", False)),
        suppress_stdout=True,
    )
    rc_panel = cmd_run(panel_ns)
    parse_json = bool(getattr(args, "parse_json", False))
    exp_panel = store.export_campaign(cid)
    panel_outputs = [r for r in _collect_campaign_outputs(exp_panel, parse_json=parse_json) if r.get("stage") == "panel"]
    done_panels = [r for r in panel_outputs if r.get("status") == "done"]

    judge_info: dict[str, Any] | None = None
    rc_judge = 0
    if not args.no_judge and done_panels:
        judge_rubric = str(args.judge_instruction or "").strip() or DEFAULT_COUNCIL_JUDGE_PROMPT
        blocks = [
            f"=== PANELIST {i} (model={r['model']}, wall={r['wall_s']}s) ===\n{r['output']}"
            for i, r in enumerate(done_panels, 1)
        ]
        judge_prompt = f"{judge_rubric}\n\n" + "\n\n".join(blocks)
        j_digest = hashlib.sha256(judge_prompt.encode("utf-8")).hexdigest()[:8]
        j_id = sanitize_id(f"judge-{sanitize_id(judge_model, 24)}-{j_digest}", 64)
        jp_file = prompts_dir / f"{j_id}.txt"
        jp_file.write_text(judge_prompt, encoding="utf-8")
        store.enqueue_jobs(
            cid,
            [
                {
                    "id": j_id,
                    "name": f"judge ({judge_model})",
                    "stage": "judge",
                    "action": "ask",
                    "model": judge_model,
                    "cwd": str(art_dir),
                    "prompt_path": str(jp_file),
                    "verify_cmd": None,
                    "confined": 0,
                    "max_attempts": 3,
                    "priority": 100,
                }
            ],
        )
        judge_ns = _build_run_namespace(
            campaign=cid,
            preset="synthesis",
            read_concurrency=1,
            write_concurrency=1,
            stall_timeout=getattr(args, "stall_timeout", None) or 90,
            wall_timeout=getattr(args, "wall_timeout", None) or 240,
            max_retries=2,
            min_free_ram_mb=float(getattr(args, "min_free_ram_mb", 1500.0)),
            min_free_root_gb=float(getattr(args, "min_free_root_gb", 8.0)),
            empty_cwd=True,
            no_tools_guard=True,
            max_tool_calls=0,
            max_usd=float(getattr(args, "max_usd", 0.0) or 0.0),
            retry_wall_timeouts=False,
            checkpoint_path=None,
            checkpoint_jsonl=None,
            retry_failed=False,
            cursor_bin=getattr(args, "cursor_bin", None),
            db_path=str(db_path),
            artifact_dir=str(art_dir),
            allow_any_model=True,
            quiet=bool(getattr(args, "quiet", False)),
            suppress_stdout=True,
        )
        rc_judge = cmd_run(judge_ns)
        exp_all = store.export_campaign(cid)
        all_outs = _collect_campaign_outputs(exp_all, parse_json=parse_json)
        j_rec = next((r for r in all_outs if r["id"] == j_id), None)
        if j_rec:
            judge_info = {
                "ok": j_rec["status"] == "done",
                "id": j_rec["id"],
                "model": j_rec["model"],
                "wall_s": j_rec["wall_s"],
                "output": j_rec["output"],
                "parsed": j_rec.get("parsed"),
            }
    else:
        exp_all = exp_panel

    min_pan = int(getattr(args, "min_panelists", 0) or 0)
    if min_pan > 0:
        panel_ok = len(done_panels) >= min_pan
    else:
        panel_ok = (len(done_panels) > 0) and (rc_panel == 0)
    judge_passed = True if args.no_judge else bool(judge_info and judge_info.get("ok"))
    ok = panel_ok and judge_passed
    degraded = (len(done_panels) < len(panel_models))
    payload = {
        "ok": ok,
        "degraded": degraded,
        "campaign_id": cid,
        "panel_models": panel_models,
        "judge": judge_info,
        "panelists": panel_outputs,
        "summary": exp_all["summary"],
    }
    if args.out:
        out_p = Path(args.out)
        out_p.parent.mkdir(parents=True, exist_ok=True)
        out_p.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")
    if args.report_md:
        md_p = Path(args.report_md)
        md_p.parent.mkdir(parents=True, exist_ok=True)
        md_p.write_text(render_campaign_markdown(exp_all, parse_json=parse_json), encoding="utf-8")

    stdout_obj = (
        {
            "ok": ok,
            "campaign_id": cid,
            "out": str(args.out),
            "report_md": str(args.report_md) if args.report_md else None,
            "panel_done": len(done_panels),
            "panel_total": len(panel_models),
            "judge_ok": judge_info["ok"] if judge_info else None,
            "summary": exp_all["summary"],
        }
        if args.out
        else payload
    )
    print(json.dumps(stdout_obj, indent=2, ensure_ascii=False))
    return 0 if ok else 1


def _eval_where_predicate(item: dict[str, Any], pred: dict[str, Any]) -> bool:
    if not isinstance(pred, dict):
        return False
    if "all" in pred and isinstance(pred["all"], list):
        return bool(pred["all"]) and all(isinstance(p, dict) and _eval_where_predicate(item, p) for p in pred["all"])
    if "any" in pred and isinstance(pred["any"], list):
        return any(isinstance(p, dict) and _eval_where_predicate(item, p) for p in pred["any"])
    field = str(pred.get("field") or "")
    val = item.get(field) if field else None
    if "eq" in pred and val != pred["eq"]:
        return False
    if "neq" in pred and val == pred["neq"]:
        return False
    if "in" in pred:
        if not isinstance(pred["in"], (list, tuple, set)) or val not in pred["in"]:
            return False
    if "not_in" in pred:
        if not isinstance(pred["not_in"], (list, tuple, set)) or val in pred["not_in"]:
            return False
    if "contains" in pred and str(pred["contains"]).lower() not in str(val or "").lower():
        return False
    if "truthy" in pred and bool(val) != _parse_bool(pred["truthy"], True):
        return False
    for op_name, cmp_fn in (
        ("gte", lambda a, b: a >= b),
        ("gt", lambda a, b: a > b),
        ("lte", lambda a, b: a <= b),
        ("lt", lambda a, b: a < b),
    ):
        if op_name in pred:
            try:
                if not cmp_fn(float(val), float(pred[op_name])):
                    return False
            except (TypeError, ValueError):
                return False
    return True


def _flatten_stage_results_to_items(results: list[dict[str, Any]]) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    for r in results:
        if r.get("status") != "done":
            continue
        parsed = r.get("parsed")
        if parsed is None:
            parsed = extract_json_payload(r.get("output") or "")
        if isinstance(parsed, list):
            for el in parsed:
                if isinstance(el, dict):
                    items.append(el)
                else:
                    items.append({"id": r["id"], "value": el})
        elif isinstance(parsed, dict):
            items.append(parsed)
        else:
            items.append({"id": r["id"], "output": r.get("output") or ""})
    return items


class _SafeFormatDict(dict):
    def __missing__(self, key: str) -> str:
        return "{" + key + "}"


def cmd_pipeline(args: argparse.Namespace) -> int:
    spec_path = Path(args.spec).resolve()
    if not spec_path.is_file():
        print(json.dumps({"ok": False, "error": f"pipeline spec not found: {spec_path}"}))
        return 1
    spec = json.loads(spec_path.read_text(encoding="utf-8"))
    pid = sanitize_id(args.campaign or spec.get("id") or spec_path.stem, 48)
    base_cwd = Path(args.cwd or spec.get("cwd") or spec_path.parent).resolve()
    db_path = Path(args.db_path or spec.get("db_path") or default_db_path())
    art_dir = Path(args.artifact_dir or spec.get("artifact_dir") or default_artifact_dir())
    pipe_dir = art_dir / "pipelines" / pid
    stages = spec.get("stages") or []
    if not isinstance(stages, list) or not stages:
        print(json.dumps({"ok": False, "error": "pipeline spec requires non-empty 'stages' list"}))
        return 1

    if args.dry_run:
        plan = [
            {
                "index": idx,
                "name": st.get("name") or f"stage-{idx}",
                "type": st.get("type"),
                "preset": st.get("preset"),
                "model": st.get("model"),
                "from_prev": bool(st.get("from_prev", False)),
            }
            for idx, st in enumerate(stages, 1)
        ]
        print(json.dumps({"ok": True, "dry_run": True, "pipeline_id": pid, "cwd": str(base_cwd), "stages": plan}, indent=2))
        return 0

    pipe_dir.mkdir(parents=True, exist_ok=True)
    prev_jsonl: Path | None = None
    prev_json: Path | None = None
    stage_reports: list[dict[str, Any]] = []
    overall_ok = True
    max_usd_default = float(args.max_usd if args.max_usd and args.max_usd > 0 else spec.get("max_usd", 0.0) or 0.0)

    for idx, st in enumerate(stages, 1):
        sname = sanitize_id(str(st.get("name") or f"s{idx}"), 24)
        stype = str(st.get("type") or "map").strip().lower()
        sdir = pipe_dir / f"s{idx:02d}_{sname}"
        sdir.mkdir(parents=True, exist_ok=True)
        scid = sanitize_id(f"{pid}-s{idx:02d}-{sname}", 64)
        scwd = str(Path(st.get("cwd") or base_cwd).resolve())

        if stype == "filter":
            if prev_jsonl is None or not prev_jsonl.is_file():
                overall_ok = False
                stage_reports.append({"stage": sname, "type": "filter", "ok": False, "error": "no previous stage items JSONL to filter"})
                break
            out_jsonl = sdir / "filtered.jsonl"
            if out_jsonl.exists():
                out_jsonl.unlink()
            if st.get("command"):
                # Shell-quote all substituted path variables (prevents injection & supports paths with spaces!)
                q_vars = {
                    "in_jsonl": shlex.quote(str(prev_jsonl)),
                    "out_jsonl": shlex.quote(str(out_jsonl)),
                    "stage_dir": shlex.quote(str(sdir)),
                    "prev_json": shlex.quote(str(prev_json or "")),
                    "cwd": shlex.quote(scwd),
                }
                cmd_str = _safe_template_sub(str(st["command"]), q_vars)
                f_rc, f_out, f_err, f_exc = _run_shell_bounded(cmd_str, Path(scwd), int(st.get("timeout_sec") or 180))
                in_cnt = sum(1 for ln in prev_jsonl.read_text(encoding="utf-8", errors="replace").splitlines() if ln.strip())
                out_cnt = sum(1 for ln in out_jsonl.read_text(encoding="utf-8", errors="replace").splitlines() if ln.strip()) if out_jsonl.is_file() else 0
                ok_f = (f_rc == 0) and out_jsonl.is_file()
                stage_reports.append(
                    {
                        "stage": sname,
                        "type": "filter",
                        "ok": ok_f,
                        "in_items": in_cnt,
                        "kept_items": out_cnt,
                        "out_jsonl": str(out_jsonl),
                        "error": f_exc if not ok_f else None,
                        "stdout_tail": f_out[-600:],
                        "stderr_tail": f_err[-400:],
                    }
                )
                if not ok_f:
                    overall_ok = False
                    break
            else:
                where = st.get("where") or {}
                in_items = []
                bad_lines = 0
                for ln in prev_jsonl.read_text(encoding="utf-8", errors="replace").splitlines():
                    if not ln.strip():
                        continue
                    try:
                        in_items.append(json.loads(ln))
                    except json.JSONDecodeError:
                        bad_lines += 1
                kept = [it for it in in_items if isinstance(it, dict) and _eval_where_predicate(it, where)]
                if st.get("limit"):
                    kept = kept[: int(st["limit"])]
                out_jsonl.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in kept) + ("\n" if kept else ""), encoding="utf-8")
                stage_reports.append(
                    {
                        "stage": sname,
                        "type": "filter",
                        "ok": True,
                        "in_items": len(in_items),
                        "bad_lines": bad_lines,
                        "kept_items": len(kept),
                        "out_jsonl": str(out_jsonl),
                    }
                )
            prev_jsonl = out_jsonl
            if stage_reports[-1]["kept_items"] == 0 and not _parse_bool(st.get("continue_on_empty"), False):
                overall_ok = False
                break

        elif stype in ("map", "audit", "patch"):
            stage_out = sdir / "stage_out.json"
            stage_md = sdir / "stage_report.md"
            stage_ckpt = sdir / "stage_checkpoint.json"
            if stage_out.exists():
                stage_out.unlink()
            stage_in_jsonl = st.get("items_jsonl")
            if _parse_bool(st.get("from_prev"), False) and prev_jsonl and prev_jsonl.is_file():
                if st.get("prompt_template"):
                    tmpl = str(st["prompt_template"])
                    templated_p = sdir / "templated_items.jsonl"
                    t_lines = []
                    for i_ln, raw_ln in enumerate(prev_jsonl.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
                        if not raw_ln.strip():
                            continue
                        try:
                            obj = json.loads(raw_ln)
                        except json.JSONDecodeError:
                            continue
                        if isinstance(obj, dict):
                            iid = sanitize_id(str(obj.get(st.get("id_field") or "id") or f"item-{i_ln:04d}"), 64)
                            rendered_p = _safe_template_sub(tmpl, obj)
                            t_lines.append(json.dumps({"id": iid, "task": rendered_p}, ensure_ascii=False))
                    templated_p.write_text("\n".join(t_lines) + ("\n" if t_lines else ""), encoding="utf-8")
                    stage_in_jsonl = str(templated_p)
                else:
                    stage_in_jsonl = str(prev_jsonl)

            map_ns = argparse.Namespace(
                cmd="map",
                instruction=st.get("instruction") or "Complete the task for each item cleanly.",
                instruction_file=st.get("instruction_file"),
                files=st.get("files"),
                inline_files=_parse_bool(st.get("inline_files"), False),
                max_file_kb=int(st.get("max_file_kb", 64)),
                items_jsonl=stage_in_jsonl,
                items_json=st.get("items_json"),
                stdin_items=False,
                id_field=str(st.get("id_field") or "id"),
                batch_size=int(st.get("batch_size") or 1),
                batch_max_chars=int(st.get("batch_max_chars") or 48000),
                campaign=scid,
                action=st.get("action") or ("worktree" if stype == "patch" else None),
                model=st.get("model"),
                cwd=scwd,
                verify_cmd=st.get("verify_cmd"),
                confined=_parse_bool(st.get("confined"), False),
                exclusions_file=st.get("exclusions_file"),
                forbidden=st.get("forbidden"),
                trajectories_file=st.get("trajectories_file"),
                max_trajectories=int(st.get("max_trajectories", 3)),
                parse_json=_parse_bool(st.get("parse_json"), True),
                reduce_instruction=st.get("reduce_instruction"),
                reduce_instruction_file=st.get("reduce_instruction_file"),
                reduce_model=st.get("reduce_model"),
                reduce_max_chunk_chars=int(st.get("reduce_max_chunk_chars", 96000)),
                reduce_out=str(sdir / "reduced.txt") if (st.get("reduce_instruction") or st.get("reduce_instruction_file")) else None,
                out=str(stage_out),
                report_md=str(stage_md),
                dry_run=False,
                preset=st.get("preset") or ("patch" if stype == "patch" else ("audit" if stype == "audit" else "synthesis")),
                read_concurrency=st.get("read_concurrency"),
                write_concurrency=st.get("write_concurrency"),
                stall_timeout=st.get("stall_timeout"),
                wall_timeout=st.get("wall_timeout"),
                max_retries=int(st.get("max_retries", 2)),
                min_free_ram_mb=float(st.get("min_free_ram_mb", 1500.0)),
                min_free_root_gb=float(st.get("min_free_root_gb", 8.0)),
                empty_cwd=_parse_bool(st.get("empty_cwd"), False),
                no_tools_guard=_parse_bool(st.get("no_tools_guard"), False),
                max_tool_calls=st.get("max_tool_calls"),
                max_usd=float(st.get("max_usd", max_usd_default) or 0.0),
                retry_wall_timeouts=_parse_bool(st.get("retry_wall_timeouts"), False),
                checkpoint_path=str(stage_ckpt),
                checkpoint_jsonl=None,
                retry_failed=bool(args.retry_failed),
                allow_any_model=_parse_bool(st.get("allow_any_model"), bool(args.allow_any_model)),
                quiet=bool(args.quiet),
                cursor_bin=args.cursor_bin,
                db_path=str(db_path),
                artifact_dir=str(art_dir),
            )
            # Capture cmd_map stdout quietly so pipeline emits a single clean summary JSON
            old_stdout = sys.stdout
            import io
            buf = io.StringIO()
            sys.stdout = buf
            try:
                rc_s = cmd_map(map_ns)
            finally:
                sys.stdout = old_stdout
            s_data = json.loads(stage_out.read_text(encoding="utf-8")) if stage_out.is_file() else {"ok": False}
            flat_items = _flatten_stage_results_to_items([r for r in (s_data.get("results") or []) if r.get("stage") == "map"])
            next_jsonl = sdir / "items_out.jsonl"
            next_jsonl.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in flat_items) + ("\n" if flat_items else ""), encoding="utf-8")
            prev_jsonl = next_jsonl
            prev_json = stage_out
            stage_reports.append(
                {
                    "stage": sname,
                    "type": stype,
                    "campaign_id": scid,
                    "ok": rc_s == 0,
                    "items_emitted": len(flat_items),
                    "out": str(stage_out),
                    "items_jsonl": str(next_jsonl),
                    "summary": s_data.get("summary"),
                }
            )
            if rc_s != 0 and not st.get("continue_on_error"):
                overall_ok = False
                break

        elif stype == "race":
            stage_out = sdir / "race_out.json"
            stage_md = sdir / "race_report.md"
            race_ns = argparse.Namespace(
                cmd="race",
                campaign=scid,
                cwd=scwd,
                prompt=st.get("prompt"),
                prompt_file=st.get("prompt_file"),
                model=st.get("model"),
                models=",".join(st["models"]) if isinstance(st.get("models"), list) else st.get("models"),
                strategies=st.get("strategies"),
                n=int(st.get("n", 3)),
                verify_cmd=st.get("verify_cmd"),
                confined=bool(st.get("confined", False)),
                score_regex=st.get("score_regex"),
                score_goal=str(st.get("score_goal") or "min"),
                apply_winner=bool(st.get("apply_winner", False)),
                out=str(stage_out),
                report_md=str(stage_md),
                dry_run=False,
                preset="patch",
                read_concurrency=None,
                write_concurrency=st.get("write_concurrency"),
                stall_timeout=st.get("stall_timeout"),
                wall_timeout=st.get("wall_timeout"),
                max_retries=int(st.get("max_retries", 1)),
                min_free_ram_mb=1500.0,
                min_free_root_gb=8.0,
                empty_cwd=False,
                no_tools_guard=False,
                max_tool_calls=st.get("max_tool_calls"),
                max_usd=float(st.get("max_usd", max_usd_default) or 0.0),
                retry_wall_timeouts=False,
                checkpoint_path=None,
                checkpoint_jsonl=None,
                retry_failed=bool(args.retry_failed),
                allow_any_model=bool(st.get("allow_any_model", args.allow_any_model)),
                quiet=bool(args.quiet),
                cursor_bin=args.cursor_bin,
                db_path=str(db_path),
                artifact_dir=str(art_dir),
            )
            old_stdout = sys.stdout
            import io
            sys.stdout = io.StringIO()
            try:
                rc_s = cmd_race(race_ns)
            finally:
                sys.stdout = old_stdout
            s_data = json.loads(stage_out.read_text(encoding="utf-8")) if stage_out.is_file() else {"ok": False}
            prev_json = stage_out
            stage_reports.append({"stage": sname, "type": "race", "campaign_id": scid, "ok": rc_s == 0, "winner": s_data.get("winner"), "out": str(stage_out)})
            if rc_s != 0 and not st.get("continue_on_error"):
                overall_ok = False
                break

        elif stype == "council":
            stage_out = sdir / "council_out.json"
            stage_md = sdir / "council_report.md"
            c_prompt = str(st.get("prompt") or "")
            if st.get("from_prev") and prev_jsonl and prev_jsonl.is_file():
                c_prompt = (c_prompt + "\n\n" if c_prompt else "") + prev_jsonl.read_text(encoding="utf-8")[:60000]
            council_ns = argparse.Namespace(
                cmd="council",
                campaign=scid,
                cwd=scwd,
                prompt=c_prompt,
                prompt_file=st.get("prompt_file"),
                files=st.get("files"),
                max_file_kb=int(st.get("max_file_kb", 64)),
                models=",".join(st["models"]) if isinstance(st.get("models"), list) else st.get("models"),
                judge_model=st.get("judge_model"),
                judge_instruction=st.get("judge_instruction"),
                no_judge=bool(st.get("no_judge", False)),
                action=st.get("action"),
                parse_json=bool(st.get("parse_json", False)),
                out=str(stage_out),
                report_md=str(stage_md),
                dry_run=False,
                preset=st.get("preset") or "synthesis",
                read_concurrency=st.get("read_concurrency"),
                write_concurrency=1,
                stall_timeout=st.get("stall_timeout"),
                wall_timeout=st.get("wall_timeout"),
                max_retries=int(st.get("max_retries", 2)),
                min_free_ram_mb=1500.0,
                min_free_root_gb=8.0,
                empty_cwd=False,
                no_tools_guard=False,
                max_tool_calls=st.get("max_tool_calls"),
                max_usd=float(st.get("max_usd", max_usd_default) or 0.0),
                retry_wall_timeouts=False,
                checkpoint_path=None,
                checkpoint_jsonl=None,
                retry_failed=bool(args.retry_failed),
                allow_any_model=True,
                quiet=bool(args.quiet),
                cursor_bin=args.cursor_bin,
                db_path=str(db_path),
                artifact_dir=str(art_dir),
            )
            old_stdout = sys.stdout
            import io
            sys.stdout = io.StringIO()
            try:
                rc_s = cmd_council(council_ns)
            finally:
                sys.stdout = old_stdout
            s_data = json.loads(stage_out.read_text(encoding="utf-8")) if stage_out.is_file() else {"ok": False}
            prev_json = stage_out
            stage_reports.append({"stage": sname, "type": "council", "campaign_id": scid, "ok": rc_s == 0, "out": str(stage_out), "summary": s_data.get("summary")})
            if rc_s != 0 and not st.get("continue_on_error"):
                overall_ok = False
                break
        else:
            overall_ok = False
            stage_reports.append({"stage": sname, "type": stype, "ok": False, "error": f"unsupported stage type: {stype}"})
            break

    total_usd = round(
        sum(float((sr.get("summary") or {}).get("est_actual_usd") or 0.0) for sr in stage_reports),
        6,
    )
    pipe_summary = {
        "ok": overall_ok,
        "pipeline_id": pid,
        "spec": str(spec_path),
        "total_est_usd": total_usd,
        "est_cursor_quota_pct": round(total_usd / CURSOR_USD_PER_1PCT, 2),
        "stages": stage_reports,
        "final_items_jsonl": str(prev_jsonl) if prev_jsonl else None,
        "final_json": str(prev_json) if prev_json else None,
    }
    summary_file = pipe_dir / "pipeline_summary.json"
    summary_file.write_text(json.dumps(pipe_summary, indent=2, ensure_ascii=False), encoding="utf-8")
    if args.out:
        op = Path(args.out)
        op.parent.mkdir(parents=True, exist_ok=True)
        op.write_text(json.dumps(pipe_summary, indent=2, ensure_ascii=False), encoding="utf-8")
    print(json.dumps(pipe_summary, indent=2, ensure_ascii=False))
    return 0 if overall_ok else 1


def _add_common_run_flags(p: argparse.ArgumentParser) -> None:
    p.add_argument(
        "--preset",
        choices=sorted(FLEET_PRESETS.keys()),
        default=None,
        help="Preset profile: synthesis, dataset (bulk low-tier 12x), blueprint (long specs), fast, audit, plan, patch",
    )
    p.add_argument("--read-concurrency", type=int, default=None)
    p.add_argument("--write-concurrency", type=int, default=None)
    p.add_argument("--stall-timeout", type=int, default=None)
    p.add_argument("--wall-timeout", type=int, default=None)
    p.add_argument(
        "--streaming-grace",
        type=int,
        default=None,
        help="Extra seconds granted past wall-timeout when active output streaming is in progress (default: 60; 0 disables)",
    )
    p.add_argument(
        "--timeout-fallback-model",
        default=None,
        help="On wall timeout, retry on a faster model ('auto' steps down tier ladder, or explicit model/tier like 'low')",
    )
    p.add_argument("--max-retries", type=int, default=2)
    p.add_argument("--min-free-ram-mb", type=float, default=1500.0)
    p.add_argument("--min-free-root-gb", type=float, default=8.0)
    p.add_argument("--empty-cwd", action="store_true", help="Run ask/plan jobs in isolated empty cwd + --workspace")
    p.add_argument("--no-tools-guard", action="store_true", help="Prepend single-turn NO_TOOLS banner on ask prompts")
    p.add_argument("--max-tool-calls", type=int, default=None, help="Kill worker immediately if tool_calls exceeds N (-1 disables)")
    p.add_argument("--max-usd", type=float, default=0.0, help="Halt spawning remaining workers once est_standard_usd reaches cap")
    p.add_argument("--retry-wall-timeouts", action="store_true", help="Retry jobs that hit wall timeout (disabled by default)")
    p.add_argument("--checkpoint-path", default=None, help="Atomic JSON export snapshot updated after each completed job")
    p.add_argument("--checkpoint-jsonl", default=None, help="Append-only fsynced JSONL log of completed jobs")
    p.add_argument("--retry-failed", action="store_true", help="Reset failed jobs back to pending before running")
    p.add_argument("--allow-any-model", action="store_true", help="Allow any valid cursor-agent model ID (composer, codex, claude, etc.)")
    p.add_argument("--quiet", action="store_true", help="Suppress per-job stderr progress lines")
    p.add_argument("--cursor-bin", default=None)
    p.add_argument("--state-dir", default=None, help="Shorthand directory for fleet.db, artifacts/, and <campaign>_checkpoint.json")
    p.add_argument("--db-path", default=None)
    p.add_argument("--artifact-dir", default=None)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="High-Throughput Cursor CLI / Grok 4.7+ Fleet Runner (zero-dep Python stdlib)"
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    doc = sub.add_parser("doctor", help="Verify cursor-agent auth, models, bwrap, and host headroom")
    doc.add_argument("--cursor-bin", default=None)
    doc.add_argument("--state-dir", default=None)
    doc.add_argument("--db-path", default=None)
    doc.add_argument("--artifact-dir", default=None)
    doc.add_argument("--fast", action="store_true", help="Skip live `cursor-agent models` query")
    doc.add_argument("--json", action="store_true")

    ask_p = sub.add_parser("ask", help="Zero-manifest one-shot parallel fan-out for inline prompts")
    ask_p.add_argument("prompts", nargs="*", help="One or more inline prompt strings")
    ask_p.add_argument("--prompt-file", default=None)
    ask_p.add_argument("--campaign", default=None)
    ask_p.add_argument("--action", choices=["ask", "plan", "worktree"], default=None)
    ask_p.add_argument("--model", default=None)
    ask_p.add_argument("--cwd", default=None)
    ask_p.add_argument("--verify-cmd", default=None)
    ask_p.add_argument("--confined", action="store_true")
    ask_p.add_argument("--parse-json", action="store_true", help="Extract JSON payloads from worker responses")
    ask_p.add_argument("--out", default=None, help="Write combined JSON envelope to path")
    ask_p.add_argument("--text-out", default=None, help="Write clean unwrapped raw text/Markdown output directly to path")
    ask_p.add_argument("--report-md", default=None, help="Write combined Markdown report to path")
    ask_p.add_argument("--dry-run", action="store_true", help="Estimate tokens & cost without running workers")
    _add_common_run_flags(ask_p)

    map_p = sub.add_parser("map", help="Zero-manifest parallel map-reduce over files, JSONL, JSON, or stdin")
    map_p.add_argument("--instruction", default=None, help="Static instruction applied to every batch")
    map_p.add_argument("--instruction-file", default=None, help="Read static instruction from file")
    map_p.add_argument("--files", action="append", default=None, help="Glob pattern of files to map (repeatable)")
    map_p.add_argument("--inline-files", action="store_true", help="Inline file contents directly into prompts (default on synthesis/dataset/blueprint/fast presets)")
    map_p.add_argument("--max-file-kb", type=int, default=64, help="Per-file inline cap in KiB (default 64)")
    map_p.add_argument("--items-jsonl", default=None, help="JSONL file of items to batch across workers")
    map_p.add_argument("--items-json", default=None, help="JSON array file of items to batch across workers")
    map_p.add_argument("--stdin-items", action="store_true", help="Read newline-delimited items from stdin")
    map_p.add_argument("--id-field", default="id", help="Field name for item IDs in JSON/JSONL (default: id)")
    map_p.add_argument("--batch-size", type=int, default=1, help="Items packed per worker (empirical sweet spot: 4 for synthesis)")
    map_p.add_argument("--batch-max-chars", type=int, default=48000, help="Max payload chars per batch before splitting")
    map_p.add_argument("--reduce-instruction", default=None, help="Enable automatic recursive tree-reduce synthesis over map outputs")
    map_p.add_argument("--reduce-instruction-file", default=None, help="Read reduce instruction from file")
    map_p.add_argument("--reduce-model", default=None, help="Model for reduce stage (default: same as map model)")
    map_p.add_argument("--reduce-max-chunk-chars", type=int, default=96000, help="Max chars per tree-reduce chunk")
    map_p.add_argument("--reduce-out", default=None, help="Write final reduced synthesis text to path")
    map_p.add_argument("--campaign", default=None, help="Stable campaign ID for crash-safe resume")
    map_p.add_argument("--action", choices=["ask", "plan", "worktree"], default=None)
    map_p.add_argument("--model", default=None)
    map_p.add_argument("--cwd", default=None)
    map_p.add_argument("--verify-cmd", default=None)
    map_p.add_argument("--confined", action="store_true")
    map_p.add_argument("--exclusions-file", default=None)
    map_p.add_argument("--forbidden", action="append", default=None)
    map_p.add_argument("--trajectories-file", default=None)
    map_p.add_argument("--max-trajectories", type=int, default=3)
    map_p.add_argument("--parse-json", action="store_true", help="Extract JSON payloads from worker responses")
    map_p.add_argument("--out", default=None, help="Write combined JSON results to path")
    map_p.add_argument("--text-out", default=None, help="Write clean concatenated raw outputs to path")
    map_p.add_argument("--report-md", default=None, help="Write combined Markdown report to path")
    map_p.add_argument("--dry-run", action="store_true", help="Estimate batch count, tokens & cost without running workers")
    _add_common_run_flags(map_p)

    race_p = sub.add_parser("race", help="Best-of-N parallel isolated worktree tournament with deterministic ranking")
    race_p.add_argument("--prompt", default=None, help="Shared objective for all competing worktree candidates")
    race_p.add_argument("--prompt-file", default=None)
    race_p.add_argument("--cwd", default=None, help="Target git repo directory (default: cwd)")
    race_p.add_argument("--n", type=int, default=3, help="Number of competing worktrees (when --strategies/--models not set)")
    race_p.add_argument("--strategies", action="append", default=None, help="Strategy lens for a candidate (repeatable)")
    race_p.add_argument("--model", default="high", help="Model for homogeneous race (default: high)")
    race_p.add_argument("--models", default=None, help="Comma-separated models to race head-to-head (e.g. grok-4.7-high,composer-2.5)")
    race_p.add_argument("--verify-cmd", default=None, help="Verification / benchmark command run in each isolated worktree")
    race_p.add_argument("--confined", action="store_true", help="Run verify-cmd inside network-isolated Linux bwrap confinement")
    race_p.add_argument("--score-regex", default=None, help="Regex with numeric capture group from verify output to rank candidates")
    race_p.add_argument("--score-goal", choices=["min", "max"], default="min", help="Whether lower (min) or higher (max) score wins")
    race_p.add_argument("--apply-winner", action="store_true", help="Auto-apply winning verified patch to --cwd via git apply")
    race_p.add_argument("--campaign", default=None)
    race_p.add_argument("--out", default=None)
    race_p.add_argument("--report-md", default=None)
    race_p.add_argument("--dry-run", action="store_true")
    _add_common_run_flags(race_p)

    cn_p = sub.add_parser("council", help="Blind multi-model council review with consensus judge synthesis")
    cn_p.add_argument("--prompt", default=None, help="Review prompt shared across all panelists")
    cn_p.add_argument("--prompt-file", default=None)
    cn_p.add_argument("--files", action="append", default=None, help="Files to inline into the shared council brief")
    cn_p.add_argument("--max-file-kb", type=int, default=64)
    cn_p.add_argument("--models", default="grok-4.7-medium,grok-4.7-high,grok-4.7-xhigh", help="Comma-separated panelist models")
    cn_p.add_argument("--judge-model", default="high", help="Model for blind consensus judge (default: high)")
    cn_p.add_argument("--judge-instruction", default=None, help="Override default consensus/unique/contradictions judge rubric")
    cn_p.add_argument("--no-judge", action="store_true", help="Skip judge synthesis and return raw blind panelist outputs")
    cn_p.add_argument("--min-panelists", type=int, default=0, help="Succeed if at least N panelists complete (0 = require all)")
    cn_p.add_argument("--action", choices=["ask", "plan"], default=None)
    cn_p.add_argument("--cwd", default=None)
    cn_p.add_argument("--campaign", default=None)
    cn_p.add_argument("--parse-json", action="store_true")
    cn_p.add_argument("--out", default=None)
    cn_p.add_argument("--report-md", default=None)
    cn_p.add_argument("--dry-run", action="store_true")
    _add_common_run_flags(cn_p)

    pipe_p = sub.add_parser("pipeline", help="Run a declarative multi-stage funnel (map -> filter -> audit/patch/race/council)")
    pipe_p.add_argument("spec", help="Path to JSON pipeline specification")
    pipe_p.add_argument("--campaign", default=None, help="Override pipeline ID")
    pipe_p.add_argument("--cwd", default=None, help="Override base workspace directory")
    pipe_p.add_argument("--max-usd", type=float, default=0.0, help="Override per-stage USD budget cap")
    pipe_p.add_argument("--retry-failed", action="store_true")
    pipe_p.add_argument("--allow-any-model", action="store_true")
    pipe_p.add_argument("--quiet", action="store_true")
    pipe_p.add_argument("--out", default=None)
    pipe_p.add_argument("--dry-run", action="store_true")
    pipe_p.add_argument("--cursor-bin", default=None)
    pipe_p.add_argument("--state-dir", default=None)
    pipe_p.add_argument("--db-path", default=None)
    pipe_p.add_argument("--artifact-dir", default=None)

    enq = sub.add_parser("enqueue", help="Enqueue jobs from a JSONL manifest")
    enq.add_argument("--campaign", required=True)
    enq.add_argument("--manifest", required=True)
    enq.add_argument("--name", default=None)
    enq.add_argument("--state-dir", default=None)
    enq.add_argument("--db-path", default=None)
    enq.add_argument("--artifact-dir", default=None)
    enq.add_argument("--exclusions-file", default=None, help="JSON/text list of intended-design exclusions")
    enq.add_argument("--forbidden", action="append", default=None, help="Forbidden action rule (repeatable)")
    enq.add_argument("--trajectories-file", default=None, help="JSONL winning-trajectory exemplars")
    enq.add_argument("--max-trajectories", type=int, default=3)
    enq.add_argument("--allow-any-model", action="store_true")

    run_p = sub.add_parser("run", help="Drain pending jobs for a campaign")
    run_p.add_argument("--campaign", required=True)
    run_p.add_argument("--model", default=None, help="Optional model override applied to pending jobs before running")
    _add_common_run_flags(run_p)

    ret_p = sub.add_parser("retry", help="Reset failed or non-done campaign jobs (optionally switching model) and optionally re-run")
    ret_p.add_argument("--campaign", required=True)
    ret_p.add_argument("--model", default=None, help="Switch reset jobs to a new model/tier (e.g. low, high-fast, medium-fast)")
    ret_p.add_argument("--non-done", action="store_true", help="Reset ALL non-done jobs (failed + pending + stale running) instead of failed only")
    ret_p.add_argument("--job", action="append", default=None, help="Specific job ID to reset (repeatable)")
    ret_p.add_argument("--max-attempts", type=int, default=None, help="Override max_attempts on reset jobs")
    ret_p.add_argument("--run", action="store_true", help="Immediately drain the campaign after resetting jobs")
    _add_common_run_flags(ret_p)

    st = sub.add_parser("status", help="Show campaign progress and host headroom")
    st.add_argument("--campaign", default=None)
    st.add_argument("--json", action="store_true")
    st.add_argument("--state-dir", default=None)
    st.add_argument("--db-path", default=None)
    st.add_argument("--artifact-dir", default=None)

    ls_p = sub.add_parser("campaigns", aliases=["ls"], help="List campaigns in the fleet database")
    ls_p.add_argument("--limit", type=int, default=30)
    ls_p.add_argument("--json", action="store_true")
    ls_p.add_argument("--state-dir", default=None)
    ls_p.add_argument("--db-path", default=None)

    ins = sub.add_parser("inspect", help="Inspect jobs, errors, and outputs for a campaign")
    ins.add_argument("--campaign", required=True)
    ins.add_argument("--job", default=None)
    ins.add_argument("--failed-only", action="store_true")
    ins.add_argument("--show-output", action="store_true")
    ins.add_argument("--max-chars", type=int, default=2000)
    ins.add_argument("--json", action="store_true")
    ins.add_argument("--state-dir", default=None)
    ins.add_argument("--db-path", default=None)

    rep = sub.add_parser("report", help="Render combined Markdown or JSON report from campaign outputs")
    rep.add_argument("--campaign", required=True)
    rep.add_argument("--format", choices=["md", "json"], default="md")
    rep.add_argument("--parse-json", action="store_true")
    rep.add_argument("--out", default=None)
    rep.add_argument("--state-dir", default=None)
    rep.add_argument("--db-path", default=None)

    pat = sub.add_parser("patches", help="List, check, or apply harvested worktree patches")
    pat.add_argument("--campaign", required=True)
    pat.add_argument("--apply", default=None, help="Job ID or name whose patch to apply")
    pat.add_argument("--repo", default=None, help="Target git repo directory for --apply (default: cwd)")
    pat.add_argument("--check", action="store_true", help="Dry-run `git apply --check` without modifying files")
    pat.add_argument("--json", action="store_true")
    pat.add_argument("--state-dir", default=None)
    pat.add_argument("--db-path", default=None)

    exp = sub.add_parser("export", help="Export full campaign records to JSON")
    exp.add_argument("--campaign", required=True)
    exp.add_argument("--out", required=True)
    exp.add_argument("--state-dir", default=None)
    exp.add_argument("--db-path", default=None)

    rec = sub.add_parser("record-win", help="Append a verified winning trajectory exemplar")
    rec.add_argument("--campaign", default=None)
    rec.add_argument("--job-id", default=None)
    rec.add_argument("--target", required=True)
    rec.add_argument("--vuln-class", required=True)
    rec.add_argument("--summary", required=True)
    rec.add_argument("--step", action="append", default=None)
    rec.add_argument("--out", default=None)
    rec.add_argument("--state-dir", default=None)
    rec.add_argument("--db-path", default=None)
    rec.add_argument("--artifact-dir", default=None)

    pr = sub.add_parser("prune-worktrees", help="Prune leftover ~/.cursor/worktrees")
    pr.add_argument("--dry-run", action="store_true")

    return p


def _apply_state_dir(args: argparse.Namespace) -> None:
    """Resolve --state-dir shorthand into default db_path, artifact_dir, and checkpoint_path."""
    sd_raw = getattr(args, "state_dir", None)
    if not sd_raw:
        return
    sd = Path(sd_raw)
    if hasattr(args, "db_path") and not args.db_path:
        args.db_path = str(sd / "fleet.db")
    if hasattr(args, "artifact_dir") and not args.artifact_dir:
        args.artifact_dir = str(sd / "artifacts")
    if (
        hasattr(args, "checkpoint_path")
        and not args.checkpoint_path
        and getattr(args, "campaign", None)
    ):
        args.checkpoint_path = str(sd / f"{sanitize_id(str(args.campaign), 64)}_checkpoint.json")


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    _apply_state_dir(args)
    if args.cmd == "doctor":
        return cmd_doctor(args)
    if args.cmd == "ask":
        return cmd_ask(args)
    if args.cmd == "map":
        return cmd_map(args)
    if args.cmd == "race":
        return cmd_race(args)
    if args.cmd == "council":
        return cmd_council(args)
    if args.cmd == "pipeline":
        return cmd_pipeline(args)
    if args.cmd == "enqueue":
        return cmd_enqueue(args)
    if args.cmd == "run":
        return cmd_run(args)
    if args.cmd == "retry":
        return cmd_retry(args)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd in ("campaigns", "ls"):
        return cmd_campaigns(args)
    if args.cmd == "inspect":
        return cmd_inspect(args)
    if args.cmd == "report":
        return cmd_report(args)
    if args.cmd == "patches":
        return cmd_patches(args)
    if args.cmd == "export":
        return cmd_export(args)
    if args.cmd == "record-win":
        return cmd_record_win(args)
    if args.cmd == "prune-worktrees":
        return cmd_prune_worktrees(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
