#!/usr/bin/env python3
"""wm-tricameral — Sovereign Tricameral CyberBrain Composite Mind CLI (`0.00 CU`, Resident UNIX-Socket + URC).

Orchestrates the 3-Organ Sovereign CyberBrain Circuit inside `#![forbid(unsafe_code)]` Safe-Rust (`muninn-engine`):
  - Organ 0 (`System 0 / 0.5` Thought/Sentinel/Router): `Huginn-1 School-S3` (`25.24M` params, ~122 MB RSS)
  - Organ 1 (`System 1 / 1.5` Memory/Reflex): `Muninn-4 School-v2-S3` (`100.3M` params, ~357 MB RSS)
  - Organ 2 (`System 2` Formal Prover/Coder): `Valkyrie-M3` (`241.9M` unique / `383.6M` eff @ R=4)

Gracefully degrades if only Huginn-1 (`wm-models pull huginn`) or Ravens (`wm-models pull ravens`) are installed.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, Dict, List

MODELS_DIR = Path(os.environ.get("WM_MODELS_DIR", str(Path.home() / ".local" / "share" / "whitemagic" / "models")))
SOCK_DIR = Path(os.environ.get("WM_TRICAMERAL_SOCK_DIR", "/tmp"))
HUGINN_SOCK = SOCK_DIR / "wm_huginn.sock"
MUNINN_SOCK = SOCK_DIR / "wm_muninn.sock"


def resolve_engine_bin() -> Path:
    env_bin = os.environ.get("WM_TRICAMERAL_BIN")
    cands = [
        Path(env_bin).expanduser() if env_bin else None,
        Path(shutil.which("muninn-engine")) if shutil.which("muninn-engine") else None,
        Path.home() / ".local" / "bin" / "muninn-engine",
        Path(shutil.which("muninn_engine")) if shutil.which("muninn_engine") else None,
    ]
    for c in cands:
        if c and c.is_file() and os.access(c, os.X_OK):
            return c
    raise FileNotFoundError("Safe-Rust 'muninn-engine' binary not found. Run ./install.sh in whitemagic-agy-kit.")


def _model_search_dirs() -> List[Path]:
    dirs = [MODELS_DIR]
    extra = os.environ.get("WM_MODELS_EXTRA_DIRS", "")
    for part in extra.split(os.pathsep):
        if part.strip():
            dirs.append(Path(part.strip()).expanduser())
    return dirs


def find_optional_spore(names: List[str]) -> Path | None:
    for d in _model_search_dirs():
        for nm in names:
            p = d / nm
            if p.exists():
                return p
    return None


def send_unix_json(sock_path: Path, payload: Dict[str, Any], timeout: float = 20.0) -> Dict[str, Any]:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(str(sock_path))
        s.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf.decode("utf-8"))


def ensure_daemon(engine: Path, spore: Path, sock_path: Path) -> bool:
    if sock_path.exists():
        try:
            if send_unix_json(sock_path, {"cmd": "ping"}, timeout=1.5).get("status") == "ok":
                return True
        except Exception:
            sock_path.unlink(missing_ok=True)
    subprocess.Popen(
        [
            str(engine),
            "--weights", str(spore),
            "--shells", "3",
            "--r-loops", "2",
            "--rep-penalty", "1.0",
            "--prefill-chunk", "16",
            "--energy-halt", "0.95",
            "--daemon", str(sock_path),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.time() + 5.0
    while time.time() < deadline:
        if sock_path.exists():
            try:
                if send_unix_json(sock_path, {"cmd": "ping"}, timeout=1.0).get("status") == "ok":
                    return True
            except Exception:
                pass
        time.sleep(0.05)
    return False


def run_one(engine: Path, weights: Path, prompt: str, r_loops: int, shells: int, max_new: int, sock_path: Path | None = None, soft_prompt: str = "") -> Dict[str, Any]:
    req = {
        "id": "tri_q",
        "prompt": prompt,
        "max_new": max_new,
        "r_loops": r_loops,
        "shells": shells,
        "rep_penalty": 1.0,
        "soft_prompt": soft_prompt,
    }
    if sock_path is not None and not soft_prompt and ensure_daemon(engine, weights, sock_path):
        return send_unix_json(sock_path, req)
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as f:
        in_p = Path(f.name)
        f.write(json.dumps(req) + "\n")
    out_p = in_p.with_suffix(".out.jsonl")
    cmd = [
        str(engine),
        "--weights", str(weights),
        "--shells", str(shells),
        "--r-loops", str(r_loops),
        "--rep-penalty", "1.0",
        "--prefill-chunk", "16",
        "--energy-halt", "0.95",
        "--batch-jsonl", str(in_p),
        "--batch-out", str(out_p),
    ]
    subprocess.run(cmd, check=True, capture_output=True, text=True)
    row = json.loads(out_p.read_text(encoding="utf-8").splitlines()[0])
    in_p.unlink(missing_ok=True)
    out_p.unlink(missing_ok=True)
    return row


def main() -> None:
    ap = argparse.ArgumentParser(description="wm-tricameral: Huginn-1 -> Muninn-4 -> Valkyrie-M3 Composite Mind CLI")
    ap.add_argument("query", help="User or system task prompt")
    ap.add_argument("--max-new", type=int, default=40)
    ap.add_argument("--workflow", choices=["auto", "kekkai", "sutra"], default="auto", help="Chained execution preset")
    args = ap.parse_args()

    try:
        engine = resolve_engine_bin()
    except FileNotFoundError as exc:
        sys.stderr.write(f"wm-tricameral: {exc}\n")
        sys.exit(2)

    h_w = find_optional_spore(["huginn1_school_s3.tm7b", "huginn1_gpu_school_s3.tm7b", "huginn1_wsd_final.tm7b"])
    m_w = find_optional_spore(["muninn4_school_v2_s3.tm7b", "muninn4_gpu_school_s3.tm7b", "muninn4_wso_school_grad.tm7b", "muninn4_wso_plateau.tm7b"])
    v_w = find_optional_spore(["valkyrie_m3_leg2_school_s3.tm7b", "valkyrie_m3_leg2_wsd_final.tm7b", "valkyrie_m3_full_wsd_final.tm7b"])

    if h_w is None:
        sys.stderr.write(f"wm-tricameral: Huginn-1 spore missing in {MODELS_DIR}. Run: wm-models pull huginn\n")
        sys.exit(2)

    if args.workflow == "kekkai":
        k_row = run_one(engine, h_w, f"[VETO_NEG0] {args.query}\n[AST]", r_loops=2, shells=3, max_new=24, sock_path=HUGINN_SOCK)
        k_txt = k_row.get("gen_text", "").replace("[EOS]", "").strip()
        veto = ("[VETO_NEG0]" in k_txt) or ("REFUSE" in k_txt.upper()) or ("REJECT" in k_txt.upper())
        print(json.dumps({
            "workflow": "kekkai",
            "veto": veto,
            "organ": h_w.name,
            "elapsed_ms": round(float(k_row.get("elapsed_ms", 0.0)), 2),
            "conformal_pick_margin": round(float(k_row.get("pick_margin", 0.0)), 3),
            "output": k_txt,
        }, indent=2))
        return

    # Step 1: Huginn-1 System 0/0.5 Active Inference / EFE Routing
    r_row = run_one(engine, h_w, f"[ROUTE] [USR] {args.query}\n[AST]", r_loops=1, shells=2, max_new=20, sock_path=HUGINN_SOCK)
    r_txt = r_row.get("gen_text", "").replace("[EOS]", "").strip()
    r_ms = float(r_row.get("elapsed_ms", 0.0))

    tier = "S1"
    if "[ROUTE|HUGINN_S0]" in r_txt or "[TIER_S0]" in r_txt or "[EFE=LOW]" in r_txt or args.workflow == "sutra":
        tier = "S0"
    elif "[ROUTE|VALKYRIE_S2]" in r_txt or "[TIER_S2]" in r_txt or "[EFE=HIGH" in r_txt:
        tier = "S2"

    task_prompt = args.query if ("[AST]" in args.query) else f"[USR] {args.query}\n[AST]"
    if tier == "S2" and v_w is not None:
        e_row = run_one(engine, v_w, task_prompt, r_loops=2, shells=2, max_new=args.max_new)
        organ = f"Valkyrie-M3 ({v_w.name})"
    elif tier in ("S1", "S2") and m_w is not None:
        e_row = run_one(engine, m_w, task_prompt, r_loops=2, shells=3, max_new=args.max_new, sock_path=MUNINN_SOCK)
        organ = f"Muninn-4 ({m_w.name})"
    else:
        e_row = run_one(engine, h_w, task_prompt, r_loops=2, shells=3, max_new=args.max_new, sock_path=HUGINN_SOCK)
        organ = f"Huginn-1 ({h_w.name})"

    print(json.dumps({
        "routed_tier": tier,
        "router_organ": h_w.name,
        "router_decision": r_txt,
        "router_ms": round(r_ms, 2),
        "executing_organ": organ,
        "exec_ms": round(float(e_row.get("elapsed_ms", 0.0)), 2),
        "total_ms": round(r_ms + float(e_row.get("elapsed_ms", 0.0)), 2),
        "conformal_pick_margin": round(float(e_row.get("pick_margin", 0.0)), 3),
        "output": e_row.get("gen_text", "").replace("[EOS]", "").strip(),
    }, indent=2))


if __name__ == "__main__":
    main()
