#!/usr/bin/env python3
"""wm-muninn — Sovereign System 1 / 1.5 Hippocampal Memory, Session & File-Recall Organ CLI (`0.00 CU`, Resident UNIX-Socket + URC).

Backed by `Muninn-4 School-v2-S3` (`TM7B\\x05`, 896d/14h/2688ff/4c, 100.3M params, ~357 MB RSS, 1.313 MB `.hms`)
paired with `Huginn-1 School-S3` (`System 0.5` Conformal Co-Processor) inside Safe-Rust `muninn-engine --daemon`
with a 24-entry Unified Radix Cache (URC).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, Dict, List

MODELS_DIR = Path(os.environ.get("WM_MODELS_DIR", str(Path.home() / ".local" / "share" / "whitemagic" / "models")))
DEFAULT_HMS = Path(os.environ.get("WM_MUNINN_HMS", str(Path.home() / ".local" / "share" / "whitemagic" / "muninn4_hippocampus.hms")))
SOCK_DIR = Path(os.environ.get("WM_TRICAMERAL_SOCK_DIR", "/tmp"))
MUNINN_SOCK = SOCK_DIR / "wm_muninn.sock"
HUGINN_SOCK = SOCK_DIR / "wm_huginn.sock"


def resolve_engine_bin() -> Path:
    env_bin = os.environ.get("WM_TRICAMERAL_BIN")
    cands = [
        Path(env_bin).expanduser() if env_bin else None,
        Path(shutil.which("muninn-engine")) if shutil.which("muninn-engine") else None,
        Path.home() / ".local" / "bin" / "muninn-engine",
        Path(shutil.which("muninn_engine")) if shutil.which("muninn_engine") else None,
    ]
    for c in cands:
        if c and c.is_file() and os.access(c, os.X_OK):
            return c
    raise FileNotFoundError("Safe-Rust 'muninn-engine' binary not found. Run ./install.sh in whitemagic-agy-kit.")


def _model_search_dirs() -> List[Path]:
    dirs = [MODELS_DIR]
    extra = os.environ.get("WM_MODELS_EXTRA_DIRS", "")
    for part in extra.split(os.pathsep):
        if part.strip():
            dirs.append(Path(part.strip()).expanduser())
    return dirs


def resolve_spore(names: List[str], label: str, pull_hint: str) -> Path:
    for d in _model_search_dirs():
        for nm in names:
            p = d / nm
            if p.exists():
                return p
    raise FileNotFoundError(f"No {label} .tm7b spore found in {MODELS_DIR}. Pull weights with: wm-models pull {pull_hint}")


def send_unix_json(sock_path: Path, payload: Dict[str, Any], timeout: float = 20.0) -> Dict[str, Any]:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(str(sock_path))
        s.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf.decode("utf-8"))


def ensure_daemon(engine: Path, spore: Path, sock_path: Path) -> bool:
    if sock_path.exists():
        try:
            r = send_unix_json(sock_path, {"cmd": "ping"}, timeout=1.5)
            if r.get("status") == "ok":
                return True
        except Exception:
            sock_path.unlink(missing_ok=True)
    cmd = [
        str(engine),
        "--weights", str(spore),
        "--shells", "3",
        "--r-loops", "2",
        "--rep-penalty", "1.0",
        "--prefill-chunk", "16",
        "--energy-halt", "0.95",
        "--daemon", str(sock_path),
    ]
    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.time() + 6.0
    while time.time() < deadline:
        if sock_path.exists():
            try:
                r = send_unix_json(sock_path, {"cmd": "ping"}, timeout=1.0)
                if r.get("status") == "ok":
                    return True
            except Exception:
                pass
        time.sleep(0.05)
    return False


def stop_daemon(sock_path: Path) -> Dict[str, Any]:
    if not sock_path.exists():
        return {"status": "already_stopped", "socket": str(sock_path)}
    try:
        r = send_unix_json(sock_path, {"cmd": "shutdown"}, timeout=2.0)
    except Exception:
        r = {"status": "unlinked_stale"}
    sock_path.unlink(missing_ok=True)
    return r


def run_one(engine: Path, weights: Path, sock_path: Path, prompt: str, mac_6d: List[float], r_loops: int = 2, shells: int = 3, max_new: int = 36, save_hms: str = "", load_hms: str = "") -> Dict[str, Any]:
    req = {
        "id": "wm_muninn_q",
        "prompt": prompt,
        "max_new": max_new,
        "r_loops": r_loops,
        "shells": shells,
        "rep_penalty": 1.0,
        "mac_6d": mac_6d,
        "save_state": save_hms,
        "load_state": load_hms,
    }
    if ensure_daemon(engine, weights, sock_path):
        return send_unix_json(sock_path, req)
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as f:
        in_p = Path(f.name)
        f.write(json.dumps(req) + "\n")
    out_p = in_p.with_suffix(".out.jsonl")
    cmd = [
        str(engine),
        "--weights", str(weights),
        "--shells", str(shells),
        "--r-loops", str(r_loops),
        "--rep-penalty", "1.0",
        "--prefill-chunk", "16",
        "--energy-halt", "0.95",
        "--batch-jsonl", str(in_p),
        "--batch-out", str(out_p),
    ]
    subprocess.run(cmd, check=True, capture_output=True, text=True)
    row = json.loads(out_p.read_text(encoding="utf-8").splitlines()[0])
    in_p.unlink(missing_ok=True)
    out_p.unlink(missing_ok=True)
    return row


def main() -> None:
    ap = argparse.ArgumentParser(description="wm-muninn: 6-Layer Sovereign Hippocampal Memory & File-Recall CLI")
    ap.add_argument(
        "mode",
        choices=["crystallize", "reconcile", "sim-audit", "handoff", "exec-filter", "dream-teach", "daemon-status", "daemon-start", "daemon-stop"],
        help="Hippocampal execution layer",
    )
    ap.add_argument("query", nargs="?", default="", help="Input records, conflict trace, filter spec, or session delta")
    ap.add_argument("--key", default="active_state", help="Target key for crystallize/reconcile/handoff")
    ap.add_argument("--hms-path", default=str(DEFAULT_HMS), help="Path to persistent 1.31MB hippocampal .hms state")
    ap.add_argument("--max-new", type=int, default=36)
    args = ap.parse_args()

    if args.mode == "daemon-stop":
        print(json.dumps(stop_daemon(MUNINN_SOCK), indent=2))
        return

    try:
        engine = resolve_engine_bin()
        m_w = resolve_spore(
            ["muninn4_school_v2_s3.tm7b", "muninn4_gpu_school_s3.tm7b", "muninn4_wso_school_grad.tm7b", "muninn4_wso_plateau.tm7b"],
            "Muninn-4",
            "ravens",
        )
    except FileNotFoundError as exc:
        sys.stderr.write(f"wm-muninn: {exc}\n")
        sys.exit(2)

    try:
        h_w: Path | None = resolve_spore(
            ["huginn1_school_s3.tm7b", "huginn1_gpu_school_s3.tm7b", "huginn1_wsd_final.tm7b"],
            "Huginn-1",
            "huginn",
        )
    except FileNotFoundError:
        h_w = None

    if args.mode in ("daemon-status", "daemon-start"):
        ok = ensure_daemon(engine, m_w, MUNINN_SOCK)
        if not ok:
            sys.stderr.write("wm-muninn: failed to start daemon\n")
            sys.exit(1)
        print(json.dumps(send_unix_json(MUNINN_SOCK, {"cmd": "ping"}), indent=2))
        return

    if args.mode == "handoff":
        hms_p = Path(args.hms_path).expanduser()
        hms_p.parent.mkdir(parents=True, exist_ok=True)
        prompt = f"[UPD_ERASE] [MAC_GAL] L=+0.90 O=+0.00 T=+0.95 E=+0.85 V=+0.90 C=+0.80\n{args.query}\n[USR] What is the current active value of {args.key}?\n[AST]"
        row = run_one(
            engine, m_w, MUNINN_SOCK, prompt, [0.90, 0.0, 0.95, 0.85, 0.90, 0.80],
            r_loops=2, shells=3, max_new=args.max_new,
            save_hms=str(hms_p), load_hms=str(hms_p) if hms_p.exists() else "",
        )
        print(json.dumps({
            "organ": m_w.name,
            "mode": "handoff",
            "transport": "unix_socket_daemon",
            "hms_path": str(hms_p),
            "hologram_saved_bytes": row.get("hologram_saved_bytes", 0),
            "hologram_saved_mb": round(int(row.get("hologram_saved_bytes", 0)) / (1024.0 * 1024.0), 3),
            "elapsed_ms": row.get("elapsed_ms", 0.0),
            "output": row.get("gen_text", "").replace("[EOS]", "").strip(),
        }, indent=2))
        return

    if args.mode in ("crystallize", "reconcile"):
        prompt = f"[UPD_ERASE] [MAC_GAL] L=+0.90 O=+0.00 T=+0.95 E=+0.85 V=+0.90 C=+0.80\n{args.query}\n[USR] What is the current active value of {args.key}?\n[AST]"
        mac_6d = [0.90, 0.0, 0.95, 0.85, 0.90, 0.80]
    elif args.mode == "sim-audit":
        tag = "[VETO_NEG0]" if any(w in args.query.lower() for w in ["bypass", "ignore", "dump", ".env", "ssh"]) else "[CODE_RS]"
        prompt = f"{tag} {args.query}\n[AST]"
        mac_6d = [0.95, 0.0, 0.85, 0.95, 0.85, 0.90]
    elif args.mode == "exec-filter":
        prompt = f"[CODE_PY] {args.query}\n[AST]"
        mac_6d = [0.95, 0.0, 0.85, 0.95, 0.85, 0.90]
    else:
        prompt = f"[USR] {args.query}\n[AST]"
        mac_6d = [0.95, 0.0, 0.90, 1.00, 0.90, 0.95]

    m_row = run_one(engine, m_w, MUNINN_SOCK, prompt, mac_6d, r_loops=2, shells=3, max_new=args.max_new)
    m_txt = m_row.get("gen_text", "").replace("[EOS]", "").strip()
    m_margin = float(m_row.get("pick_margin", 0.0))
    m_ms = float(m_row.get("elapsed_ms", 0.0))
    urc_hit = int(m_row.get("urc_hit_tokens", 0))

    organ_used = m_w.name
    if h_w is not None and ("<think>" in m_txt or m_margin < 4.5):
        h_row = run_one(engine, h_w, HUGINN_SOCK, prompt, mac_6d, r_loops=2, shells=3, max_new=args.max_new)
        h_txt = h_row.get("gen_text", "").replace("[EOS]", "").strip()
        h_margin = float(h_row.get("pick_margin", 0.0))
        if h_margin > m_margin and "<think>" not in h_txt:
            m_txt = h_txt
            m_margin = h_margin
            m_ms += float(h_row.get("elapsed_ms", 0.0))
            organ_used = f"{m_w.name}+{h_w.name}(conformal)"

    print(json.dumps({
        "organ": organ_used,
        "mode": args.mode,
        "transport": "unix_socket_daemon",
        "elapsed_ms": round(m_ms, 2),
        "urc_hit_tokens": urc_hit,
        "conformal_pick_margin": round(m_margin, 3),
        "output": m_txt,
    }, indent=2))


if __name__ == "__main__":
    main()
