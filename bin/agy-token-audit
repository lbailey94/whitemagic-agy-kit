#!/usr/bin/env python3
"""
agy-token-audit — Forensic token, prefix-cache & tool-burn auditor for Antigravity CLI sessions and swarms.
Zero-PII safe by default on --report-md exports.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from collections import Counter
from datetime import datetime
from pathlib import Path
from typing import Any

def _surface_brains() -> dict[str, Path]:
    return {
        "app": Path(os.environ.get("WM_AGY_APP_BRAIN") or str(Path.home() / ".gemini" / "antigravity" / "brain")),
        "ide": Path(os.environ.get("WM_AGY_IDE_BRAIN") or str(Path.home() / ".gemini" / "antigravity-ide" / "brain")),
        "cli": Path(os.environ.get("WM_AGY_CLI_BRAIN") or str(Path.home() / ".gemini" / "antigravity-cli" / "brain")),
    }


SURFACE_BRAINS = _surface_brains()
EMAIL_RE = re.compile(r"[\w.+-]+@[\w-]+\.[\w.-]+")
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)
SWARM_NAME_CID_RE = re.compile(r'"name"\s*:\s*"([^"]+)"[^}]*?"conversation_id"\s*:\s*"([0-9a-f-]{36})"')
SWARM_CID_NAME_RE = re.compile(r'"conversation_id"\s*:\s*"([0-9a-f-]{36})"[^}]*?"name"\s*:\s*"([^"]+)"')


def find_transcript(conv_id: str, surface: str = "all") -> tuple[Path | None, str]:
    brains = _surface_brains()
    surfaces = ("app", "ide", "cli") if surface == "all" else (surface,)
    for surf in surfaces:
        bdir = brains.get(surf)
        if not bdir or not bdir.is_dir():
            continue
        tf = bdir / conv_id / ".system_generated" / "logs" / "transcript.jsonl"
        if tf.is_file():
            return tf, surf
    if len(conv_id) >= 6:
        for surf in surfaces:
            bdir = brains.get(surf)
            if not bdir or not bdir.is_dir():
                continue
            for tf in sorted(bdir.glob(f"{conv_id}*/.system_generated/logs/transcript.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True):
                if tf.is_file():
                    return tf, surf
    return None, ""


def _unwrap_json_str(v: Any) -> Any:
    if isinstance(v, str) and len(v) >= 2 and v[0] == '"' and v[-1] == '"':
        try:
            u = json.loads(v)
            if isinstance(u, str):
                return u
        except Exception:
            pass
    return v


def sanitize_report(text: str) -> str:
    home_str = str(Path.home())
    text = text.replace(home_str, "~")
    user = os.environ.get("USER") or Path.home().name
    if user:
        text = text.replace(f"/Users/{user}", "~").replace(f"/home/{user}", "~").replace(f"/media/{user}", "/media/<USER>")
    text = EMAIL_RE.sub("[REDACTED_EMAIL]", text)
    return text


def discover_swarm_workers(coord_id: str, surface: str = "all") -> list[tuple[str, str]]:
    """Auto-discover swarm worker conversation_ids and names from coordinator transcript."""
    tf, _ = find_transcript(coord_id, surface=surface)
    resolved_coord = tf.parents[2].name if tf else coord_id
    found: list[tuple[str, str]] = [("coordinator", resolved_coord)]
    seen = {resolved_coord}
    if not tf or not tf.is_file():
        return found

    pending_names: list[str] = []
    for line in tf.read_text(errors="replace").splitlines():
        try:
            o = json.loads(line)
        except Exception:
            continue
        t = o.get("type")
        if t == "PLANNER_RESPONSE":
            for tc in o.get("tool_calls") or []:
                if (tc.get("name") or "") == "swarm":
                    args = tc.get("args") or tc.get("arguments") or {}
                    if isinstance(args, str):
                        try:
                            args = json.loads(args)
                        except Exception:
                            args = {}
                    if isinstance(args, dict):
                        act = _unwrap_json_str(args.get("action"))
                        wname = _unwrap_json_str(args.get("name"))
                        if act == "add" and wname:
                            pending_names.append(str(wname))
        elif t == "GENERIC":
            c = str(o.get("content") or "")
            if '"conversation_id"' in c or "conversation_id" in c:
                # Extract pairs of ("name":"..." ... "conversation_id":"...") or raw UUIDs
                for m in SWARM_NAME_CID_RE.finditer(c):
                    wname, wcid = m.group(1), m.group(2)
                    if wcid not in seen:
                        seen.add(wcid)
                        found.append((wname, wcid))
                # Reverse order in JSON if conversation_id came before name
                for m in SWARM_CID_NAME_RE.finditer(c):
                    wcid, wname = m.group(1), m.group(2)
                    if wcid not in seen:
                        seen.add(wcid)
                        found.append((wname, wcid))
                # Fallback if swarm output had only conversation_id
                if '"status":"added"' in c.replace(" ", ""):
                    for uid in UUID_RE.findall(c):
                        if uid not in seen:
                            seen.add(uid)
                            lbl = pending_names.pop(0) if pending_names else f"worker-{uid[:8]}"
                            found.append((lbl, uid))
    return found


def audit_transcript(label: str, conv_id: str, surface: str = "all") -> dict[str, Any]:
    tf, surf = find_transcript(conv_id, surface=surface)
    if not tf or not tf.is_file():
        return {"label": label, "conv_id": conv_id, "surface": surf or "-", "missing": True}

    turns = 0
    unc_sum = cac_sum = out_sum = 0
    t0_unc = 0
    max_unc = 0
    flips = 0
    flip_unc = 0
    gaps30 = 0
    gap_unc = 0
    compactions = 0
    hook_hits = 0
    spills = 0
    think_chars = 0
    exit_plan_count = 0
    enter_plan_count = 0
    one_turn_neon_plans = 0
    neon_streak = 0
    last_ctx = 0
    last_unc = 0
    last_hit_pct = None
    last_model = ""
    last_ts_epoch: float | None = None
    saw_checkpoint_since_prev = False
    prev_ctx = 0
    buckets: dict[str, dict[str, int]] = {
        "turn_0": {"turns": 0, "tokens": 0},
        "flips": {"turns": 0, "tokens": 0},
        "ttl_expiries": {"turns": 0, "tokens": 0},
        "compactions_partial": {"turns": 0, "tokens": 0},
        "warm_work": {"turns": 0, "tokens": 0},
    }
    read_files: set[str] = set()
    models: Counter[str] = Counter()
    tools: Counter[str] = Counter()
    prev_model = ""
    prev_ts: datetime | None = None

    for line in tf.read_text(errors="replace").splitlines():
        try:
            o = json.loads(line)
        except Exception:
            continue
        t = o.get("type")
        if t == "PLANNER_RESPONSE":
            u = int(o.get("input_tokens") or 0)
            c = int(o.get("cache_read_tokens") or 0)
            ot = int(o.get("output_tokens") or 0)
            m = str(o.get("model") or "")
            th = o.get("thinking") or ""
            think_chars += len(str(th))
            has_toks = (u + c + ot) > 0
            if m:
                if "neon" in m.lower():
                    neon_streak += 1
                elif has_toks:
                    neon_streak = 0
            for tc in o.get("tool_calls") or []:
                tn = str(tc.get("name") or tc.get("tool") or "unknown")
                tools[tn] += 1
                if tn == "enter_plan_mode":
                    enter_plan_count += 1
                    neon_streak = 0
                elif tn == "exit_plan_mode":
                    exit_plan_count += 1
                    if "neon" in m.lower() and neon_streak <= 1:
                        one_turn_neon_plans += 1
                    neon_streak = 0
                elif tn == "read_file":
                    targs = tc.get("args") or tc.get("arguments") or {}
                    if isinstance(targs, str):
                        try:
                            targs = json.loads(targs)
                        except Exception:
                            targs = {}
                    if isinstance(targs, dict):
                        rp = targs.get("Path") or targs.get("path")
                        if rp:
                            read_files.add(str(_unwrap_json_str(rp)))
            if has_toks:
                turns += 1
                ctx = u + c
                turn_hit = (100.0 * c / ctx) if ctx > 0 else 0.0
                if turns == 1:
                    t0_unc = u
                unc_sum += u
                cac_sum += c
                out_sum += ot
                if ctx > 0:
                    last_ctx = ctx
                    last_unc = u
                    last_hit_pct = round(turn_hit, 1)
                if u > max_unc:
                    max_unc = u
                if m:
                    models[m] += 1
                    last_model = m
                flipped = bool(m and prev_model and m != prev_model)
                if flipped:
                    flips += 1
                    flip_unc += u
                gap_s = 0.0
                ts_s = o.get("created_at") or o.get("timestamp")
                if ts_s:
                    try:
                        dt = datetime.fromisoformat(str(ts_s).replace("Z", "+00:00"))
                        last_ts_epoch = dt.timestamp()
                        if prev_ts is not None:
                            gap_s = max(0.0, (dt - prev_ts).total_seconds())
                            if gap_s >= 30.0:
                                gaps30 += 1
                                if not flipped:
                                    gap_unc += u
                        prev_ts = dt
                    except Exception:
                        pass

                # Mutually exclusive, exhaustive uncached burn attribution
                if turns == 1:
                    bkey = "turn_0"
                elif flipped:
                    bkey = "flips"
                elif (
                    saw_checkpoint_since_prev
                    or (prev_ctx >= 40_000 and ctx > 0 and ctx < int(prev_ctx * 0.85))
                    or (50.0 <= turn_hit < 90.0 and u >= 15_000 and gap_s < 60.0)
                ):
                    bkey = "compactions_partial"
                elif (
                    (gap_s >= 60.0 and turn_hit < 85.0)
                    or (gap_s >= 180.0 and u >= 25_000)
                    or (turn_hit < 50.0 and ctx >= 50_000)
                ):
                    bkey = "ttl_expiries"
                else:
                    bkey = "warm_work"
                buckets[bkey]["turns"] += 1
                buckets[bkey]["tokens"] += u
                saw_checkpoint_since_prev = False
                if ctx > 0:
                    prev_ctx = ctx
                if m:
                    prev_model = m
        elif t == "CHECKPOINT":
            compactions += 1
            saw_checkpoint_since_prev = True
        elif t == "GENERIC":
            c = str(o.get("content") or "")
            low = c.lower()
            if "pre-tool hook" in low or "wm-squeeze" in low:
                hook_hits += 1
            if "output.txt" in c and "truncated" in low:
                spills += 1

    hit_pct = round(100.0 * cac_sum / max(unc_sum + cac_sum, 1), 1)
    breakdown = {}
    for bkey, bval in buckets.items():
        btoks = bval["tokens"]
        btrns = bval["turns"]
        breakdown[bkey] = {
            "turns": btrns,
            "tokens": btoks,
            "pct": round(100.0 * btoks / max(unc_sum, 1), 1) if unc_sum > 0 else 0.0,
            "avg_per_turn": round(btoks / btrns) if btrns > 0 else 0,
        }
    return {
        "label": label,
        "conv_id": tf.parents[2].name,
        "surface": surf,
        "missing": False,
        "turns": turns,
        "hit_pct": hit_pct,
        "t0_unc": t0_unc,
        "tot_unc": unc_sum,
        "tot_cac": cac_sum,
        "tot_out": out_sum,
        "last_ctx": last_ctx,
        "last_unc": last_unc,
        "last_hit_pct": last_hit_pct,
        "last_model": last_model,
        "last_ts_epoch": last_ts_epoch,
        "max_unc": max_unc,
        "flips": flips,
        "flip_unc": flip_unc,
        "gaps30": gaps30,
        "gap_unc": gap_unc,
        "compactions": compactions,
        "hook_hits": hook_hits,
        "spills": spills,
        "thinking_tok_est": think_chars // 4,
        "exit_plan_count": exit_plan_count,
        "enter_plan_count": enter_plan_count,
        "one_turn_neon_plans": one_turn_neon_plans,
        "unique_reads": len(read_files),
        "_read_files": read_files,
        "breakdown": breakdown,
        "models": dict(models),
        "tools": dict(tools),
    }


def aggregate(rows: list[dict[str, Any]]) -> dict[str, Any]:
    active = [r for r in rows if not r.get("missing")]
    tot_tools: Counter[str] = Counter()
    tot_models: Counter[str] = Counter()
    path_sessions: Counter[str] = Counter()
    for r in active:
        tot_tools.update(r["tools"])
        tot_models.update(r["models"])
        for p in r.get("_read_files") or ():
            path_sessions[p] += 1
    tot_unc = sum(r["tot_unc"] for r in active)
    tot_cac = sum(r["tot_cac"] for r in active)
    tot_out = sum(r["tot_out"] for r in active)
    tot_trn = sum(r["turns"] for r in active)
    agg_buckets: dict[str, dict[str, Any]] = {}
    for bkey in ("flips", "ttl_expiries", "warm_work", "compactions_partial", "turn_0"):
        btrns = sum(int((r.get("breakdown") or {}).get(bkey, {}).get("turns") or 0) for r in active)
        btoks = sum(int((r.get("breakdown") or {}).get(bkey, {}).get("tokens") or 0) for r in active)
        agg_buckets[bkey] = {
            "turns": btrns,
            "tokens": btoks,
            "pct": round(100.0 * btoks / max(tot_unc, 1), 1) if tot_unc > 0 else 0.0,
            "avg_per_turn": round(btoks / btrns) if btrns > 0 else 0,
        }
    return {
        "sessions_audited": len(active),
        "turns": tot_trn,
        "hit_pct": round(100.0 * tot_cac / max(tot_unc + tot_cac, 1), 1),
        "tot_unc": tot_unc,
        "tot_cac": tot_cac,
        "tot_out": tot_out,
        "max_unc": max((r["max_unc"] for r in active), default=0),
        "flips": sum(r["flips"] for r in active),
        "flip_unc": sum(r["flip_unc"] for r in active),
        "gaps30": sum(r["gaps30"] for r in active),
        "gap_unc": sum(r["gap_unc"] for r in active),
        "compactions": sum(r["compactions"] for r in active),
        "hook_hits": sum(r["hook_hits"] for r in active),
        "spills": sum(r["spills"] for r in active),
        "thinking_tok_est": sum(r["thinking_tok_est"] for r in active),
        "exit_plan_count": sum(r.get("exit_plan_count", 0) for r in active),
        "enter_plan_count": sum(r.get("enter_plan_count", 0) for r in active),
        "one_turn_neon_plans": sum(r.get("one_turn_neon_plans", 0) for r in active),
        "cross_session_dup_reads": sum(1 for cnt in path_sessions.values() if cnt >= 2),
        "breakdown": agg_buckets,
        "top_tools": tot_tools.most_common(15),
        "models": dict(tot_models),
    }


BREAKDOWN_LABELS = (
    ("flips", "Flips"),
    ("ttl_expiries", "TTL Expiries"),
    ("warm_work", "Warm Work"),
    ("compactions_partial", "Partial/Compactions"),
    ("turn_0", "Turn-0"),
)


def _fmt_tok(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1e6:7.2f}M"
    if n >= 1_000:
        return f"{n / 1000.0:7.1f}k"
    return f"{n:8d}"


def format_breakdown_table(rows: list[dict[str, Any]], agg: dict[str, Any], target_label: str) -> str:
    tot_in = agg["tot_unc"] + agg["tot_cac"]
    lines = [
        f"=== AGY Uncached Burn Breakdown ({target_label} | {agg['sessions_audited']} sessions | {agg['turns']} turns) ===",
        f"Total Input: {_fmt_tok(tot_in).strip()} ({_fmt_tok(agg['tot_cac']).strip()} cached {agg['hit_pct']}% | {_fmt_tok(agg['tot_unc']).strip()} uncached | {_fmt_tok(agg['tot_out']).strip()} output)",
        f"{'BUCKET':20s} | {'TURNS':>6s} | {'UNCACHED':>8s} | {'SHARE%':>6s} | {'AVG/TURN':>8s}",
        "-" * 60,
    ]
    bd = agg.get("breakdown") or {}
    for key, lbl in BREAKDOWN_LABELS:
        b = bd.get(key) or {"turns": 0, "tokens": 0, "pct": 0.0, "avg_per_turn": 0}
        lines.append(
            f"{lbl:20s} | {b['turns']:6d} | {_fmt_tok(b['tokens'])} | {b['pct']:5.1f}% | {_fmt_tok(b['avg_per_turn'])}"
        )
    lines.append("-" * 60)
    avg_all = round(agg["tot_unc"] / max(agg["turns"], 1)) if agg["turns"] else 0
    lines.append(
        f"{'TOTAL':20s} | {agg['turns']:6d} | {_fmt_tok(agg['tot_unc'])} | {'100.0%':>6s} | {_fmt_tok(avg_all)}"
    )
    active = [r for r in rows if not r.get("missing")]
    if len(active) == 1:
        r = active[0]
        lines.append("")
        lines.append(
            f"Session: {r['conv_id']} ({r.get('surface', '-')}) | model={r.get('last_model') or '?'} | "
            f"last_ctx={r.get('last_ctx', 0):,} tok | last_hit={r.get('last_hit_pct')}% | max_unc={r.get('max_unc', 0):,}"
        )
    return "\n".join(lines)


def format_table(rows: list[dict[str, Any]], agg: dict[str, Any]) -> str:
    lines = [
        f"=== AGY Token & Cache Forensics ({agg['sessions_audited']} sessions | {agg['turns']} turns | {agg['hit_pct']}% hit) ===",
        f"{'SESSION':16s} | {'SRF':>3s} | {'TRN':>3s} | {'HIT%':>5s} | {'T0_UNC':>7s} | {'TOT_UNC':>8s} | {'TOT_CAC':>8s} | {'TOT_OUT':>7s} | {'MAX_UNC':>7s} | {'FLP':>3s} | {'G30':>3s} | {'CMP':>3s} | {'HK':>2s}",
        "-" * 109,
    ]
    for r in rows:
        if r.get("missing"):
            lines.append(f"{r['label'][:16]:16s} | {r.get('surface', '-'):>3s} | MISSING")
            continue
        lines.append(
            f"{r['label'][:16]:16s} | {r.get('surface', '-'):>3s} | {r['turns']:3d} | {r['hit_pct']:4.1f}% | {r['t0_unc']/1000:6.1f}k | "
            f"{r['tot_unc']/1e6:7.2f}M | {r['tot_cac']/1e6:7.2f}M | {r['tot_out']/1000:6.1f}k | "
            f"{r['max_unc']/1000:6.1f}k | {r['flips']:3d} | {r['gaps30']:3d} | {r['compactions']:3d} | {r['hook_hits']:2d}"
        )
    lines.append("-" * 109)
    lines.append(
        f"{'TOTAL':16s} | {'ALL':>3s} | {agg['turns']:3d} | {agg['hit_pct']:4.1f}% | {'':>7s} | "
        f"{agg['tot_unc']/1e6:7.2f}M | {agg['tot_cac']/1e6:7.2f}M | {agg['tot_out']/1000:6.1f}k | "
        f"{agg['max_unc']/1000:6.1f}k | {agg['flips']:3d} | {agg['gaps30']:3d} | {agg['compactions']:3d} | {agg['hook_hits']:2d}"
    )
    lines.append("")
    lines.append(
        f"Burn Attribution: cross-model flips={agg['flips']} ({agg['flip_unc']/1e6:.2f}M unc) | "
        f">=30s idle gaps={agg['gaps30']} ({agg['gap_unc']/1e6:.2f}M unc) | "
        f"compactions={agg['compactions']} | thinking_est={agg['thinking_tok_est']/1000:.1f}k tok | spills={agg['spills']}"
    )
    lines.append(
        f"Orchestration Telemetry: exit_plan={agg['exit_plan_count']} (1-turn Neon={agg['one_turn_neon_plans']}) | "
        f"enter_plan={agg['enter_plan_count']} | cross-session dup reads={agg['cross_session_dup_reads']}"
    )
    if agg["top_tools"]:
        lines.append("Top Tools: " + ", ".join(f"{k}={v}" for k, v in agg["top_tools"][:10]))
    return "\n".join(lines)


def build_markdown_report(rows: list[dict[str, Any]], agg: dict[str, Any], target_label: str) -> str:
    md = [
        f"# Antigravity Token & Prefix-Cache Telemetry Report ({target_label})",
        "",
        f"- **Sessions Audited:** `{agg['sessions_audited']}`",
        f"- **Total Turns:** `{agg['turns']}`",
        f"- **Aggregate Prefix Cache Hit Rate:** `{agg['hit_pct']}%` (`{agg['tot_cac']/1e6:.2f}M` cached vs `{agg['tot_unc']/1e6:.2f}M` uncached input)",
        f"- **Total Output Tokens:** `{agg['tot_out']/1000:.1f}k` (`~{agg['thinking_tok_est']/1000:.1f}k` estimated thinking tokens)",
        f"- **Cross-Model Flips:** `{agg['flips']}` (`{agg['flip_unc']/1e6:.2f}M` uncached input tokens on flip turns)",
        f"- **>=30s Inter-Turn Gaps:** `{agg['gaps30']}` (`{agg['gap_unc']/1e6:.2f}M` non-flip uncached input tokens)",
        f"- **Orchestration Cadence:** `exit_plan_mode={agg['exit_plan_count']}` (`1-turn Neon={agg['one_turn_neon_plans']}`) | `enter_plan_mode={agg['enter_plan_count']}` | **Cross-Session Dup Reads:** `{agg['cross_session_dup_reads']}`",
        f"- **Auto-Compactions (`CHECKPOINT`):** `{agg['compactions']}` | **Spills:** `{agg['spills']}` | **PreToolUse Squeeze/Hook Hits:** `{agg['hook_hits']}`",
        "",
        "## Per-Session Breakdown",
        "",
        "| Session | Surface | Turns | Cache Hit | Turn-0 Unc | Uncached In | Cached In | Output Tok | Max Single Unc | Flips | >=30s Gaps | Compactions |",
        "| :--- | :--- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
    ]
    for r in rows:
        if r.get("missing"):
            continue
        md.append(
            f"| `{r['label'][:22]}` | `{r.get('surface', '-')}` | {r['turns']} | {r['hit_pct']}% | {r['t0_unc']/1000:.1f}k | "
            f"{r['tot_unc']/1e6:.2f}M | {r['tot_cac']/1e6:.2f}M | {r['tot_out']/1000:.1f}k | "
            f"{r['max_unc']/1000:.1f}k | {r['flips']} | {r['gaps30']} | {r['compactions']} |"
        )
    md.extend(
        [
            "",
            "## Tool Call Distribution",
            "",
            "| Tool | Calls |",
            "| :--- | ---: |",
        ]
    )
    for tn, cnt in agg["top_tools"]:
        md.append(f"| `{tn}` | {cnt} |")
    md.extend(
        [
            "",
            "## Empirical Takeaways & Mitigations Implemented (`whitemagic-agy-kit v4.4.0`)",
            "",
            "1. **Orchestrator Model-Flip Cache Eviction:** Alternating between models (`Neon <-> Hydrogen`) on large contexts (`150k-327k`) dropped prefix cache hits to `0%` on flip turns. Mitigation: pin `/swarm` coordinators to a single model (`agy-mode longevity`).",
            "2. **Wide-Span `read_file` Context Bloat:** Explicit `StartLine=1, EndLine=800` slices bypassed unbounded-only read guards and triggered compaction spikes (`384k` uncached). Mitigation: clamp any span >250 lines (`150L` above `120k` ctx, `120L` on burst reads).",
            "3. **Un-Squeezed Multiline Python Heredocs:** Multiline `python3 - <<'PY'` commands bypassed `wm-squeeze --safe`. Mitigation: `PreToolUse` v4.1 wraps standalone inline Python heredocs via `set -o pipefail; python3 - <<'TAG' 2>&1 | wm-squeeze --pipe --kind generic`.",
            "4. **Script-First Workers vs. Large `write_file` Payloads:** Writing large structured files via Python scripts cut turns ~5x and output tokens ~3x (`9 turns / 0.17M unc / 58.9k out`) compared to inline JSON emission (`46-50 turns / 170-181k out`).",
            "5. **Skill Deduplication:** Removed overlapping user-level copies of plugin-bundled skills to trim Turn-0 uncached system prompt overhead.",
            "",
        ]
    )
    return sanitize_report("\n".join(md))


def main() -> int:
    ap = argparse.ArgumentParser(description="Forensic token & prefix-cache audit for Antigravity App/IDE/CLI sessions and swarms.")
    ap.add_argument("--recent", type=int, default=15, help="Audit N most recent sessions (default 15)")
    ap.add_argument("--surface", choices=["all", "app", "ide", "cli"], default="all", help="AGY surface to scan (default: all)")
    ap.add_argument("--conv", type=str, help="Audit a single conversation ID (auto-discovers spawned swarm workers if present)")
    ap.add_argument("--session", type=str, help="Audit one exact session ID or prefix (no swarm expansion)")
    ap.add_argument("--swarm", type=str, help="Audit a swarm coordinator ID and all its spawned workers")
    ap.add_argument("--breakdown", action="store_true", help="Display uncached burn decomposition table (Flips, TTL Expiries, Warm Work, Partial/Compactions, Turn-0)")
    ap.add_argument("--json", action="store_true", help="Print JSON output")
    ap.add_argument("--report-md", type=str, help="Write Zero-PII Markdown telemetry report to path")
    args = ap.parse_args()

    targets: list[tuple[str, str]] = []
    target_label = f"recent-{args.recent}-{args.surface}"
    if args.swarm:
        targets = discover_swarm_workers(args.swarm, surface=args.surface)
        target_label = f"swarm-{args.swarm[:8]}"
    elif args.session:
        targets = [(args.session[:14], args.session)]
        target_label = f"session-{args.session[:8]}"
    elif args.conv:
        targets = discover_swarm_workers(args.conv, surface=args.surface)
        target_label = f"conv-{args.conv[:8]}"
    else:
        brains = _surface_brains()
        surfaces = ("app", "ide", "cli") if args.surface == "all" else (args.surface,)
        all_logs = []
        for surf in surfaces:
            bdir = brains.get(surf)
            if bdir and bdir.is_dir():
                for lp in bdir.glob("*/.system_generated/logs/transcript.jsonl"):
                    all_logs.append((lp.stat().st_mtime, lp))
        all_logs.sort(key=lambda x: x[0], reverse=True)
        for _, lp in all_logs[: max(1, args.recent)]:
            cid = lp.parents[2].name
            targets.append((cid[:14], cid))

    rows = [audit_transcript(lbl, cid, surface=args.surface) for lbl, cid in targets]
    agg = aggregate(rows)
    clean_rows = [{k: v for k, v in r.items() if k != "_read_files"} for r in rows]

    if args.report_md:
        rp = Path(args.report_md)
        rp.parent.mkdir(parents=True, exist_ok=True)
        rp.write_text(build_markdown_report(clean_rows, agg, target_label), encoding="utf-8")

    if args.json:
        out_obj: dict[str, Any] = {"target": target_label, "aggregate": agg, "sessions": clean_rows}
        if args.breakdown:
            out_obj["breakdown"] = agg.get("breakdown") or {}
        print(json.dumps(out_obj, indent=2))
    else:
        if args.breakdown:
            print(format_breakdown_table(clean_rows, agg, target_label))
        else:
            print(format_table(clean_rows, agg))
        if args.report_md:
            print(f"\nWrote Zero-PII Markdown report -> {args.report_md}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
