#!/usr/bin/env python3
"""
wm-sim — Portable (macOS + Linux) Self-Improvement Memory (SIM) CLI & AGY Hygiene Auditor.
Implements structured continual self-improvement memory (arXiv:2611.18856 / Harness2 / Model 801).
"""

import argparse
import glob
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
LEDGER_PATH = Path(
    os.environ.get("WM_SIM_LEDGER", str(HOME / ".local" / "share" / "whitemagic" / "sim_ledger.jsonl"))
)
WM3_BIN = Path(
    os.environ.get(
        "WM3_BIN",
        shutil.which("wm3")
        or shutil.which("wm-gen3")
        or str(HOME / ".local" / "bin" / "wm-gen3"),
    )
)
_XDG_GEN3_STORE = HOME / ".local" / "share" / "whitemagic" / "gen3"
_SHARED_GEN3_STORE = Path("/Users/Shared/ai/wm-store-gen3")
_DEFAULT_GEN3_STORE = str(
    _XDG_GEN3_STORE
    if _XDG_GEN3_STORE.is_dir()
    else (_SHARED_GEN3_STORE if _SHARED_GEN3_STORE.is_dir() else _XDG_GEN3_STORE)
)
WM3_STORE = Path(os.environ.get("WM3_STORE", _DEFAULT_GEN3_STORE))
_EXTRA_RULES = sorted((HOME / ".gemini" / "config" / "rules").glob("*.md")) if (HOME / ".gemini" / "config" / "rules").is_dir() else []
RULE_FILES = [
    HOME / ".gemini" / "GEMINI.md",
    HOME / "GEMINI.md",
    *_EXTRA_RULES,
    HOME / ".gemini" / "config" / "plugins" / "agy-fast" / "rules" / "AGENTS.md",
    HOME / ".gemini" / "config" / "plugins" / "whitemagic-agy-kit" / "rules" / "AGENTS.md",
]
AGY_RULE_BYTE_CAP = 24000


def ensure_ledger():
    LEDGER_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not LEDGER_PATH.exists():
        LEDGER_PATH.touch()


def read_entries():
    ensure_ledger()
    entries = []
    with open(LEDGER_PATH, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return entries


def append_entry(entry):
    ensure_ledger()
    with open(LEDGER_PATH, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def cmd_log(args):
    now = datetime.now(timezone.utc).isoformat()
    digest = hashlib.sha256(
        f"{now}:{args.domain}:{args.group}:{args.target}:{args.rationale}".encode("utf-8")
    ).hexdigest()[:10]
    entry = {
        "id": f"sim-{digest}",
        "event": "experiment",
        "ts": now,
        "domain": args.domain,
        "problem_group": args.group,
        "target": args.target,
        "rationale": args.rationale,
        "predicted_outcome": args.predicted,
        "observed_outcome": args.observed,
        "eval_context": args.eval_context,
        "status": args.status,
        "model": args.model,
        "synced_wm3": False,
    }
    append_entry(entry)
    print(f"Logged {entry['id']} [{entry['domain']}/{entry['problem_group']}] status={entry['status']}")


def cmd_query(args):
    entries = [e for e in read_entries() if e.get("event") == "experiment" or args.include_failures]
    q = (args.query or "").lower().strip()
    if args.domain:
        entries = [e for e in entries if e.get("domain", "").lower() == args.domain.lower()]
    if q:
        entries = [e for e in entries if q in json.dumps(e, ensure_ascii=False).lower()]

    if not entries:
        print("No matching SIM entries found.")
        return

    grouped = defaultdict(list)
    for e in entries[-args.limit :]:
        grp = e.get("problem_group") or e.get("tool") or "general"
        grouped[grp].append(e)

    print(f"SIM Query Results ({len(entries)} total matched, showing up to {args.limit}):\n")
    for grp, items in grouped.items():
        print(f"## Problem Group: {grp} ({len(items)})")
        for it in items:
            if it.get("event") == "tool_failure":
                print(
                    f"  - [{it.get('ts','')[:19]}] FAIL `{it.get('tool')}`: {it.get('cmd_preview','')} -> {it.get('error','')[:140]}"
                )
            else:
                print(
                    f"  - [{it.get('id')}] ({it.get('status')}, {it.get('model','')}, {it.get('ts','')[:10]}) target=`{it.get('target')}`"
                )
                print(f"      Rationale: {it.get('rationale')}")
                print(f"      Predicted: {it.get('predicted_outcome')}")
                print(f"      Observed:  {it.get('observed_outcome')}")
                if it.get("eval_context"):
                    print(f"      EvalCtx:   {it.get('eval_context')}")
        print()


def cmd_failures(args):
    entries = [e for e in read_entries() if e.get("event") == "tool_failure"]
    if not entries:
        print("No auto-captured tool failures in SIM ledger.")
        return
    print(f"Recent Tool Failures ({min(len(entries), args.limit)} of {len(entries)}):")
    for it in entries[-args.limit :]:
        print(
            f"  - [{it.get('ts','')[:19]}] {it.get('tool')} ({it.get('cwd','')}) | {it.get('cmd_preview','')} => {it.get('error','')[:160]}"
        )


DOMAIN_PLUGINS = {
    "chrome-devtools-plugin": "web",
    "modern-web-guidance-plugin": "web",
    "google-antigravity-sdk": "agy_sdk",
    "firebase": "firebase",
    "flutter": "flutter",
    "android-cli-plugin": "android",
}
CORE_PLUGINS = {"whitemagic-agy-kit"}


def _agy_config_dir() -> Path:
    return Path(os.environ.get("WM_AGY_CONFIG_DIR") or str(HOME / ".gemini" / "config"))


def _disabled_plugins() -> set:
    cfg_json = _agy_config_dir() / "config.json"
    if not cfg_json.is_file():
        return set()
    try:
        plugs = json.loads(cfg_json.read_text(encoding="utf-8")).get("plugins") or {}
        return {k for k, v in plugs.items() if isinstance(v, dict) and v.get("enabled") is False}
    except Exception:
        return set()


def _detect_repo_signals(repo_dir: Path) -> set[str]:
    signals: set[str] = set()
    if not repo_dir.is_dir():
        return signals
    scan_dirs = [repo_dir]
    for sub in ("src", "web", "app", "frontend", "client", "pages"):
        sd = repo_dir / sub
        if sd.is_dir():
            scan_dirs.append(sd)

    web_exact = {"index.html", "manifest.json", "svelte.config.js", "astro.config.mjs"}
    web_exts = {".css", ".tsx", ".jsx", ".vue", ".svelte"}
    for d in scan_dirs:
        try:
            for entry in d.iterdir():
                if not entry.is_file():
                    continue
                nm = entry.name
                if nm in web_exact or nm.startswith(("vite.config.", "next.config.")) or entry.suffix.lower() in web_exts:
                    signals.add("web")
        except Exception:
            pass

    pkg = repo_dir / "package.json"
    if pkg.is_file():
        try:
            txt = pkg.read_text(encoding="utf-8", errors="replace")[:65536].lower()
            if any(k in txt for k in ('"react"', '"next"', '"vite"', '"vue"', '"svelte"', '"playwright"', '"puppeteer"', '"tailwindcss"')):
                signals.add("web")
            if "google-antigravity" in txt or "antigravity-sdk" in txt:
                signals.add("agy_sdk")
        except Exception:
            pass

    pyp = repo_dir / "pyproject.toml"
    if pyp.is_file():
        try:
            txt = pyp.read_text(encoding="utf-8", errors="replace")[:65536].lower()
            if "google-antigravity" in txt or "antigravity-sdk" in txt:
                signals.add("agy_sdk")
        except Exception:
            pass

    if (repo_dir / "pubspec.yaml").is_file():
        signals.add("flutter")
    if (repo_dir / "firebase.json").is_file():
        signals.add("firebase")
    has_gradle = any((repo_dir / g).is_file() for g in ("build.gradle", "build.gradle.kts"))
    has_aman = (repo_dir / "AndroidManifest.xml").is_file() or (repo_dir / "app" / "src" / "main" / "AndroidManifest.xml").is_file()
    if has_gradle and has_aman:
        signals.add("android")

    return signals


def _plugin_frontmatter_stats(plugins_dir: Path, plugin_name: str) -> tuple[int, int]:
    pdir = plugins_dir / plugin_name
    if not pdir.is_dir():
        return 0, 0
    fm_bytes = 0
    skill_cnt = 0
    for sf in glob.glob(str(pdir / "**" / "SKILL.md"), recursive=True):
        skill_cnt += 1
        try:
            txt = Path(sf).read_text(encoding="utf-8", errors="replace")
            if txt.startswith("---"):
                parts = txt.split("---", 2)
                if len(parts) >= 2:
                    fm_bytes += len(parts[1].encode("utf-8"))
        except Exception:
            pass
    return skill_cnt, fm_bytes


def cmd_scope_plugins(repo_dir_str: str, write: bool = False, as_json: bool = False) -> None:
    repo_dir = Path(repo_dir_str).resolve()
    cfg_dir = _agy_config_dir()
    cfg_json = cfg_dir / "config.json"
    plugins_dir = cfg_dir / "plugins"

    plugs_meta = {}
    if cfg_json.is_file():
        try:
            plugs_meta = json.loads(cfg_json.read_text(encoding="utf-8")).get("plugins") or {}
        except Exception:
            plugs_meta = {}

    installed_names = set(plugs_meta.keys())
    if plugins_dir.is_dir():
        for p in plugins_dir.iterdir():
            if p.is_dir():
                installed_names.add(p.name)

    signals = _detect_repo_signals(repo_dir)
    plugin_details = {}
    enabled_domain = []
    matched_domain = []
    unmatched_enabled = []
    cur_dom_bytes = 0
    savings_bytes = 0

    for pn in sorted(installed_names):
        if pn in CORE_PLUGINS or pn not in DOMAIN_PLUGINS:
            continue
        meta = plugs_meta.get(pn)
        enabled = bool(meta.get("enabled")) if isinstance(meta, dict) else False
        sk_c, fm_b = _plugin_frontmatter_stats(plugins_dir, pn)
        need_sig = DOMAIN_PLUGINS[pn]
        matched = need_sig in signals
        plugin_details[pn] = {
            "signal": need_sig,
            "matched": matched,
            "enabled_globally": enabled,
            "skills": sk_c,
            "frontmatter_bytes": fm_b,
            "est_tokens": fm_b // 4,
        }
        if enabled:
            enabled_domain.append(pn)
            cur_dom_bytes += fm_b
        if matched:
            matched_domain.append(pn)
        elif enabled:
            unmatched_enabled.append(pn)
            savings_bytes += fm_b

    rec_cfg = (
        {"entries": [{"path": "~/.gemini/config/plugins", "include_only": matched_domain}]}
        if matched_domain
        else None
    )
    wrote_path = None
    if write and rec_cfg is not None:
        target = repo_dir / ".agents" / "plugins.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        tmp = target.with_name(f".{target.name}.tmp.{os.getpid()}")
        tmp.write_text(json.dumps(rec_cfg, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, target)
        wrote_path = str(target)

    out = {
        "repo": str(repo_dir),
        "signals": sorted(signals),
        "enabled_domain_plugins": enabled_domain,
        "matched_domain_plugins": matched_domain,
        "unmatched_enabled_plugins": unmatched_enabled,
        "current_enabled_domain_bytes": cur_dom_bytes,
        "current_enabled_domain_tokens": cur_dom_bytes // 4,
        "savings_est_tokens": savings_bytes // 4,
        "plugins": plugin_details,
        "recommended_plugins_json": rec_cfg,
        "wrote_path": wrote_path,
    }
    if as_json:
        print(json.dumps(out, indent=2))
        return

    print(f"=== Plugin Turn-0 Scope Audit ({repo_dir.name}) ===")
    print(f"Signals detected        : {', '.join(out['signals']) if out['signals'] else 'none (systems/CLI/backend repo)'}")
    print(f"Enabled domain plugins  : {', '.join(enabled_domain) if enabled_domain else 'none'} (~{out['current_enabled_domain_tokens']} Turn-0 tok)")
    print(f"Matched to this repo    : {', '.join(matched_domain) if matched_domain else 'none'}")
    print(f"Unmatched global bloat  : {', '.join(unmatched_enabled) if unmatched_enabled else 'none'} (save ~{out['savings_est_tokens']} Turn-0 tok)")
    if unmatched_enabled:
        print("Disable globally via    : " + " && ".join(f"agy plugin disable {p}" for p in unmatched_enabled))
    if rec_cfg is not None:
        print("Recommended .agents/plugins.json:\n" + json.dumps(rec_cfg, indent=2))
    if wrote_path:
        print(f"Wrote {wrote_path}")


def _rule_plugin_name(rf: Path) -> str:
    plugs_dir = _agy_config_dir() / "plugins"
    try:
        rel = rf.relative_to(plugs_dir)
        return rel.parts[0] if rel.parts else ""
    except Exception:
        return ""


def cmd_audit(args):
    if getattr(args, "scope_plugins", None) is not None:
        cmd_scope_plugins(args.scope_plugins, write=bool(getattr(args, "write", False)), as_json=bool(getattr(args, "json", False)))
        return
    disabled_plugs = _disabled_plugins()
    print("=== AGY CLI & WhiteMagic SIM Hygiene Audit ===\n")
    print("1. Rule Files (AGY per-file cap: 24,000 bytes):")
    seen_hashes = {}
    rule_word_sets = []
    for rf in RULE_FILES:
        plug_name = _rule_plugin_name(rf)
        if plug_name and plug_name in disabled_plugs:
            continue
        if rf.exists():
            with rf.open("rb") as _rfh:
                data = _rfh.read()
            text = data.decode("utf-8", errors="replace")
            h = hashlib.sha256(data).hexdigest()[:12]
            pct = (len(data) / AGY_RULE_BYTE_CAP) * 100
            dup = f" [DUP content of {seen_hashes[h]}]" if h in seen_hashes else ""
            seen_hashes[h] = str(rf)
            words = set(w.lower() for w in text.split() if len(w) > 3)
            for prev_rf, prev_words in rule_word_sets:
                if words and prev_words:
                    jacc = len(words & prev_words) / len(words | prev_words)
                    if jacc >= 0.65 and not dup:
                        dup = f" [WARN near-dup of {prev_rf}: {jacc*100:.0f}% overlap]"
            rule_word_sets.append((str(rf), words))
            flag = " [WARN >75%]" if pct > 75 else " [OK]"
            print(f"   - {rf}: {len(data):,} B ({pct:.1f}% of cap){flag}{dup}")
        else:
            print(f"   - {rf}: not present")

    cfg = HOME / ".gemini" / "config"
    hooks_file = cfg / "hooks.json"
    mcp_file = cfg / "mcp_config.json"
    skills_dir = cfg / "skills"
    cfg_json = cfg / "config.json"
    plugins_dir = cfg / "plugins"
    print("\n2. Global AGY Customizations (~/.gemini/config):")
    if hooks_file.exists():
        try:
            hd = json.loads(hooks_file.read_text(encoding="utf-8"))
            print(f"   - hooks.json: VALID ({len(hd)} named hook groups: {', '.join(hd.keys())})")
        except Exception as e:
            print(f"   - hooks.json: INVALID JSON ({e})")
    else:
        print("   - hooks.json: plugin-managed or not configured")

    if mcp_file.exists():
        try:
            md = json.loads(mcp_file.read_text(encoding="utf-8"))
            servers = list((md.get("mcpServers") or {}).keys())
            print(f"   - mcp_config.json: VALID ({len(servers)} servers: {', '.join(servers)})")
        except Exception as e:
            print(f"   - mcp_config.json: INVALID JSON ({e})")
    else:
        print("   - mcp_config.json: not configured")

    kit_mcp = plugins_dir / "whitemagic-agy-kit" / "mcp_config.json"
    if kit_mcp.exists():
        try:
            kmd = json.loads(kit_mcp.read_text(encoding="utf-8"))
            kservers = list((kmd.get("mcpServers") or {}).keys())
            node_avail = bool(shutil.which("node") or (HOME / ".local" / "bin" / "node").is_file())
            if "fast" not in kservers and node_avail:
                print(f"   - whitemagic-agy-kit MCP: {kservers} [WARN degraded: fast MCP missing — re-run ./install.sh]")
            else:
                print(f"   - whitemagic-agy-kit MCP: VALID ({len(kservers)} servers: {', '.join(kservers)}) [OK]")
        except Exception as e:
            print(f"   - whitemagic-agy-kit MCP: INVALID JSON ({e})")

    if skills_dir.exists():
        skills = sorted(p.name for p in skills_dir.iterdir() if p.is_dir() and (p / "SKILL.md").exists())
        print(f"   - custom skills ({len(skills)}): {', '.join(skills)}")

    if cfg_json.exists() and plugins_dir.exists():
        try:
            cd = json.loads(cfg_json.read_text(encoding="utf-8"))
            plugs = cd.get("plugins") or {}
            enabled_plugs = sorted(k for k, v in plugs.items() if isinstance(v, dict) and v.get("enabled"))
            disabled_plugs = sorted(k for k, v in plugs.items() if isinstance(v, dict) and not v.get("enabled"))
            fm_bytes = 0
            skill_cnt = 0
            for pn in enabled_plugs:
                pdir = plugins_dir / pn
                if not pdir.is_dir():
                    continue
                for sf in glob.glob(str(pdir / "**" / "SKILL.md"), recursive=True):
                    skill_cnt += 1
                    with open(sf, encoding="utf-8", errors="replace") as _sfh:
                        txt = _sfh.read()
                    if txt.startswith("---"):
                        parts = txt.split("---", 2)
                        if len(parts) >= 2:
                            fm_bytes += len(parts[1].encode("utf-8"))
            tok_est = fm_bytes // 4
            pflag = " [WARN >3k tok prompt bloat]" if tok_est > 3000 else " [OK]"
            print(
                f"   - plugins: {len(enabled_plugs)} enabled ({', '.join(enabled_plugs)}), "
                f"{len(disabled_plugs)} disabled | enabled plugin skills={skill_cnt}, "
                f"frontmatter={fm_bytes:,} B (~{tok_est:,} tok){pflag}"
            )
        except Exception as e:
            print(f"   - plugins: error reading config.json ({e})")

    print("\n3. Runtime & Disk Hygiene:")
    brief = HOME / "SharedWorkspace" / "PREFLIGHT_BRIEF.md"
    if brief.exists():
        age_m = int((time.time() - brief.stat().st_mtime) / 60)
        bflag = " [WARN stale >60m]" if age_m > 60 else " [OK]"
        print(f"   - PREFLIGHT_BRIEF.md age: {age_m}m{bflag}")
    du = shutil.disk_usage("/")
    free_gb = du.free / (1024 ** 3)
    used_pct = (du.used / du.total) * 100
    dflag = " [WARN >90% full]" if used_pct > 90 else " [OK]"
    print(f"   - Root disk '/': {free_gb:.2f} GiB free ({used_pct:.1f}% used){dflag}")

    entries = read_entries()
    exps = [e for e in entries if e.get("event") == "experiment"]
    fails = [e for e in entries if e.get("event") == "tool_failure"]
    unsynced = [e for e in exps if not e.get("synced_wm3")]
    groups = sorted(set(e.get("problem_group", "general") for e in exps))
    print("\n4. SIM Ledger:")
    print(f"   - Path: {LEDGER_PATH}")
    print(f"   - Total records: {len(entries)} ({len(exps)} experiments, {len(fails)} auto-captured tool failures)")
    print(f"   - Problem groups ({len(groups)}): {', '.join(groups) if groups else 'none'}")
    print(f"   - Unsynced to wm3: {len(unsynced)}")


def cmd_sync_wm3(args):
    entries = read_entries()
    unsynced = [e for e in entries if e.get("event") == "experiment" and not e.get("synced_wm3")]
    if not unsynced:
        print("All SIM experiment entries are already synced to WhiteMagic Gen3.")
        return

    if not WM3_BIN.exists():
        print(f"wm3 binary not found at {WM3_BIN} (local JSONL ledger still preserved).", file=sys.stderr)
        sys.exit(1)

    lines = ["[SIM Ledger Distillation]"]
    for e in unsynced:
        lines.append(
            f"- {e['id']} [{e['domain']}/{e['problem_group']}] ({e['status']}, {e.get('model','')}): "
            f"target={e['target']} | rationale={e['rationale']} | predicted={e['predicted_outcome']} | observed={e['observed_outcome']}"
        )
    summary_text = "\n".join(lines)

    proc = subprocess.run(
        [str(WM3_BIN), "--store", str(WM3_STORE), "remember", "--source", "tool:wm-sim", summary_text],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if proc.returncode != 0:
        print(f"wm3 remember failed: {proc.stderr or proc.stdout}", file=sys.stderr)
        sys.exit(proc.returncode)

    for e in unsynced:
        e["synced_wm3"] = True
    tmp = LEDGER_PATH.with_suffix(".jsonl.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        for e in entries:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")
    tmp.replace(LEDGER_PATH)
    print(f"Synced {len(unsynced)} SIM entries into WhiteMagic Gen3.")


def cmd_prefix_hash(args):
    """Compute a ContextCacheToken-style canonical SHA-256 of Turn-0 rules, skills, and eager MCP schemas."""
    disabled_plugs = _disabled_plugins()
    h = hashlib.sha256()
    total_bytes = 0
    print("=== Turn-0 ContextCacheToken Prefix Audit ===")
    for rf in RULE_FILES:
        plug_name = _rule_plugin_name(rf)
        if plug_name and plug_name in disabled_plugs:
            continue
        if rf.exists():
            with rf.open("rb") as _rfh:
                data = _rfh.read()
            total_bytes += len(data)
            h.update(f"rule:{rf.name}\n".encode() + data + b"\n")
            print(f"  RULE  {rf.name:28s}: {len(data):6,} B (~{len(data)//4:4,} tok)")
    seen_mcp_tools = set()
    for surf in ("antigravity-cli", "antigravity", "antigravity-ide"):
        mcp_dir = HOME / ".gemini" / surf / "mcp"
        if mcp_dir.is_dir():
            for jf in sorted(mcp_dir.glob("*/*.json")):
                mkey = f"{jf.parent.name}/{jf.name}"
                if mkey in seen_mcp_tools:
                    continue
                seen_mcp_tools.add(mkey)
                with jf.open("rb") as _jfh:
                    data = _jfh.read()
                h.update(f"mcp:{mkey}\n".encode() + data + b"\n")
    if seen_mcp_tools:
        print(f"  MCP cached schemas hashed         : {len(seen_mcp_tools)} tools (across cli/app/ide)")
    skills_dir = HOME / ".gemini" / "config" / "skills"
    if skills_dir.is_dir():
        sk_bytes = 0
        for sf in sorted(skills_dir.glob("*/SKILL.md")):
            with sf.open(encoding="utf-8", errors="replace") as _sfh:
                txt = _sfh.read()
            if txt.startswith("---"):
                parts = txt.split("---", 2)
                if len(parts) >= 2:
                    b = parts[1].encode("utf-8")
                    sk_bytes += len(b)
                    h.update(f"skill:{sf.parent.name}\n".encode() + b + b"\n")
        total_bytes += sk_bytes
        print(f"  SKILL custom frontmatter          : {sk_bytes:6,} B (~{sk_bytes//4:4,} tok)")
    token = h.hexdigest()
    print(f"  ContextCacheToken SHA-256         : {token[:24]}... (full: {token})")
    print(f"  Rule+CustomSkill Prefix Footprint : {total_bytes:,} B (~{total_bytes//4:,} tok)")


def main():
    parser = argparse.ArgumentParser(description="wm-sim: Self-Improvement Memory CLI & Hygiene Auditor")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_log = sub.add_parser("log", help="Record a structured SIM harness/R&D edit entry")
    p_log.add_argument("--domain", required=True)
    p_log.add_argument("--group", required=True)
    p_log.add_argument("--target", required=True)
    p_log.add_argument("--rationale", required=True)
    p_log.add_argument("--predicted", required=True)
    p_log.add_argument("--observed", required=True)
    p_log.add_argument("--eval", dest="eval_context", default="")
    p_log.add_argument("--status", choices=["kept", "reverted", "failed", "pending"], default="kept")
    p_log.add_argument("--model", default="gemini-4")

    p_q = sub.add_parser("query", help="Query past SIM entries grouped by problem_group")
    p_q.add_argument("query", nargs="?", default="")
    p_q.add_argument("--domain")
    p_q.add_argument("--include-failures", action="store_true")
    p_q.add_argument("--limit", type=int, default=20)

    p_f = sub.add_parser("failures", help="List recent auto-captured PostToolUse tool failures")
    p_f.add_argument("--limit", type=int, default=15)

    p_aud = sub.add_parser("audit", help="Run AGY rules, skills, hooks, MCP, and SIM ledger hygiene audit")
    p_aud.add_argument("--scope-plugins", nargs="?", const=".", default=None, metavar="REPO_DIR", help="Analyze repo signals & Turn-0 domain plugin bloat")
    p_aud.add_argument("--write", action="store_true", help="Write recommended <REPO_DIR>/.agents/plugins.json when domain plugins match")
    p_aud.add_argument("--json", action="store_true", help="Print JSON output for --scope-plugins")
    sub.add_parser("prefix-hash", help="Compute deterministic ContextCacheToken SHA-256 of Turn-0 static prefix")
    sub.add_parser("sync-wm3", help="Commit unsynced SIM experiment records to WhiteMagic Gen3")

    args = parser.parse_args()
    if args.cmd == "log":
        cmd_log(args)
    elif args.cmd == "query":
        cmd_query(args)
    elif args.cmd == "failures":
        cmd_failures(args)
    elif args.cmd == "audit":
        cmd_audit(args)
    elif args.cmd == "prefix-hash":
        cmd_prefix_hash(args)
    elif args.cmd == "sync-wm3":
        cmd_sync_wm3(args)


if __name__ == "__main__":
    main()
