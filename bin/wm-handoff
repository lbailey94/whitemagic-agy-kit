#!/usr/bin/env python3
"""
wm-handoff — CliffCompaction (arXiv:2609.26779) Zero-Paraphrase Verbatim Session Handoff Crystalizer.
Addresses the #2 largest source of Antigravity uncached credit burn (30.5% = 45M uncached tokens from
resuming cold >100k sessions after 5+ minute user-idle cache evictions).

Strict CliffCompaction invariants:
  - Truncation-only & verbatim facts (NEVER paraphrases or re-summarizes prior summaries)
  - Emits a compact (<1,800 tok) hash-pinned engineering handoff crystal ready to paste into a fresh
    session or checkpoint to WhiteMagic (`--save-wm3`), warming a clean 95%+ prefix cache immediately.
"""
import argparse
import glob
import hashlib
import hmac
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import fcntl
except ImportError:
    fcntl = None

SURFACE_BRAINS = {
    "app": Path.home() / ".gemini" / "antigravity" / "brain",
    "ide": Path.home() / ".gemini" / "antigravity-ide" / "brain",
    "cli": Path.home() / ".gemini" / "antigravity-cli" / "brain",
}


def _pending_crystals_path() -> Path:
    explicit = os.environ.get("WM_PENDING_CRYSTALS", "").strip()
    if explicit:
        return Path(explicit)
    telem = os.environ.get("WM_AGY_TELEMETRY", "").strip()
    if telem:
        return Path(telem).parent / "pending_crystals.jsonl"
    return Path.home() / ".local" / "share" / "whitemagic" / "pending_crystals.jsonl"


def _resolve_wm3_bin_and_store(store_override: str | None = None) -> tuple[Path, Path]:
    wm_bin = Path(
        os.environ.get(
            "WM3_BIN",
            shutil.which("wm3")
            or shutil.which("wm-gen3")
            or str(Path.home() / ".local" / "bin" / "wm3"),
        )
    )
    xdg_store = Path.home() / ".local" / "share" / "whitemagic" / "gen3"
    shared_store = Path("/Users/Shared/ai/wm-store-gen3")
    default_store = str(
        xdg_store if xdg_store.is_dir() else (shared_store if shared_store.is_dir() else xdg_store)
    )
    wm_store = Path(store_override or os.environ.get("WM3_STORE") or default_store)
    return wm_bin, wm_store


def append_crystal_spool(
    st: dict,
    gs,
    surf: str,
    digest: str,
    crystal: str,
    out_path: str | None,
    receipt_path: Path | None,
    source: str = "wm-handoff",
) -> Path:
    """Lock-free O_APPEND spool write for IDE/readonly sessions (zero LMDB contention)."""
    spool_path = _pending_crystals_path()
    spool_path.parent.mkdir(parents=True, exist_ok=True)
    goal = (st.get("user_goals") or [""])[-1][:180]
    entry = {
        "schema": "wm-crystal-spool/1.0",
        "queued_at": datetime.now(timezone.utc).isoformat(),
        "source": source,
        "conv_id": st["conv_id"],
        "surface": surf,
        "model": st["model"],
        "last_ctx": int(st["last_ctx"] or 0),
        "last_hit_pct": st["last_hit"],
        "model_flips": int(st["model_flips"] or 0),
        "crystal_sha256": digest,
        "crystal_path": str(out_path or ""),
        "receipt_path": str(receipt_path or ""),
        "git_branch": gs.get("branch", "") if gs else "",
        "summary": goal,
        "content": crystal,
    }
    line = (json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
    fd = os.open(str(spool_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)
    return spool_path


def flush_pending_crystals(dry_run: bool = False, store_override: str | None = None) -> dict:
    """Single-writer-safe ingestion of pending_crystals.jsonl into Gen3 LMDB."""
    spool_path = _pending_crystals_path()
    flushed_ledger = spool_path.with_name("flushed_crystals.sha256")
    lock_path = spool_path.with_name("pending_crystals.lock")
    wm_bin, wm_store = _resolve_wm3_bin_and_store(store_override)

    if not spool_path.is_file() or spool_path.stat().st_size == 0:
        return {
            "ok": True,
            "spool_path": str(spool_path),
            "store": str(wm_store),
            "dry_run": dry_run,
            "total_records": 0,
            "flushed": 0,
            "skipped_dup": 0,
            "failed": 0,
            "remaining": 0,
        }

    spool_path.parent.mkdir(parents=True, exist_ok=True)
    lock_fh = lock_path.open("a+", encoding="utf-8")
    try:
        if fcntl is not None:
            try:
                fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return {
                    "ok": False,
                    "locked": True,
                    "error": "Another wm-handoff --flush-wm3 writer holds the spool lock",
                    "spool_path": str(spool_path),
                }

        flushed_shas: set[str] = set()
        if flushed_ledger.is_file():
            for ln in flushed_ledger.read_text(encoding="utf-8", errors="replace").splitlines():
                s = ln.strip()
                if s:
                    flushed_shas.add(s)

        raw_lines = [
            ln.strip()
            for ln in spool_path.read_text(encoding="utf-8", errors="replace").splitlines()
            if ln.strip().startswith("{")
        ]
        parsed: list[tuple[str, dict]] = []
        for ln in raw_lines:
            try:
                obj = json.loads(ln)
                if isinstance(obj, dict):
                    parsed.append((ln, obj))
            except Exception:
                continue

        seen_in_batch: set[str] = set()
        to_ingest: list[tuple[str, dict, str]] = []
        skipped_dup = 0
        for ln, obj in parsed:
            content = str(obj.get("content") or "")
            sha = str(obj.get("crystal_sha256") or "") or hashlib.sha256(content.encode("utf-8")).hexdigest()[:12]
            if sha in flushed_shas or sha in seen_in_batch:
                skipped_dup += 1
                continue
            seen_in_batch.add(sha)
            to_ingest.append((ln, obj, sha))

        if dry_run:
            return {
                "ok": True,
                "spool_path": str(spool_path),
                "store": str(wm_store),
                "dry_run": True,
                "total_records": len(parsed),
                "to_flush": len(to_ingest),
                "flushed": 0,
                "skipped_dup": skipped_dup,
                "failed": 0,
                "remaining": len(to_ingest),
            }

        if not wm_bin.exists():
            return {
                "ok": False,
                "spool_path": str(spool_path),
                "store": str(wm_store),
                "error": f"wm3 binary not found at {wm_bin}",
                "total_records": len(parsed),
                "flushed": 0,
                "skipped_dup": skipped_dup,
                "failed": len(to_ingest),
                "remaining": len(to_ingest),
            }

        flushed = 0
        failed = 0
        remaining_lines: list[str] = []
        errors: list[str] = []
        newly_flushed: list[str] = []

        for ln, obj, sha in to_ingest:
            content = str(obj.get("content") or "").strip()
            if not content and obj.get("crystal_path") and Path(str(obj["crystal_path"])).is_file():
                content = Path(str(obj["crystal_path"])).read_text(encoding="utf-8", errors="replace").strip()
            if not content:
                skipped_dup += 1
                continue
            src = str(obj.get("source") or "wm-handoff").strip()
            try:
                proc = subprocess.run(
                    [str(wm_bin), "--store", str(wm_store), "remember", "--source", f"tool:{src}", "--kind", "system", content],
                    capture_output=True,
                    text=True,
                    timeout=45,
                )
                if proc.returncode == 0:
                    flushed += 1
                    flushed_shas.add(sha)
                    newly_flushed.append(sha)
                else:
                    failed += 1
                    remaining_lines.append(ln)
                    errors.append(f"{sha}: {(proc.stderr or proc.stdout or 'rc=' + str(proc.returncode)).strip()[:160]}")
            except Exception as exc:
                failed += 1
                remaining_lines.append(ln)
                errors.append(f"{sha}: {exc}")

        if newly_flushed:
            _write_text_atomic(flushed_ledger, "\n".join(sorted(flushed_shas)) + "\n")
        _write_text_atomic(spool_path, ("\n".join(remaining_lines) + "\n") if remaining_lines else "")

        out = {
            "ok": failed == 0,
            "spool_path": str(spool_path),
            "store": str(wm_store),
            "dry_run": False,
            "total_records": len(parsed),
            "flushed": flushed,
            "skipped_dup": skipped_dup,
            "failed": failed,
            "remaining": len(remaining_lines),
        }
        if errors:
            out["errors"] = errors[:5]
        return out
    finally:
        if fcntl is not None:
            try:
                fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
            except Exception:
                pass
        lock_fh.close()


def parse_ts(v):
    if not v:
        return None
    try:
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def latest_transcript(conv_prefix=None, surface="all"):
    surfaces = ("app", "ide", "cli") if surface == "all" else (surface,)
    logs = []
    for surf in surfaces:
        bdir = SURFACE_BRAINS.get(surf)
        if bdir and bdir.is_dir():
            for lp in glob.glob(str(bdir / "*" / ".system_generated" / "logs" / "transcript.jsonl")):
                logs.append((os.path.getmtime(lp), Path(lp), surf))
    logs.sort(key=lambda x: x[0], reverse=True)
    if conv_prefix:
        for _, lp, surf in logs:
            if lp.parents[2].name.startswith(conv_prefix):
                return lp, surf
    return (logs[0][1], logs[0][2]) if logs else (None, "")


def git_state(cwd):
    if not cwd or not Path(cwd).is_dir():
        return None
    try:
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, timeout=2)
        if r.returncode != 0:
            return None
        branch = r.stdout.strip()
        st = subprocess.run(["git", "-C", cwd, "status", "--short"], capture_output=True, text=True, timeout=2).stdout.strip()
        diff_stat = subprocess.run(["git", "-C", cwd, "diff", "--stat"], capture_output=True, text=True, timeout=2).stdout.strip()
        log_3 = subprocess.run(["git", "-C", cwd, "log", "-n", "3", "--oneline"], capture_output=True, text=True, timeout=2).stdout.strip()
        return {"branch": branch, "status": st, "diff_stat": diff_stat, "recent_commits": log_3}
    except Exception:
        return None


def _unwrap_json_str(v):
    if isinstance(v, str) and len(v) >= 2 and v[0] == '"' and v[-1] == '"':
        try:
            u = json.loads(v)
            if isinstance(u, str):
                return u
        except Exception:
            pass
    return v


def _safe_conv_id(tp: Path) -> str:
    if len(tp.parents) > 2 and tp.parent.name == "logs" and tp.parents[1].name == ".system_generated":
        return tp.parents[2].name
    return tp.parent.name or "default"


def _write_text_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def extract_verbatim_state(tp):
    user_goals = []
    edited_files = []
    recent_errors = []
    last_ctx = 0
    last_hit = None
    last_ts = None
    model = ""
    prev_model = ""
    model_flips = 0

    for line in tp.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            o = json.loads(line)
        except Exception:
            continue
        t = o.get("type", "")
        if t == "USER_INPUT":
            txt = " ".join(str(o.get("content") or "").split())
            if txt:
                user_goals.append(txt[:260])
        elif t == "PLANNER_RESPONSE":
            unc = int(o.get("input_tokens") or 0)
            cac = int(o.get("cache_read_tokens") or 0)
            cur_m = str(o.get("model") or "")
            if unc + cac > 0:
                last_ctx = unc + cac
                last_hit = round(100.0 * cac / last_ctx, 1)
                if cur_m and prev_model and cur_m != prev_model:
                    model_flips += 1
                if cur_m:
                    prev_model = cur_m
            ts = parse_ts(o.get("created_at") or o.get("timestamp"))
            if ts:
                last_ts = ts
            if cur_m:
                model = cur_m
            for tc in (o.get("tool_calls") or []):
                nm = tc.get("name", "")
                args = tc.get("args") or tc.get("arguments") or {}
                if isinstance(args, str):
                    try:
                        args = json.loads(args)
                    except Exception:
                        args = {}
                if nm in ("edit_file", "write_file") and args.get("Path"):
                    p = str(_unwrap_json_str(args["Path"]))
                    if p not in edited_files:
                        edited_files.append(p)
                elif nm in ("mcp_agy-fast_fast_apply_edits", "mcp_whitemagic-agy-kit_fast_apply_edits"):
                    edits = args.get("edits") or []
                    if isinstance(edits, str):
                        try:
                            edits = json.loads(edits)
                        except Exception:
                            edits = []
                    if isinstance(edits, list):
                        for ed in edits:
                            if isinstance(ed, dict) and ed.get("path"):
                                p = str(_unwrap_json_str(ed["path"]))
                                if p not in edited_files:
                                    edited_files.append(p)
        elif t == "GENERIC":
            c = str(o.get("content") or "")
            if any(k in c for k in ("FAIL", "Error:", "Traceback", "error[E", "Command exited with code 1", "Command exited with code 2")):
                # Keep verbatim diagnostic lines only
                err_lines = [
                    l.strip()
                    for l in c.splitlines()
                    if any(k in l for k in ("FAIL", "Error", "error[", "Traceback", "panicked", "AssertionError", "Command exited"))
                ][:3]
                if err_lines:
                    recent_errors.append(" | ".join(err_lines)[:220])

    return {
        "conv_id": _safe_conv_id(tp),
        "model": model,
        "last_ctx": last_ctx,
        "last_hit": last_hit,
        "model_flips": model_flips,
        "idle_sec": max(0, int(time.time() - last_ts)) if last_ts else None,
        "user_goals": user_goals[-3:],
        "edited_files": edited_files[-15:],
        "recent_errors": recent_errors[-4:],
    }


def _grimoire_brief_max_bytes(host: str = "agy") -> int | None:
    p = Path(
        os.environ.get("WM_GRIMOIRE_PROFILE")
        or str(Path.home() / ".local" / "share" / "whitemagic" / "grimoire_profile.json")
    )
    if not p.is_file():
        return None
    try:
        obj = json.loads(p.read_text(encoding="utf-8"))
        hp = (obj.get("host_profiles") or {}).get(host) or obj.get("model_tuning") or {}
        val = int(hp.get("turn0_brief_max_bytes") or 0)
        return val if val >= 600 else None
    except Exception:
        return None


def build_swarm_map(repo_dir: str) -> str:
    """Build a compact <=600-token (<=2400 B) shared codemap for fresh swarm workers."""
    root = Path(repo_dir).resolve()
    gs = git_state(str(root))
    manifests = [
        name
        for name in ("package.json", "Cargo.toml", "pyproject.toml", "go.mod", "plugin/plugin.json", "Makefile")
        if (root / name).is_file()
    ]
    codegraph_bin = shutil.which("wm-codegraph") or str(Path.home() / ".local" / "bin" / "wm-codegraph")
    cg_out = ""
    if codegraph_bin and Path(codegraph_bin).is_file():
        try:
            r = subprocess.run([str(codegraph_bin), "overview", "--root", str(root)], capture_output=True, text=True, timeout=4)
            if r.returncode == 0 and r.stdout.strip():
                cg_out = r.stdout.strip()[:1200]
        except Exception:
            cg_out = ""
    lines = [
        f"# Swarm Shared Map ({root.name})",
        f"- **Branch:** `{gs['branch']}`" if gs else f"- **Root:** `{root}`",
    ]
    if manifests:
        lines.append("- **Manifests:** " + ", ".join(f"`{m}`" for m in manifests))
    if gs and gs.get("recent_commits"):
        lines.append("Recent commits:\n```\n" + gs["recent_commits"] + "\n```")
    if gs and gs.get("status"):
        lines.append("Modified files:\n```\n" + gs["status"][:450] + "\n```")
    if cg_out:
        lines.append("Symbol overview:\n```\n" + cg_out + "\n```")
    body = "\n".join(lines)
    g_cap = _grimoire_brief_max_bytes("agy")
    cap = min(2280, max(900, g_cap - 150)) if g_cap is not None else 2280
    if len(body) > cap:
        body = body[: cap - 50] + "\n... [swarm-map cap 600 tok]"
    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()[:12]
    return f"{body}\n\n`swarm_map_sha256={digest} | est_tokens~{len(body)//4}`\n"


def build_receipt_v12(st: dict, gs, surf: str, digest: str, crystal: str, tp: Path, out_path: str | None) -> dict:
    try:
        tp_bytes = tp.stat().st_size if tp and tp.is_file() else 0
    except Exception:
        tp_bytes = 0
    core = {
        "schema": "wm-receipt/1.2",
        "kind": "handoff_crystal",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "conv_id": st["conv_id"],
        "surface": surf,
        "model": st["model"],
        "last_ctx": st["last_ctx"],
        "last_hit_pct": st["last_hit"],
        "model_flips": st["model_flips"],
        "crystal_sha256": digest,
        "crystal_bytes": len(crystal.encode("utf-8")),
        "crystal_path": str(out_path or ""),
        "transcript_path": str(tp),
        "transcript_bytes": tp_bytes,
        "edited_files": st["edited_files"],
        "git_branch": gs.get("branch", "") if gs else "",
    }
    signing_key = os.environ.get("WM_CONFINEMENT_SIGNING_KEY", "").strip()
    if signing_key:
        canonical = json.dumps(core, sort_keys=True, separators=(",", ":")).encode("utf-8")
        sig = hmac.new(signing_key.encode("utf-8"), canonical, hashlib.sha256).hexdigest()
        core["signature"] = {"alg": "hmac-sha256", "sig": sig}
    else:
        core["signature"] = None
    return core


def main():
    ap = argparse.ArgumentParser(description="Emit a zero-paraphrase CliffCompaction handoff crystal for clean session resets.")
    ap.add_argument("--conv", help="Conversation ID prefix (defaults to newest transcript)")
    ap.add_argument("--transcript", help="Explicit transcript.jsonl path (skips brain scan)")
    ap.add_argument("--surface", choices=["all", "app", "ide", "cli"], default="all", help="AGY surface to scan (default: all)")
    ap.add_argument("--cwd", default=os.getcwd(), help="Git working directory to snapshot")
    ap.add_argument("--out", help="Optional output markdown file path")
    ap.add_argument("--emit-receipt", help="Optional output path for canonical wm-receipt/1.2 JSON")
    ap.add_argument("--publish-sangha", action="store_true", help="Verify receipt and publish a <=150-tok CPR pointer via wm-cpr-bridge")
    ap.add_argument("--target", default="@all", help="Sangha target mention for --publish-sangha (default: @all)")
    ap.add_argument("--room", default="", help="Optional Sangha room for --publish-sangha")
    ap.add_argument("--swarm-map", metavar="REPO_DIR", help="Emit a <=600-token shared codemap for fresh swarm workers and exit")
    ap.add_argument("--save-wm3", action="store_true", help="Also persist handoff crystal to WhiteMagic Gen3 (wm3 / wm-gen3)")
    ap.add_argument("--spool", action="store_true", help="Append crystal to lock-free pending_crystals.jsonl spool (zero LMDB contention)")
    ap.add_argument("--spool-source", default="wm-handoff", help="Origin label recorded on spooled crystal entries")
    ap.add_argument("--flush-wm3", action="store_true", help="Flush pending_crystals.jsonl into WhiteMagic Gen3 LMDB safely and exit")
    ap.add_argument("--dry-run", action="store_true", help="Preview --flush-wm3 without mutating Gen3 LMDB or spool")
    ap.add_argument("--json", action="store_true", help="Emit JSON output (for --flush-wm3)")
    args = ap.parse_args()

    if args.flush_wm3:
        res = flush_pending_crystals(dry_run=args.dry_run)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            if res.get("locked"):
                print(f"wm-handoff --flush-wm3: {res.get('error')}")
            elif res.get("dry_run"):
                print(
                    f"wm-handoff --flush-wm3 --dry-run: pending={res.get('to_flush', 0)} "
                    f"dup_skip={res.get('skipped_dup', 0)} store={res.get('store')}"
                )
            else:
                print(
                    f"wm-handoff --flush-wm3: flushed={res.get('flushed', 0)} "
                    f"dup_skip={res.get('skipped_dup', 0)} failed={res.get('failed', 0)} "
                    f"remaining={res.get('remaining', 0)} store={res.get('store')}"
                )
        sys.exit(0 if res.get("ok") else 1)

    if args.swarm_map:
        smap = build_swarm_map(args.swarm_map)
        if args.out:
            _write_text_atomic(Path(args.out), smap)
            print(f"Wrote swarm map -> {args.out} ({len(smap)} B, ~{len(smap)//4} tok)")
        else:
            sys.stdout.write(smap)
        return

    if args.transcript:
        tp = Path(args.transcript)
        if not tp.is_file():
            sys.stderr.write(f"wm-handoff: transcript not found: {tp}\n")
            sys.exit(1)
        tps = str(tp)
        surf = "cli" if "antigravity-cli" in tps else ("ide" if "antigravity-ide" in tps else "app")
    else:
        tp, surf = latest_transcript(args.conv, surface=args.surface)
    if not tp:
        sys.stderr.write("wm-handoff: no AGY transcript found.\n")
        sys.exit(1)

    st = extract_verbatim_state(tp)
    gs = git_state(args.cwd)

    lines = [
        f"# Verbatim Handoff Crystal (CliffCompaction | source={st['conv_id'][:8]} | surface={surf})",
        f"- **Prior Session:** `{st['conv_id'][:12]}` (`{surf}`) | model=`{st['model'] or '?'}` | ctx=`{st['last_ctx']:,}` tok | flips=`{st['model_flips']}` | last_hit=`{st['last_hit']}%` | idle=`{st['idle_sec']}s`",
    ]
    if st["last_ctx"] >= 100_000 and ((st["idle_sec"] or 0) >= 180 or st["model_flips"] >= 2):
        est_save = max(0, st["last_ctx"] - 2000)
        lines.append(f"- **Cache-Eviction Savings:** Fresh start with this crystal saves **~{est_save:,} uncached tokens** vs resuming a cold or ping-ponging session.")

    if st["user_goals"]:
        lines.append("\n## Verbatim Recent User Objectives")
        for g in st["user_goals"]:
            lines.append(f"- {g}")

    if st["edited_files"]:
        lines.append("\n## Files Modified in Prior Session")
        for f in st["edited_files"]:
            lines.append(f"- `{f}`")

    if gs:
        lines.append(f"\n## Git Working State (`{gs['branch']}`)")
        if gs["recent_commits"]:
            lines.append("Recent commits:\n```\n" + gs["recent_commits"] + "\n```")
        if gs["status"]:
            lines.append("Uncommitted changes:\n```\n" + gs["status"][:1200] + "\n```")
        if gs["diff_stat"]:
            lines.append("Diff stat:\n```\n" + gs["diff_stat"][:900] + "\n```")

    if st["recent_errors"]:
        lines.append("\n## Verbatim Latest Diagnostic Lines (Do Not Rephrase)")
        for e in st["recent_errors"]:
            lines.append(f"- `{e}`")

    body = "\n".join(lines)
    if len(body) > 6800:
        body = body[:6750] + "\n... [verbatim truncation cap reached]"
    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()[:12]
    crystal = f"{body}\n\n`crystal_sha256={digest} | est_tokens~{len(body)//4}`\n"

    receipt_path = None
    if args.emit_receipt:
        receipt_path = Path(args.emit_receipt)
    elif args.publish_sangha:
        cache_dir = Path(os.environ.get("WM_HANDOFF_CACHE_DIR") or str(Path.home() / ".cache" / "wm-handoff"))
        san = "".join(c for c in st["conv_id"] if c.isascii() and (c.isalnum() or c in "_-"))[:20] or "default"
        receipt_path = cache_dir / f"latest_{san}.receipt.json"

    spooled_already = False
    if args.save_wm3:
        wm_bin, wm_store = _resolve_wm3_bin_and_store()
        if not wm_bin.exists():
            sys.stderr.write(f"wm-handoff: --save-wm3 binary not found at {wm_bin}; spooling to pending_crystals.jsonl\n")
            append_crystal_spool(st, gs, surf, digest, crystal, args.out, receipt_path, source=f"{args.spool_source}:fallback")
            spooled_already = True
        else:
            proc = subprocess.run(
                [str(wm_bin), "--store", str(wm_store), "remember", "--source", "tool:wm-handoff", "--kind", "system", crystal],
                capture_output=True,
                text=True,
                timeout=30,
            )
            if proc.returncode != 0:
                sys.stderr.write(f"wm-handoff: --save-wm3 failed ({proc.stderr or proc.stdout}); spooling to pending_crystals.jsonl\n")
                append_crystal_spool(st, gs, surf, digest, crystal, args.out, receipt_path, source=f"{args.spool_source}:fallback")
                spooled_already = True
            else:
                sys.stderr.write(f"Saved handoff crystal to WhiteMagic Gen3 ({wm_store})\n")

    if args.spool and not spooled_already:
        sp = append_crystal_spool(st, gs, surf, digest, crystal, args.out, receipt_path, source=args.spool_source)
        sys.stderr.write(f"Spooled crystal sha256={digest} -> {sp}\n")

    if args.out:
        _write_text_atomic(Path(args.out), crystal)
        print(f"Wrote handoff crystal -> {args.out} ({len(crystal)} B, ~{len(crystal)//4} tok)")
    else:
        sys.stdout.write(crystal)

    if receipt_path is not None:
        receipt = build_receipt_v12(st, gs, surf, digest, crystal, tp, args.out)
        _write_text_atomic(receipt_path, json.dumps(receipt, indent=2) + "\n")

    if args.publish_sangha and receipt_path is not None:
        bridge_bin = (
            os.environ.get("WM_CPR_BRIDGE_BIN", "").strip()
            or str(Path(__file__).resolve().parent / "wm-cpr-bridge")
        )
        if not Path(bridge_bin).is_file():
            bridge_bin = shutil.which("wm-cpr-bridge") or str(Path.home() / ".local" / "bin" / "wm-cpr-bridge")
        if Path(bridge_bin).is_file():
            bcmd = [sys.executable, "-S", str(bridge_bin), "publish", "--receipt", str(receipt_path), "--target", args.target]
            if args.room:
                bcmd.extend(["--room", args.room])
            try:
                br = subprocess.run(bcmd, capture_output=True, text=True, timeout=4)
                if br.returncode != 0:
                    sys.stderr.write(f"wm-handoff: --publish-sangha warning: {br.stderr or br.stdout}\n")
            except Exception as exc:
                sys.stderr.write(f"wm-handoff: --publish-sangha warning: {exc}\n")
        else:
            sys.stderr.write("wm-handoff: wm-cpr-bridge binary not found; skipped --publish-sangha\n")


if __name__ == "__main__":
    main()
