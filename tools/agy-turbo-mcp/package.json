{
  "name": "agy-fast",
  "version": "0.2.8",
  "description": "Policy-compliant latency and tool-call accelerator plugin for Google Antigravity",
  "type": "module",
  "author": "inkwhite <714395048@qq.com>",
  "homepage": "https://github.com/INK-Q/agy-fast#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/INK-Q/agy-fast.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "agy-fast": "./scripts/install.mjs"
  },
  "files": [
    "plugin.json",
    "mcp_config.json",
    "hooks.json",
    "rules/AGENTS.md",
    "assets/*.svg",
    "dist/*.mjs",
    "scripts/install.mjs",
    "docs/*.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "validate": "agy plugin validate --strict .",
    "install:plugin": "node scripts/install.mjs install",
    "update:plugin": "node scripts/install.mjs update",
    "uninstall:plugin": "node scripts/install.mjs uninstall",
    "doctor": "node scripts/install.mjs doctor",
    "benchmark": "node dist/benchmark.mjs",
    "bench:stress": "npm run build && node scripts/stress-benchmark.mjs"
  },
  "keywords": [
    "antigravity",
    "agy",
    "plugin",
    "mcp",
    "performance",
    "batch",
    "developer-tools"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
